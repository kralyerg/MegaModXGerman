		{ String _name = "DSChapelofErnest";			String _text = "Kapelle des Heiligen Ernst"; }
		{ String _name = "DSChapelofErnestLwr";			String _text = "Kapelle des Heiligen Ernst"; }
		{ String _name = "DSChapelofErnestTip";			String _text = "Baut die Kapelle des Heiligen Ernst; ein Geistlicher wird für die Gottesdienste benötigt. Die Kapelle bietet Ihren Bürgern einen Ort zum Treffen und Beten und spendet geistliche Zufriedenheit für bis zu 201 Mitglieder - einschließlich des Geistlichen. 7x10 Kacheln. Der Bau erfordert 155 Bauarbeit. Auf einer Karte kann nur eine Kapelle des Heiligen Ernst errichtet werden."; }
		
		{ String _name = "DSChapelofErnestUITxt01";		String _text = "die Kapelle des Heiligen Ernst"; }
		{ String _name = "DSChapelofErnestUITxt02";		String _text = "ein Ort zum Treffen und Beten, für bis zu 201 Bürger."; }
		
	]
