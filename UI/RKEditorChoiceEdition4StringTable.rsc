		{ String _name = "NMTBlacksmithDockLwr";		String _text = "Schmied"; }
		{ String _name = "NMTBlacksmithDockTip";		String _text = "NMT Docks Schmied: ein Arbeitsplatz, an dem verschiedene Werkzeuge hergestellt und Erze zu Metallen verarbeitet werden. Größe: 7x5. Kosten: 65 Baumstämme, 8 Stein, 12 Eisen. Bietet Arbeit für 1 Schmied. Tipp: Stellt folgende Werkzeugarten her: hölzern (2 Baumstämme), steinern (1 Baumstamm, 1 Stein), kupfern (1 Baumstamm, 1 Kupfer), eisern (1 Baumstamm, 1 Eisen), Kupferlegierung (1 Baumstamm, 1 Eisen, 1 Kupfer), Stahl (1 Baumstamm, 1 Eisen, 1 Kohle) oder (1 Baumstamm, 1 Eisen, 3 Holzkohle), Karbonstahl (1 Baumstamm, 2 Eisen, 2 Kohle) oder (1 Baumstamm, 2 Eisen, 5 Holzkohle). Wandelt auch 3 Eisenerz in 1 Eisen und 3 Kupfererz in 1 Kupfer um."; }

		{ String _name = "NMTBlacksmith2Dock";			String _text = "Schmied"; }
		{ String _name = "NMTBlacksmith2DockLwr";		String _text = "Schmied"; }
