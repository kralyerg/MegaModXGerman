		{ String _name = "NMTBlacksmithStoneDock";		String _text = "Schmied"; }
		{ String _name = "NMTBlacksmithStoneDockLwr";		String _text = "Schmied"; }
		{ String _name = "NMTBlacksmithStoneDockTip";		String _text = "NMT Steindocks Schmied: ein Arbeitsplatz, an dem verschiedene Werkzeuge hergestellt und Erze zu Metallen verarbeitet werden. Größe: 7x5. Kosten: 8 Baumstämme, 65 Stein, 12 Eisen. Bietet Arbeit für 1 Schmied. Tipp: Stellt folgende Werkzeugarten her: hölzern (2 Baumstämme), steinern (1 Baumstamm, 1 Stein), kupfern (1 Baumstamm, 1 Kupfer), eisern (1 Baumstamm, 1 Eisen), Kupferlegierung (1 Baumstamm, 1 Eisen, 1 Kupfer), Stahl (1 Baumstamm, 1 Eisen, 1 Kohle) oder (1 Baumstamm, 1 Eisen, 3 Holzkohle), Karbonstahl (1 Baumstamm, 2 Eisen, 2 Kohle) oder (1 Baumstamm, 2 Eisen, 5 Holzkohle). Wandelt auch 3 Eisenerz in 1 Eisen und 3 Kupfererz in 1 Kupfer um."; }

		{ String _name = "NMTWoodcutterDock";			String _text = "Holzfäller"; }
		{ String _name = "NMTWoodcutterDockLwr";		String _text = "Holzfäller"; }
		{ String _name = "NMTWoodcutterDockTip";		String _text = "NMT Docks Holzfäller: ein Arbeitsplatz, an dem Brennholz hergestellt wird. Größe: 4x5. Kosten: 32 Baumstämme. Bietet Arbeit für 1-2 Holzfäller. Tipp: Benötigt 2 Baumstämme oder 5 Bauholz oder 5 Futterstroh. Erzeugt 5-8 Brennholz pro erledigter Aufgabe."; }

		{ String _name = "NMTWoodcutterStoneDock";		String _text = "Holzfäller"; }
		{ String _name = "NMTWoodcutterStoneDockLwr";		String _text = "Holzfäller"; }
		{ String _name = "NMTWoodcutterStoneDockTip";		String _text = "NMT Steindocks Holzfäller: ein Arbeitsplatz, an dem Brennholz hergestellt wird. Größe: 4x5. Kosten: 32 Stein. Bietet Arbeit für 1-2 Holzfäller. Tipp: Benötigt 2 Baumstämme oder 5 Bauholz oder 5 Futterstroh. Erzeugt 5-8 Brennholz pro erledigter Aufgabe."; }

		{ String _name = "NMTSawmillDock";			String _text = "Sägewerk"; }
		{ String _name = "NMTSawmillDockLwr";			String _text = "Sägewerk"; }
		{ String _name = "NMTSawmillDockTip";			String _text = "NMT Docks Sägewerk: ein Arbeitsplatz, an dem Bauholz oder Brennholz aus Baumstämmen hergestellt wird. Größe: 7x5. Kosten: 48 Baumstämme, 12 Eisen. Bietet Arbeit für 1-3 Holzfäller. Tipp: Benötigt 1 Baumstamm für Bauholz und 2 für Brennholz. Erzeugt 3-4 Bauholz oder 5-8 Brennholz pro erledigter Aufgabe."; }

		{ String _name = "NMTSawmillStoneDock";			String _text = "Sägewerk"; }
		{ String _name = "NMTSawmillStoneDockLwr";		String _text = "Sägewerk"; }
		{ String _name = "NMTSawmillStoneDockTip";		String _text = "NMT Steindocks Sägewerk: ein Arbeitsplatz, an dem Bauholz oder Brennholz aus Baumstämmen hergestellt wird. Größe: 7x5. Kosten: 48 Stein, 12 Eisen. Bietet Arbeit für 1-3 Holzfäller. Tipp: Benötigt 1 Baumstamm für Bauholz und 2 für Brennholz. Erzeugt 3-4 Bauholz oder 5-8 Brennholz pro erledigter Aufgabe."; }

		{ String _name = "NMTTailorDock";			String _text = "Schneider"; }
		{ String _name = "NMTTailorDockLwr";			String _text = "Schneider"; }
		{ String _name = "NMTTailorDockTip";			String _text = "NMT Docks Schneider: ein Arbeitsplatz, an dem verschiedene Kleidungsstücke hergestellt werden. Größe: 7x5. Kosten: 54 Baumstämme, 2 Eisen. Bietet Arbeit für 1 Schneider. Tipp: Benötigte Ressourcen: Fellmantel (2 Leder oder 1 Leder + 1 Stoff/Leinen, oder 2 Stoff, oder 2 Leinen), Wollmantel (2 Wolle, oder 1 Wolle + 1 Stoff/Leinen) oder Warmer Mantel (2 Leder + 2 Wolle/Stoff/Leinen, oder 2 Wolle + 2 Stoff/Leinen, oder 2 Pelz). Gebildete Arbeiter stellen 2 Kleidungsstücke her, ungebildete nur 1. 3-4 Stoff oder Leinen entstehen aus 12 Baumwolle oder 12 Flachs."; }

		{ String _name = "NMTTailorStoneDock";			String _text = "Schneider"; }
		{ String _name = "NMTTailorStoneDockLwr";		String _text = "Schneider"; }
		{ String _name = "NMTTailorStoneDockTip";		String _text = "NMT Docks Steinschneider: ein Arbeitsplatz, an dem verschiedene Kleidungsstücke hergestellt werden. Größe: 7x5. Kosten: 54 Stein, 2 Eisen. Bietet Arbeit für 1 Schneider. Tipp: Benötigte Ressourcen: Fellmantel (2 Leder oder 1 Leder + 1 Stoff/Leinen, oder 2 Stoff, oder 2 Leinen), Wollmantel (2 Wolle, oder 1 Wolle + 1 Stoff/Leinen) oder Warmer Mantel (2 Leder + 2 Wolle/Stoff/Leinen, oder 2 Wolle + 2 Stoff/Leinen, oder 2 Pelz). Gebildete Arbeiter stellen 2 Kleidungsstücke her, ungebildete nur 1. 3-4 Stoff oder Leinen entstehen aus 12 Baumwolle oder 12 Flachs."; }

		{ String _name = "NMTTavernDock";			String _text = "Taverne"; }
		{ String _name = "NMTTavernDockLwr";			String _text = "Taverne"; }
		{ String _name = "NMTTavernDockTip";			String _text = "NMT Docks Taverne: ein Arbeitsplatz, an dem Bier, Ale oder Wein hergestellt, gelagert und konsumiert wird; steigert die Zufriedenheit der Bürger in der Nähe. Größe: 7x7. Kosten: 72 Baumstämme, 8 Eisen, 12 Glas. Zufriedenheitsradius (Unterhaltung): 30. Bietet Arbeit für 1-3 Brauer. Tipp: Benötigte Ressourcen: Bier (10 Malz), Starkbier (10 Malz, 2 Hopfen), Ale (60 Heidelbeeren oder 30 Äpfel, Aprikosen, Kirschen, Pfirsiche, Birnen oder Kürbisse), Wein (30 Brombeeren, Weintrauben, Pflaumen, Himbeeren, Maulbeeren, Erdbeeren, Wassermelonen oder Mangos) oder Met (45 Honig). Erzeugt 6-10 Ale/Bier/Wein."; }

		{ String _name = "NMTTavernStoneDock";			String _text = "Taverne"; }
		{ String _name = "NMTTavernStoneDockLwr";		String _text = "Taverne"; }
		{ String _name = "NMTTavernStoneDockTip";		String _text = "NMT Steindocks Taverne: ein Arbeitsplatz, an dem Bier, Ale oder Wein hergestellt, gelagert und konsumiert wird; steigert die Zufriedenheit der Bürger in der Nähe. Größe: 7x7. Kosten: 72 Stein, 8 Eisen, 12 Glas. Zufriedenheitsradius (Unterhaltung): 36. Bietet Arbeit für 1-3 Brauer. Tipp: Benötigte Ressourcen: Bier (10 Malz), Starkbier (10 Malz, 2 Hopfen), Ale (60 Heidelbeeren oder 30 Äpfel, Aprikosen, Kirschen, Pfirsiche, Birnen oder Kürbisse), Wein (30 Brombeeren, Weintrauben, Pflaumen, Himbeeren, Maulbeeren, Erdbeeren, Wassermelonen oder Mangos) oder Met (45 Honig). Erzeugt 6-10 Ale/Bier/Wein."; }

		{ String _name = "NMTDriftersDock";			String _text = "Treibgutdock"; }
		{ String _name = "NMTDriftersDockLwr";			String _text = "Treibgutdock"; }
		{ String _name = "NMTDriftersDockTip";			String _text = "NMT Treibgutdock: ein Arbeitsplatz, dessen Aufgabe es ist, mit einem Boot nach ungenutzten treibenden Baumstämmen zu suchen. Größe: 7x7. Kosten: 48 Baumstämme, 8 Eisen. Erzeugt: 2-3 Baumstämme pro Aufgabe. Bietet Arbeit für 1-3 Förster. Tipp: Sie werden sie nicht mit ihren Booten fahren sehen, aber das ist ihre RPG-Aufgabe: umherziehen und treibende Baumstämme einsammeln. Die Ertragszahlen basieren auf einer echten Försterhütte."; }

		{ String _name = "NMTDriftersStoneDock";			String _text = "Treibgutdock"; }
		{ String _name = "NMTDriftersStoneDockLwr";			String _text = "Treibgutdock"; }
		{ String _name = "NMTDriftersStoneDockTip";			String _text = "NMT Treibgutsteindock: ein Arbeitsplatz, dessen Aufgabe es ist, mit einem Boot nach ungenutzten treibenden Baumstämmen zu suchen. Größe: 7x7. Kosten: 48 Baumstämme, 8 Eisen. Erzeugt: 2-3 Baumstämme pro erledigter Aufgabe. Bietet Arbeit für 1-3 Förster. Tipp: Sie werden sie nicht mit ihren Booten fahren sehen, aber das ist ihre RPG-Aufgabe: umherziehen und treibende Baumstämme einsammeln. Die Ertragszahlen basieren auf einer echten Försterhütte."; }

		{ String _name = "NMTWaterMineDock";			String _text = "Wasserminendock"; }
		{ String _name = "NMTWaterMineDockLwr";			String _text = "Wasserminendock"; }
		{ String _name = "NMTWaterMineDockTip";			String _text = "NMT Wasserminendock: ein Arbeitsplatz, dessen Aufgabe es ist, Luft zu holen, zu tauchen und am Meeresgrund zu schürfen. Größe: 10x10. Kosten: 92 Baumstämme, 12 Eisen. Erzeugt zufällig: 2-3 Erze oder Steine pro erledigter Aufgabe. Bietet Arbeit für 1-8 Bergleute. Tipp: Teil ihrer RPG-Aufgabe ist es, zum Meeresgrund zu tauchen und zu schürfen. Erhalten Sie wertvolles Eisenerz, Kupfererz, Stein, Silber- und Golderze sowie gelegentlich Edelsteine."; }

