		{ String _name = "NMTFishingDockSet";			String _text = "Angeldock"; }
		{ String _name = "NMTFishingDockSetLwr";		String _text = "Angeldock"; }
		{ String _name = "NMTFishingDockSetTip";		String _text = "NMT Docks Angeldock: ein Arbeitsplatz, an dem Fisch gefangen wird. Größe: 4x7. Kosten: 30 Baumstämme. Arbeitskreisradius: 14. Bietet Arbeit für 1-3 Fischer. Tipp: Überlappende Arbeitskreise zweier Angeldocks oder Bauwerke innerhalb eines Kreises verringern den Fischfang. Bitte die Vorderseite dieses Gebäudes für die Fischkisten freihalten und nicht als Gehdock verwenden."; }

