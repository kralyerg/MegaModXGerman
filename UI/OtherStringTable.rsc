//TREE
		{ String _name = "NoTreeAE";			String _text = "Keine Baeume - Adam und Eva"; }
		{ String _name = "NoTreeAEDesc";		String _text = "Keine Baeume. Beginnt mit nur 2 Personen. Eine kleine Menge an Nahrung, Brennholz und Kleidung wird in einem kleinen Lagerwagen bereitgestellt."; }

		{ String _name = "NoTreeEasy";			String _text = "Keine Baeume - Leicht"; }
		{ String _name = "NoTreeEasyDesc";		String _text = "Keine Baeume. Ein leichtes Spiel beginnt mit sechs Familien. Eine grosse Menge an Kleidung, Nahrung, Brennholz, Baumaterialien und Werkzeugen wird bereitgestellt. Haeuser und Lagerbereiche wurden bereits gebaut. Saatgut fuer Felder und Obstgaerten ist verfuegbar, ebenso eine Herde Vieh."; }

		{ String _name = "NoTreeMedium";			String _text = "Keine Baeume - Mittel"; }
		{ String _name = "NoTreeMediumDesc";		String _text = "Keine Baeume. Ein mittelschweres Spiel beginnt mit fuenf Familien. Kleidung, Nahrung, Brennholz, Werkzeuge und Baumaterialien werden bereitgestellt. Eine Lagerscheune wurde bereits gebaut. Einige Saaten fuer Felder und Obstgaerten sind verfuegbar."; }

		{ String _name = "NoTreeHard";			String _text = "Keine Baeume - Schwer"; }
		{ String _name = "NoTreeHardDesc";		String _text = "Keine Baeume. Ein schweres Spiel beginnt mit vier Familien. Eine kleine Menge an Kleidung, Nahrung, Brennholz und Werkzeugen wird bereitgestellt. Es ist kein Saatgut fuer den Ackerbau verfuegbar."; }

