		// This is the very MAIN Toolbar ++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
		{ String _name = "OrchardLodgesToolbar";		String _text = "Werkzeugleiste Obstgarten-Hütten"; }
		{ String _name = "OrchardLodgesToolbarLwr";		String _text = "werkzeugleiste Obstgarten-Hütten"; }
		{ String _name = "OrchardLodgesToolbarTip";		String _text = "Werkzeugleiste Obstgarten-Hütten. Öffnet diese Werkzeugleiste für die Obstgarten-Hütten-Optionen. (Definiert einen Bereich, in dem gezielt Bäume gefällt und neue Obstbaum-Setzlinge gepflanzt werden. Kosten: 32 Holz, 12 Stein. Radius: 24 Felder. Beschäftigung: 1-2 Förster.)"; }

		{ String _name = "OrchardLodges2Toolbar";		String _text = "Werkzeugleiste Tropische Hütten"; }
		{ String _name = "OrchardLodges2ToolbarLwr";		String _text = "werkzeugleiste Tropische Hütten"; }
		{ String _name = "OrchardLodges2ToolbarTip";		String _text = "Werkzeugleiste Tropische Hütten. Öffnet diese Werkzeugleiste für die Optionen der tropischen Obstgarten-Hütten. (Definiert einen Bereich, in dem gezielt Bäume gefällt und neue tropische Obstbaum-Setzlinge gepflanzt werden. Kosten: 32 Holz, 12 Stein. Radius: 24 Felder. Beschäftigung: 1-2 Förster.)"; }

		{ String _name = "OrchardLodgeAppleTree";		String _text = "Apfel-Hütte"; }
		{ String _name = "OrchardLodgeAppleTreeLwr";		String _text = "apfel-Hütte"; }
		{ String _name = "OrchardLodgeAppleTreeTip";		String _text = "Definiert einen Bereich, in dem gezielt Bäume gefällt und neue Apfel-Setzlinge gepflanzt werden. Grösse: 5x6. Kosten: 32 Baumstämme, 12 Stein. Radius: 24 Felder. Beschäftigung: 1-2 Förster. Tipps: Alles wird entfernt und durch einen Apfel-Baum ersetzt, der mit der Zeit reichlich Äpfel abwirft. Es funktioniert wie ein Obstgarten, ist aber wie eine Försterhütte angelegt."; }

