		{ String _name = "NMT20AleStand";			String _text = "Bierstand"; }
		{ String _name = "NMT20AleStandLwr";			String _text = "bierstand"; }
		{ String _name = "NMT20AleStandTip";			String _text = "Landbier Stand is taking all your alcohols and offer those to your Bürger. Grösse: 4x3. Kosten: 16 Baumstämme. Kapazität: 3000 Gewicht. Radius: 20 Feldern. Beschäftigung: 1-2 Braür. Tipps: The Braür will go around and grab all alcohols in the town and fill their stand. Citizens can pickup alcohols and get (0.05%) happiness from it."; }

