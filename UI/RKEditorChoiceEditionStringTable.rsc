		{ String _name = "NMT30CharcoalKilnLwr";		String _text = "holzkohlemeiler"; }
		{ String _name = "NMT30CharcoalKilnTip";		String _text = "Holzkohle Kiln is taking Brennholz and do charcoal with those. Grösse: 6x6. Kosten: 12 Baumstämme, 32 Stein. Herstellbar: 18-24 charcoal from 12 Brennholz. Beschäftigung: 1-2 Arbeiter. Tipps: Double your amount of fül and provide enough fül for double housing to compare with Brennholz."; }

