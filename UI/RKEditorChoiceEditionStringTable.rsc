		{ String _name = "RKFCLumbermill";			String _text = "Sägewerk"; }
		{ String _name = "RKFCLumbermillLwr";			String _text = "sägewerk"; }
		{ String _name = "RKFCLumbermillTip";			String _text = "Lumbermill is used to make Bauholz from Logs. Grösse: 5x6. Kosten: 48 Baumstämme, 6 Stein. Can make : Bauholz, Brennholz. Beschäftigung: 1-3 woodcutters. Tipps: The Lumbermill is an early settlement building, all tier 2+ buildings will require Bauholz. It can also make Brennholz if needed. Drücke F für alternative Dachfarben."; }

		{ String _name = "RKFCForestBarn";			String _text = "Waldscheune"; }
		{ String _name = "RKFCForestBarnLwr";			String _text = "waldscheune"; }
		{ String _name = "RKFCForestBarnTip";			String _text = "A Forest Barn can store everything that can come from forest outposts. Grösse: 5x6. Kosten: 48 Baumstämme, 12 Stein. Kapazität: 12000 Gewicht. Akzeptiert: Edibles, Tool, Health, Fül, Wood, Textile, Grain, Vegetable, Fruit, Protein. Tipps: Very usefull to store simple goods coming from forest outposts."; }

		{ String _name = "TradingPostSeeds";			String _text = "HP Saatgut & Tierbestand"; }
		{ String _name = "TradingPostSeedsLwr";			String _text = "hP Saatgut & Tierbestand"; }
		{ String _name = "TradingPostSeedsTip";			String _text = "Allows for the trade of Ressourcen with only seeds/livestock merchants. Grösse: 8x11. Kosten: 48 Baumstämme, 32 Stein, 12 Eisen. Kapazität: 30000 Gewicht. Akzeptiert: Wood, Stone, Iron, Fül, Tool, Textile, Clothing, Minerals, Crafted, Forged, Fabrics, Industrial, Materials, Construction, Precious, Misc.  Beschäftigung: 1-10 traders. Tipps: Livestocks and Seeds merchants dösnt accept herbs and food."; }

		{ String _name = "RKWoodBakery";				String _text = "Bäckerei"; }
		{ String _name = "RKWoodBakeryLwr";				String _text = "bäckerei"; }
		{ String _name = "RKWoodBakeryTip";				String _text = "Medieval bakery takes flour and makes bread, cakes and pies. Grösse: 5x6. Kosten: 32 Bauholz, 16 Stein, 24 charcoal, 6 Glas. Herstellbar: bread, cake, pies, quiche, omelette.  Beschäftigung: 1-2 Bäcker. Tipps: Great for making tier 2 food. Bakeries will take some various amount of food, of flour and will try to give you (+100% educated +50% uneducated) more food overall. And some food have more than 1 diet."; }

		{ String _name = "NMT30Windmill";				String _text = "Windmühle"; }
		{ String _name = "NMT30WindmillLwr";				String _text = "windmühle"; }
		{ String _name = "NMT30WindmillTip";				String _text = "Medieval windmill makes flour from grain. Grösse: 6x6. Kosten: 48 Bauholz, 42 Stein, 32 Eisen. Herstellbar: flour from wheat, corn, barley, sorghum, oat, rye, rice. Beschäftigung: 1-2 millers. Tipps: Drücke F für alternative Modelle. They take 16 grains and make 24-32 flour. +100% educ. , +50% uneduc."; }

		{ String _name = "NMT30Watermill";				String _text = "Wassermühle"; }
		{ String _name = "NMT30WatermillLwr";				String _text = "wassermühle"; }
		{ String _name = "NMT30WatermillTip";				String _text = "Medieval watermill makes flour from grain. Grösse: 9x7. Kosten: 48 Bauholz, 42 Stein, 32 Eisen. Herstellbar: flour from wheat, corn, barley, sorghum, oat, rye, rice. Beschäftigung: 1-3 millers. Tipps: This building require some Wasser Feldern. Work faster than windmill. They take 16 grains and make 24-32 flour. +100% educ. , +50% uneduc."; }

		{ String _name = "NMT30Apiary";					String _text = "Bienenhaus"; }
		{ String _name = "NMT30ApiaryLwr";				String _text = "bienenhaus"; }
		{ String _name = "NMT30ApiaryTip";				String _text = "Medieval Apiary is used to keep bees and generate honey and beewax. Grösse: 6x6. Kosten: 16 Baumstämme, 24 fodder-thatch. Herstellbar: honey (food), beeswax (candles). Beschäftigung: 1-2 Imker. Tipps: This food building provide early in the game, a very good steady source of food. You will also need it for beeswax to make candle to upgrade your deplecated mines and quarries."; }

		{ String _name = "WoodButcher";					String _text = "Metzger"; }
		{ String _name = "WoodButcherLwr";				String _text = "metzger"; }
		{ String _name = "WoodButcherTip";				String _text = "Butcher cuts meats and makes tier 2 food. Grösse: 4x6. Kosten: 48 Bauholz, 42 Stein, 32 Eisen. Herstellbar: Tier 2 prepared meats (steaks roasts chops and poultries). Beschäftigung: 1-2 butchers. Tipps: Very good building to take your raw meats and raw poultry meats and process them to double your protein quantities. From 12 meat you get 18-24 steak (educated = +100%) (Uneducated = +50% only)."; }

		{ String _name = "NMT30LightHouse";				String _text = "Leuchtturm"; }
		{ String _name = "NMT30LightHouseLwr";				String _text = "leuchtturm"; }
		{ String _name = "NMT30LightHouseTip";				String _text = "A LightHouse will offer town statistics and will attract nomads from far away. Grösse: 11x8. Kosten: 58 Bauholz, 98 Stein, 14 Eisen, 16 Kupfer, 24 Glas, 32 Brennholz. Beschäftigung: 1 fireworker. Tipps: The fireworker will take care of the fire at top so you can attract nomads. The Lighthouse offer all the services a townhall can provide."; }

		{ String _name = "NMT30Watertower";				String _text = "Wasserturm"; }
		{ String _name = "NMT30WatertowerLwr";				String _text = "wasserturm"; }
		{ String _name = "NMT30WatertowerTip";				String _text = "A Watertower provide fresh Wasser to your Bürger. Grösse: 4x5. Kosten: 34 Baumstämme, 8 Eisen. Herstellbar: 12-15 Wasser from the watertower.  Beschäftigung: 1-2 Arbeiter. Tipps: The Wasser serves as food but has no nutrients. Some buildings needs Wasser over time (like the greenhouses) as input."; }

		{ String _name = "NMT30Cathedral";				String _text = "Kathedrale"; }
		{ String _name = "NMT30CathedralLwr";				String _text = "kathedrale"; }
		{ String _name = "NMT30CathedralTip";				String _text = "The Medieval Cathedral provides happiness for the devout and a place to meet and worship. Grösse: 12x20. Kosten: 90 Bauholz, 160 Stein, 64 Glas, 18 Silber, 12 gold, 80 Dachziegel. Capacity 800 souls. Radius: 60 Feldern. Beschäftigung: 1 cleric. Tipps: Many saves should have a magnificient Chathedral ! But not all of them."; }

		{ String _name = "NMT30SaltMine";				String _text = "Salzmine"; }
		{ String _name = "NMT30SaltMineLwr";				String _text = "salzmine"; }
		{ String _name = "NMT30SaltMineTip";				String _text = "The Salz Mine is a Arbeitsstätte that provides salt. Grösse: 6x6. Kosten: 24 Baumstämme, 32 Bauholz, 12 Eisen. Abbaubar: 4-6 salt from the ground. Abbau: 20 Feldern. Capacity 4000 Nicht erneuerbar. Beschäftigung: 1-5 Bergleute. Tipps: Faster way to get salt. Salz is a mineral. When deplecated, destroy and build another one."; }

		{ String _name = "NMT30OldSmokery";				String _text = "Alte Räucherei"; }
		{ String _name = "NMT30OldSmokeryLwr";				String _text = "alte Räucherei"; }
		{ String _name = "NMT30OldSmokeryTip";				String _text = "The Old Smokery ist eine Arbeitsstätte, die Fleisch zur Haltbarmachung räuchert. Grösse: 6x6. Kosten: 18 Bauholz, 48 Stein, 12 Eisen, 4 Glas. Herstellbar: Tier 2 prepared meats (smoked meats fish and poultries). Beschäftigung: 1-2 Bäcker. Tipps: This building needs +1 Brennholz for each smoke process. But the output Wert stay at 3 (not 2). Fisch at 2 Wert. They take 12 input and they make 18-24 output. +100% educ. , +50% uneduc."; }

		{ String _name = "NMT30OldSaltery";				String _text = "Alte Salzerei"; }
		{ String _name = "NMT30OldSalteryLwr";				String _text = "alte Salzerei"; }
		{ String _name = "NMT30OldSalteryTip";				String _text = "The Old Saltery ist eine Arbeitsstätte, die Fleisch zur Haltbarmachung salzt. Grösse: 6x6. Kosten: 36 Bauholz, 16 Stein, 8 Eisen. Herstellbar: Tier 2 prepared meats (cured meats fish and poultries). Beschäftigung: 1-2 Bäcker. Tipps: This building needs +3 salt for each cured process. But the output Wert stay at 3 (not 2). Fisch at 2 Wert. They take 12 input and they make 18-24 output. +100% educ. , +50% uneduc."; }

		{ String _name = "NMT30DryShack";				String _text = "Alte Trockenhütte"; }
		{ String _name = "NMT30DryShackLwr";				String _text = "alte Trockenhütte"; }
		{ String _name = "NMT30DryShackTip";				String _text = "The Old Dry Shack ist eine Arbeitsstätte, die Fleisch zur Haltbarmachung trocknet. Grösse: 6x6. Kosten: 28 Bauholz, 6 wood, 4 Stein. Herstellbar: Tier 2 prepared meats (dried meats fish and poultries). Beschäftigung: 1-2 Bäcker. Tipps: This building only needs meats. No other input but the Wert of the meats lost 1 Wert. They take 12 input and they make 18-24 output. +100% educ. , +50% uneduc."; }

		{ String _name = "NMT30Creamery";				String _text = "Alte Molkerei"; }
		{ String _name = "NMT30CreameryLwr";				String _text = "alte Molkerei"; }
		{ String _name = "NMT30CreameryTip";				String _text = "The Old Creamery ist eine Arbeitsstätte, die aus Milch Käse, Butter, Sahne und Joghurt herstellt. Grösse: 8x8. Kosten: 36 Bauholz, 24 Stein, 8 Glas, 6 Eisen. Herstellbar: Tier 2 prepared meats (cheese butter cream yogurt). Beschäftigung: 1-2 Milchmänner. Tipps: This building mainly needs milk. You can add some fruits. The outputs are variable dü to the recipes. Education is important in the output numbers."; }

		{ String _name = "RKRedCreamery";				String _text = "Rote Molkerei"; }
		{ String _name = "RKRedCreameryLwr";				String _text = "rote Molkerei"; }
		{ String _name = "RKRedCreameryTip";				String _text = "Red Creamery ist eine Arbeitsstätte, die aus Milch Käse, Butter, Sahne und Joghurt herstellt. Grösse: 9x10. Kosten: 68 Bauholz, 12 Stein, 16 Kupfer, 8 Glas, 16 glassware. Herstellbar: Tier 2 prepared meats (cheese butter cream yogurt). Beschäftigung: 1-3 Milchmänner. Tipps: This building mainly needs milk. You can add some fruits. The outputs are variable dü to the recipes. Education is important in the output numbers. The red creamery is a lot faster than the old creamery."; }

		{ String _name = "NMT30MaltHouse";				String _text = "Malzhaus"; }
		{ String _name = "NMT30MaltHouseLwr";				String _text = "malzhaus"; }
		{ String _name = "NMT30MaltHouseTip";				String _text = "The Malz House ist eine Arbeitsstätte, die Getreide zu Malz verarbeitet. Grösse: 6x8. Kosten: 12 Baumstämme, 24 Bauholz, 48 Stein, 24 brick, 8 Eisen, 12 Glas. Herstellbar: 18-24 Malz from 12 grain (barley corn oat rye sorghum wheat). Beschäftigung: 1-2 Braür. Tipps: Old ale has a Wert of 6 now. Bier has replaced Landbier at 8 Wert but beer needs malt. So now, you need to convert the grain into malt, and taverns will brew the malt."; }

		{ String _name = "NMT30Pond";					String _text = "Mittelalterlicher Teich"; }
		{ String _name = "NMT30PondLwr";				String _text = "mittelalterlicher Teich"; }
		{ String _name = "NMT30PondTip";				String _text = "A Medieval Pond provides fish to your Bürger. Grösse: 8x9. Kosten: 4 Baumstämme, 12 Stein. Kapazität: Unlimited. Tipps: Very independant from traditional fishing dock, the Pond will have an equivalent output. If you decide to remove it, you will need to use the flatten tool to get the ground back to normal."; }

		{ String _name = "StorageBarn";					String _text = "Lagerscheune"; }
		{ String _name = "StorageBarnLwr";				String _text = "lagerscheune"; }
		{ String _name = "StorageBarnTip";				String _text = "Used to store goods such as food, clothes, textiles, and tools. Grösse: 5x8. Kosten: 48 Baumstämme, 16 Stein. Kapazität: 8000 Gewicht. Akzeptiert: Edibles, Tool, Herbs, Clothing, Textile, Grain, Vegetable, Fruit, Protein, Crafted, Forged, Fabrics, Precious, Misc. Tipps: Make sure you always have some barn space available to store your food and other things."; }

		{ String _name = "NMT30StorageBarnNorm";			String _text = "Normale Scheune"; }
		{ String _name = "NMT30StorageBarnNormLwr";			String _text = "normale Scheune"; }
		{ String _name = "NMT30StorageBarnNormTip";			String _text = "A Normal Barn is used to store goods such as food, clothes, textiles, and tools. Grösse: 5x8. Kosten: 48 Baumstämme, 16 Stein. Kapazität: 10000 Gewicht. Akzeptiert: Edibles, Tool, Herbs, Clothing, Textile, Grain, Vegetable, Fruit, Protein, Crafted, Forged, Fabrics, Precious, Misc. Tipps: This barn is the exact same one as inside the game storage toolbar."; }

		{ String _name = "NMT30StorageBarnMed";				String _text = "Mittlere Scheune"; }
		{ String _name = "NMT30StorageBarnMedLwr";			String _text = "mittlere Scheune"; }
		{ String _name = "NMT30StorageBarnMedTip";			String _text = "A Medium Barn is used to store goods such as food, clothes, textiles, and tools. Grösse: 4x6. Kosten: 32 Baumstämme, 12 Stein. Kapazität: 6000 Gewicht. Akzeptiert: Edibles, Tool, Herbs, Clothing, Textile, Grain, Vegetable, Fruit, Protein, Crafted, Forged, Fabrics, Precious, Misc. Tipps: This barn is a smaller version of the regular barn. Cheaper and also medium size, it has a medium capacity."; }

		{ String _name = "NMT30StorageBarnSmall";			String _text = "Kleine Scheune"; }
		{ String _name = "NMT30StorageBarnSmallLwr";			String _text = "kleine Scheune"; }
		{ String _name = "NMT30StorageBarnSmallTip";			String _text = "A Small Barn is used to store goods such as food, clothes, textiles, and tools. Grösse: 3x5. Kosten: 24 Baumstämme, 8 Stein. Kapazität: 3800 Gewicht. Akzeptiert: Edibles, Tool, Herbs, Clothing, Textile, Grain, Vegetable, Fruit, Protein, Crafted, Forged, Fabrics, Precious, Misc. Tipps: This barn is a smaller version of the medium barn. More cheaper and also small size, it has a small capacity."; }

		{ String _name = "NMT30StorageBarnTiny";			String _text = "Winzige Scheune"; }
		{ String _name = "NMT30StorageBarnTinyLwr";			String _text = "winzige Scheune"; }
		{ String _name = "NMT30StorageBarnTinyTip";			String _text = "A Tiny Barn is used to store goods such as food, clothes, textiles, and tools. Grösse: 2x3. Kosten: 16 Baumstämme, 4 Stein. Kapazität: 1600 Gewicht. Akzeptiert: Edibles, Tool, Herbs, Clothing, Textile, Grain, Vegetable, Fruit, Protein, Crafted, Forged, Fabrics, Precious, Misc. Tipps: This barn is a tiny version of the small barn. A lot more cheaper and also tiny size, it has a tiny capacity."; }

		{ String _name = "NMT30Granary";				String _text = "Kornspeicher"; }
		{ String _name = "NMT30GranaryLwr";				String _text = "kornspeicher"; }
		{ String _name = "NMT30GranaryTip";				String _text = "A Granary is specialized storage used to store only food (edible and non-edible). Grösse: 5x8. Kosten: 58 Baumstämme, 16 Stein. Kapazität: 12000 Gewicht. Akzeptiert: Edibles, Grain, Vegetable, Fruit, Protein. Tipps: This granary is a kind of barn but it only store food (edible and non-edible) and has an higher capacity per Feld. Cost a little bit more than regular barn."; }

		{ String _name = "NMT30RootCellar";				String _text = "Wurzelkeller"; }
		{ String _name = "NMT30RootCellarLwr";				String _text = "wurzelkeller"; }
		{ String _name = "NMT30RootCellarTip";				String _text = "A Root Cellar is specialized underground storage used to store only Fruit/Vegetable. Grösse: 4x5. Kosten: 6 Baumstämme, 26 Stein. Kapazität: 8000 Gewicht. Akzeptiert: Vegetable, Fruit. Tipps: This root cellar is an underground kind of barn but it only store fruits and vegetables and has a lot higher capacity per Feld. Cost more Steine than Baumstämme."; }

		{ String _name = "RKmeatLocker";				String _text = "Fleischkammer"; }
		{ String _name = "RKmeatLockerLwr";				String _text = "fleischkammer"; }
		{ String _name = "RKmeatLockerTip";				String _text = "A Meat Locker is specialized half-underground storage used to store only Meat/Proteins. Grösse: 3x3 Feldern. Kosten: 5 Baumstämme, 12 Stein. Kapazität: 3600 Gewicht. Akzeptiert: Protein. Tipps: This meat locker is an half underground kind of barn but it only store meats and proteins and has a lot higher capacity per Feld. Cost more Steine than Baumstämme."; }

		{ String _name = "NMT30BarberShop";				String _text = "Frisiersalon"; }
		{ String _name = "NMT30BarberShopLwr";				String _text = "frisiersalon"; }
		{ String _name = "NMT30BarberShopTip";				String _text = "The BarberShop is a place held by a doctor who will help to keep your Bürger healthy. Grösse: 4x5 Feldern. Kosten: 8 Baumstämme, 24 Bauholz, 32 Stein, 8 Glas, 12 perfum, 1 Silber. Andrang: 10. Beschäftigung: 1 doctor. Tipps: This is a smaller version of the hospital and it will act the same way. Accept 10 patients only. The design is made to be to fit under Multi-level floors. Won't attract idlers."; }

		{ String _name = "NMT30Dentist";				String _text = "Zahnarzt"; }
		{ String _name = "NMT30DentistLwr";				String _text = "zahnarzt"; }
		{ String _name = "NMT30DentistTip";				String _text = "The Dentist is a place held by a doctor who will help to keep your Bürger healthy. Grösse: 4x5 Feldern. Kosten: 8 Baumstämme, 24 Bauholz, 32 Stein, 8 Glas, 6 Kupfer, 1 gold. Andrang: 10. Beschäftigung: 1 doctor. Tipps: This is a smaller version of the hospital and it will act the same way. Accept 10 patients only. The design is made to be to fit under Multi-level floors. Won't attract idlers."; }

		{ String _name = "NMT30Clinic";					String _text = "Klinik"; }
		{ String _name = "NMT30ClinicLwr";				String _text = "klinik"; }
		{ String _name = "NMT30ClinicTip";				String _text = "The Clinic is a place held by a doctor who will help to keep your Bürger healthy. Grösse: 4x5 Feldern. Kosten: 8 Baumstämme, 24 Bauholz, 32 Stein, 8 Glas, 18 glassware, 24 herbs. Andrang: 20. Beschäftigung: 1 doctor. Tipps: This is a smaller version of the hospital and it will act the same way. Accept 10 patients only. The design is made to be to fit under Multi-level floors. Won't attract idlers."; }

		{ String _name = "NMT30BathHouse";				String _text = "Badehaus"; }
		{ String _name = "NMT30BathHouseLwr";				String _text = "badehaus"; }
		{ String _name = "NMT30BathHouseTip";				String _text = "The Bath House is an essential place for hygiene which help to keep your Bürger healthy.  Grösse: 8x6 Feldern. Kosten: 24 Bauholz, 56 Stein, 24 Glas, 8 Kupfer, 24 perfums, 36 herbs. Hapiness: Health. Radius: 60. Andrang: 200. Beschäftigung: 1 Arbeiter. Tipps: This is big building with a large radius. It provide hapiness: health and will attract idlers. The design is made to be to fit under Multi-level floors."; }

		{ String _name = "NMT30SchoolHouse";				String _text = "Mittelalterliche Schule"; }
		{ String _name = "NMT30SchoolHouseLwr";				String _text = "Mittelalterliche Schule"; }
		{ String _name = "NMT30SchoolHouseTip";				String _text = "The Medieval School is used to educate Bürger to be more productive. Grösse: 5x5 Feldern. Kosten: 48 Bauholz, 26 Stein, 12 Eisen, 8 Kupfer, 24 Glas. Andrang: 40. Beschäftigung: 1 teacher. Tipps: This is an education building with double students capacity to compare the regular school. Education is extremly essential in this mod. Non-Education increase largely the difficulty of the game."; }

		{ String _name = "RKShopHardware";				String _text = "Rohstoffe"; }
		{ String _name = "RKShopHardwareLwr";				String _text = "rohstoffe"; }
		{ String _name = "RKShopHardwareTip";				String _text = "The Raw Materials Store is a little market that only sell raw materials (Wood, Minerals, Iron). Grösse: 4x5 Feldern. Kosten: 24 Baumstämme, 36 Stein. Verkauft: (30%)Logs (40%)Minerals (30%)Iron. Kapazität: 10000 Gewicht. Beschäftigung: 1-6 Händler. Tipps: It Is a good market to provide a Schmied, a foundry, and any production building that use Baumstämme+Eisen and/or minerals. It fit under Multi-level floors."; }

		{ String _name = "RKShopBuilding";				String _text = "Baumaterialien"; }
		{ String _name = "RKShopBuildingLwr";				String _text = "baumaterialien"; }
		{ String _name = "RKShopBuildingTip";				String _text = "The Building Materials Store is a little market that only sell Tier2 building materials (Stone, Construction: Bauholz, Glas, Bricks, Rooftiles...). Grösse: 4x5 Feldern. Kosten: 24 Baumstämme, 36 Stein. Verkauft: (20%)Stone (80%)Construction. Kapazität: 10000 Gewicht. Beschäftigung: 1-6 Händler. Tipps: It Is a good market to provide building materials to an area in developpement. It fit under Multi-level floors."; }

		{ String _name = "RKShopGrocery";				String _text = "Lebensmittelladen"; }
		{ String _name = "RKShopGroceryLwr";				String _text = "lebensmittelladen"; }
		{ String _name = "RKShopGroceryTip";				String _text = "The Grocery Store is a little market that only sell food (Proteins, Grain, Vegetables and Fruits). Grösse: 4x5 Feldern. Kosten: 24 Baumstämme, 36 Stein. Verkauft: Food (25%)Grain (25%)Fruit (25%)Vegetable (25%)Protein. Kapazität: 10000 Gewicht. Beschäftigung: 1-6 Händler. Tipps: It Is a good market to provide food to a housing district. Will grab edible and non-edible food. It fit under Multi-level floors."; }

		{ String _name = "RKShopDelicate";				String _text = "Bedarf & Waren"; }
		{ String _name = "RKShopDelicateLwr";				String _text = "bedarf & Waren"; }
		{ String _name = "RKShopDelicateTip";				String _text = "The Supplies & Goods is a little market that only sell some various goods. Grösse: 4x5 Feldern. Kosten: 24 Baumstämme, 36 Stein. Verkauft: (25%)Tool (25%)Fül (25%)Clothing (25%)Health. Kapazität: 10000 Gewicht. Beschäftigung: 1-6 Händler. Tipps: It Is a good market to provide everything else that is not food to a housing district. Should provide everything else than food for all your housing. It fit under Multi-level floors."; }

		{ String _name = "RKShopFabrics";				String _text = "Stoffe & Co."; }
		{ String _name = "RKShopFabricsLwr";				String _text = "stoffe & Co."; }
		{ String _name = "RKShopFabricsTip";				String _text = "The Fabrics & Co. is a little market that only sell fabrics materials to craft cloths (Textiles and Fabrics). Grösse: 4x5 Feldern. Kosten: 24 Baumstämme, 36 Stein. Verkauft: (50%)Textile (50%)Fabric. Kapazität: 10000 Gewicht. Beschäftigung: 1-6 Händler. Tipps: It Is a good market to provide tailors and everything that need textiles. It fit under Multi-level floors."; }

		{ String _name = "NewMedievalFlatTool";			String _text = "Planierwerkzeug"; }
		{ String _name = "NewMedievalFlatToolLwr";		String _text = "planierwerkzeug"; }
		{ String _name = "NewMedievalFlatToolTip";		String _text = "Das Planierwerkzeug ebnet den Boden wieder ein, nachdem ein Kanalstück, ein Teich oder eine Tagebaumine entfernt wurde... Auch sehr hilfreich, um Hügel einzübnen. Es legt ein oranges X auf den Boden. Sobald die Aufgabe erledigt ist, müsst ihr das Gebäude-Entfernen-Werkzeug benutzen, um das orange X zu beseitigen."; }

		{ String _name = "NMTMCsandpit";			String _text = "Sandgrube"; }
		{ String _name = "NMTMCsandpitLWR";			String _text = "sandgrube"; }
		{ String _name = "NMTMCsandpitTip";			String _text = "A Sand pit ist eine Arbeitsstätte, an der ihr Sand sammeln könnt. Grösse: 9x9 Feldern. Kosten: 12 Baumstämme. Erzeugbar: 6-9 Sand. Kapazität: Unlimited. Beschäftigung: 1-6 Steinmetze. Tipps: It will create 6-9 sand per job done. Sand is a material with a Wert of 1. Take care to not block the entrance. Please allow a road in front."; }

		{ String _name = "NMTMCclaypit";			String _text = "Tongrube"; }
		{ String _name = "NMTMCclaypitLWR";			String _text = "tongrube"; }
		{ String _name = "NMTMCclaypitTip";			String _text = "A Ton pit ist eine Arbeitsstätte, an der ihr Ton sammeln könnt. Grösse: 9x9 Feldern. Kosten: 12 Baumstämme. Erzeugbar: 1-2 Ton. Kapazität: Unlimited. Beschäftigung: 1-6 Steinmetze. Tipps: It will create 1-2 clay per job done. Ton is a material with a Wert of 3. Take care to not block the entrance. Please allow a road in front."; }

		{ String _name = "NMTMCkiln";				String _text = "Brennofen"; }
		{ String _name = "NMTMCkilnLWR";			String _text = "brennofen"; }
		{ String _name = "NMTMCkilnTip";			String _text = "A kiln ist eine Arbeitsstätte, an der ihr aus Ton Ziegel und Dachziegel herstellen könnt. Grösse: 6x6 Feldern. Kosten: 26 Stein. Herstellbar: 6-10 Ziegel(10 clay) or 6-10 Rooftile(10 clay). Beschäftigung: 1 Arbeiter. Tipps: It also needs 2 Brennholz per job done. Bricks and Dachziegel are construction items with a Wert of 5 each. A lot of buildings will require Ziegel and Dachziegel as building material."; }

		{ String _name = "NMTMCglassmaker";			String _text = "Glas Maker"; }
		{ String _name = "NMTMCglassmakerLWR";			String _text = "Glas maker"; }
		{ String _name = "NMTMCglassmakerTip";			String _text = "A Glas Maker ist eine Arbeitsstätte, an der ihr aus Sand Glas und Glaswaren herstellen könnt. Grösse: 6x6 Feldern. Kosten: 38 Baumstämme, 32 Stein, 12 Eisen. Herstellbar: 6-8 Glas(23 sand) or 6-9 Glaswaren(23 sand). Beschäftigung: 1 Arbeiter. Tipps: It also needs 6 Brennholz or 3 coal per job done. Glas is a construction item with a Wert of 8. Glaswaren is a crafted item with a Wert of 7. A lot of buildings will require Glas as building material. Glaswaren is needed for production or building material."; }

		{ String _name = "NMT30MCironQuarry";			String _text = "Eisensteinbruch"; }
		{ String _name = "NMT30MCironQuarryLWR";		String _text = "eisensteinbruch"; }
		{ String _name = "NMT30MCironQuarryTip";		String _text = "An Iron Quarry is a Arbeitsstätte where you can mine Iron or Kupfer. Grösse: 10x10 Feldern. Kosten: 48 Baumstämme. Erzeugbar: 2-3 Eisenerz or 2-3 Kupfererz pro Arbeitsgang. Kapazität: 2000. Beschäftigung: 1-6 Bergleute. Tipps: Eisenerz and Kupfererz are minerals with a Wert of 4. You will need a foundry to einschmelzen these Erze. (Blacksmiths can also help you bis ihr habt your foundry). Nach Erschöpfung kann es 5 Mal erneuert werden."; }

		{ String _name = "NMT30MCrockQuarry";			String _text = "Steinbruch"; }
		{ String _name = "NMT30MCrockQuarryLWR";		String _text = "steinbruch"; }
		{ String _name = "NMT30MCrockQuarryTip";		String _text = "An Rock Quarry is a Arbeitsstätte where you can mine Stone, Coal or Salz. Grösse: 10x10 Feldern. Kosten: 48 Baumstämme. Erzeugbar: 1-2 Stone or 3-4 Coal or 4-6 Salz pro Arbeitsgang. Kapazität: 2000. Beschäftigung: 1-6 Bergleute. Tipps: Stone is Stein limit with a Wert of 8. Coal is a mineral with a Wert of 4. And salt is a mineral with a Wert of 1. Nach Erschöpfung kann es 5 Mal erneuert werden."; }

		{ String _name = "NMT30MCrandomQuarry";			String _text = "Zufalls-Steinbruch"; }
		{ String _name = "NMT30MCrandomQuarryLWR";		String _text = "zufalls-Steinbruch"; }
		{ String _name = "NMT30MCrandomQuarryTip";		String _text = "An Random Quarry ist eine Arbeitsstätte, an der ihr zufällig alles Mögliche abbaün könnt. Grösse: 10x10 Feldern. Kosten: 48 Baumstämme. Can Create randomly: 1-2 Stone 3-4 Coal 4-6 Salz 2-3 IronOre 2-3 CopperOre pro Arbeitsgang. Kapazität: 2000. Beschäftigung: 1-6 Bergleute. Tipps: Stone has a Wert of 8. Coal, IronOre and CopperOre are minerals with a Wert of 4. And salt is a mineral with a Wert of 1. Nach Erschöpfung kann es 5 Mal erneuert werden. This random quarry can also give you 1 Gem(Wert 200), 1-2 Silver Ores(Wert 11) and 1-2 Gold Ores(Wert 22). Those are also minerals."; }

		{ String _name = "NMT30MCironQuarryLvl2";		String _text = "Eisensteinbruch Stufe 2"; }
		{ String _name = "NMT30MCironQuarryLvl2LWR";		String _text = "eisensteinbruch Stufe 2"; }
		{ String _name = "NMT30MCironQuarryLvl2Tip";		String _text = "An Iron Quarry Lvl2 is a Arbeitsstätte where you can mine Iron or Kupfer."; }

		{ String _name = "NMT30MCrockQuarryLvl2";		String _text = "Steinbruch Stufe 2"; }
		{ String _name = "NMT30MCrockQuarryLvl2LWR";		String _text = "steinbruch Stufe 2"; }
		{ String _name = "NMT30MCrockQuarryLvl2Tip";		String _text = "An Rock Quarry Lvl2 is a Arbeitsstätte where you can mine Stone, Coal or Salz."; }

		{ String _name = "NMT30MCrandomQuarryLvl2";		String _text = "Zufalls-Steinbruch Stufe 2"; }
		{ String _name = "NMT30MCrandomQuarryLvl2LWR";		String _text = "zufalls-Steinbruch Stufe 2"; }
		{ String _name = "NMT30MCrandomQuarryLvl2Tip";		String _text = "An Random Quarry Lvl2 ist eine Arbeitsstätte, an der ihr zufällig alles Mögliche abbaün könnt."; }

		{ String _name = "NMT30MCironQuarryLvl3";		String _text = "Eisensteinbruch Stufe 3"; }
		{ String _name = "NMT30MCironQuarryLvl3LWR";		String _text = "eisensteinbruch Stufe 3"; }
		{ String _name = "NMT30MCironQuarryLvl3Tip";		String _text = "An Iron Quarry Lvl3 is a Arbeitsstätte where you can mine Iron or Kupfer."; }

		{ String _name = "NMT30MCrockQuarryLvl3";		String _text = "Steinbruch Stufe 3"; }
		{ String _name = "NMT30MCrockQuarryLvl3LWR";		String _text = "steinbruch Stufe 3"; }
		{ String _name = "NMT30MCrockQuarryLvl3Tip";		String _text = "An Rock Quarry Lvl3 is a Arbeitsstätte where you can mine Stone, Coal or Salz."; }

		{ String _name = "NMT30MCrandomQuarryLvl3";		String _text = "Zufalls-Steinbruch Stufe 3"; }
		{ String _name = "NMT30MCrandomQuarryLvl3LWR";		String _text = "zufalls-Steinbruch Stufe 3"; }
		{ String _name = "NMT30MCrandomQuarryLvl3Tip";		String _text = "An Random Quarry Lvl3 ist eine Arbeitsstätte, an der ihr zufällig alles Mögliche abbaün könnt."; }

		{ String _name = "NMT30MCironQuarryLvl4";		String _text = "Eisensteinbruch Stufe 4"; }
		{ String _name = "NMT30MCironQuarryLvl4LWR";		String _text = "eisensteinbruch Stufe 4"; }
		{ String _name = "NMT30MCironQuarryLvl4Tip";		String _text = "An Iron Quarry Lvl4 is a Arbeitsstätte where you can mine Iron or Kupfer."; }

		{ String _name = "NMT30MCrockQuarryLvl4";		String _text = "Steinbruch Stufe 4"; }
		{ String _name = "NMT30MCrockQuarryLvl4LWR";		String _text = "steinbruch Stufe 4"; }
		{ String _name = "NMT30MCrockQuarryLvl4Tip";		String _text = "An Rock Quarry Lvl4 is a Arbeitsstätte where you can mine Stone, Coal or Salz."; }

		{ String _name = "NMT30MCrandomQuarryLvl4";		String _text = "Zufalls-Steinbruch Stufe 4"; }
		{ String _name = "NMT30MCrandomQuarryLvl4LWR";		String _text = "zufalls-Steinbruch Stufe 4"; }
		{ String _name = "NMT30MCrandomQuarryLvl4Tip";		String _text = "An Random Quarry Lvl4 ist eine Arbeitsstätte, an der ihr zufällig alles Mögliche abbaün könnt."; }

		{ String _name = "NMT30MCironQuarryLvl5";		String _text = "Eisensteinbruch Stufe 5"; }
		{ String _name = "NMT30MCironQuarryLvl5LWR";		String _text = "eisensteinbruch Stufe 5"; }
		{ String _name = "NMT30MCironQuarryLvl5Tip";		String _text = "An Iron Quarry Lvl5 is a Arbeitsstätte where you can mine Iron or Kupfer."; }

		{ String _name = "NMT30MCrockQuarryLvl5";		String _text = "Steinbruch Stufe 5"; }
		{ String _name = "NMT30MCrockQuarryLvl5LWR";		String _text = "steinbruch Stufe 5"; }
		{ String _name = "NMT30MCrockQuarryLvl5Tip";		String _text = "An Rock Quarry Lvl5 is a Arbeitsstätte where you can mine Stone, Coal or Salz."; }

		{ String _name = "NMT30MCrandomQuarryLvl5";		String _text = "Zufalls-Steinbruch Stufe 5"; }
		{ String _name = "NMT30MCrandomQuarryLvl5LWR";		String _text = "zufalls-Steinbruch Stufe 5"; }
		{ String _name = "NMT30MCrandomQuarryLvl5Tip";		String _text = "An Random Quarry Lvl5 ist eine Arbeitsstätte, an der ihr zufällig alles Mögliche abbaün könnt."; }

		{ String _name = "NMT30Foundry";			String _text = "Giesserei"; }
		{ String _name = "NMT30FoundryLWR";			String _text = "giesserei"; }
		{ String _name = "NMT30FoundryTip";			String _text = "A Foundry ist eine Arbeitsstätte, an der ihr alles einschmelzen könnt. Grösse: 8x8 Feldern. Kosten: 24 Baumstämme, 64 Stein, 18 Eisen, 32 charcoal. Erzeugbar: 1-2 Eisen, Kupfer, silevr or gold pro Arbeitsgang. Beschäftigung: 1-2 Schmiede. Tipps: The Foundry is the way to go to einschmelzen everything in the game and also is more efficient than the simple Schmied buildings. "; }

		{ String _name = "NMT30JewelMaker";			String _text = "Schmuckmacher"; }
		{ String _name = "NMT30JewelMakerLWR";			String _text = "schmuckmacher"; }
		{ String _name = "NMT30JewelMakerTip";			String _text = "A Jewelry Maker is taking precious metal and gems for crafting some very valuable rings, necklaces, and jewels. Grösse: 6x6 Feldern. Kosten: 8 Baumstämme, 24 Bauholz, 16 Stein, 18 brick, 6 Glas. Herstellbar: jewelries from cutted gems and gold/Silber, multiples recipes. Beschäftigung: 1 Arbeiter. Tipps: You need a gem cutter to cut those gems and once you determined their Wert, you can use those to make or a silvered or a golden version. Every recipes will drop more than just one item at time. Although, non-education is bad for this building. The list of recipes is too long to put it here."; }

		{ String _name = "NMT30GemCutter";			String _text = "Edelsteinschleifer"; }
		{ String _name = "NMT30GemCutterLWR";			String _text = "edelsteinschleifer"; }
		{ String _name = "NMT30GemCutterTip";			String _text = "A Gem Cutter is taking gems, cut those, determine their quality and Wert. Grösse: 6x6 Feldern. Kosten: 8 Baumstämme, 24 Bauholz, 16 Stein, 18 brick, 6 Glas. Herstellbar: amethyst(Wert 60) topaze(Wert 80) emerald(Wert 250) sapphire(Wert 300) ruby(Wert 400) diamond(Wert 1000). Beschäftigung: 1 Arbeiter. Tipps: The only way to get uncut gems is from the random quarry. Of course, higher Werte are a lot more rare than common ones."; }

		{ String _name = "NMT30CandleMaker";			String _text = "Kerzenmacher"; }
		{ String _name = "NMT30CandleMakerLWR";			String _text = "kerzenmacher"; }
		{ String _name = "NMT30CandleMakerTip";			String _text = "A Kerze Maker is making Candles from Bienenwachs. Grösse: 6x6 Feldern. Kosten: 12 Baumstämme, 24 Bauholz, 18 Stein, 24 brick, 12 Glas. Herstellbar: 3-4 candles from 16 beeswax pro Arbeitsgang. Beschäftigung: 1 Arbeiter. Tipps: Kerze has a Wert of 8. Candles are used to upgrade and renew mines and quarries once they are deplecated."; }

		{ String _name = "NMT30MineUpgradeTip";			String _text = "Erweitert und erneuert diese Mine/diesen Steinbruch auf eine tiefere Stufe, sodass ihr weiterhin Rohstoffe daraus gewinnen könnt, selbst wenn sie erschöpft ist. Dafür wird zusätzliches Material wie Kerzen benötigt."; }

		{ String _name = "RKGardenWallsGreenHouse";			String _text = "Gewächshaus"; }
		{ String _name = "RKGardenWallsGreenHouseLwr";			String _text = "gewächshaus"; }
		{ String _name = "RKGardenWallsGreenHouseTip";			String _text = "A GreenHouse is the most powerful food provider in this mod. Grösse: 5x7 Feldern. Kosten: 20 Bauholz, 20 Stein, 48 Glas. Herstellbar: All kind of vegetables in game and some small fruit plants, numbers created are variable from 16-24 to 20-28. Beschäftigung: 1 botanist. Tipps: Greenhouse need (2)fertilizer and (2)Wasser over time per each job done. (best source of fertilizer is the stable, pastures with some animals will help a lot too. The Wasser comes from a Wasser well or Wasser tower)."; }

		{ String _name = "RKGardenWallsStables";			String _text = "Ställe"; }
		{ String _name = "RKGardenWallsStablesLwr";			String _text = "ställe"; }
		{ String _name = "RKGardenWallsStablesTip";			String _text = "Stables is the best fertilizer provider in game. Grösse: 9x6 Feldern. Kosten: 20 Bauholz, 40 Stein. Can create: 3-5 fertilizer(Wert 2) from 2 fodder-thatch and 2 Wasser per job done. Beschäftigung: 1-2 Stallknechte. Tipps: You need a good source of fodder-thatch which can come from clearing or from the fodder farmer and Wasser from Wasser well or Wasser tower. Dünger is used in greenhouses(most powerful food generator per Feld)."; }

		{ String _name = "RKGardenWallsWell";				String _text = "Wasser Well"; }
		{ String _name = "RKGardenWallsWellLwr";			String _text = "Wasser well"; }
		{ String _name = "RKGardenWallsWellTip";			String _text = "A Wasser Well is a good source of fresh Wasser. Grösse: 1x1 Feldern(3x3 with roads). Kosten: 4 Bauholz, 24 Stein. Herstellbar: 12-15 Wasser(Wert 1) per job done. Beschäftigung: 1 Arbeiter. Tipps: This well CAN NOT be used for firefighting. It is producing Wasser slower than the Wasser tower. Wasser is a food without nutrients(no diet flags) and is needed in many industries like stables, greenhouses, perfumery, apothecary..."; }

		{ String _name = "RKGardenWallsFodderFarmers";			String _text = "Futterstroh-Baürn"; }
		{ String _name = "RKGardenWallsFodderFarmersLwr";		String _text = "futterstroh-Baürn"; }
		{ String _name = "RKGardenWallsFodderFarmersTip";		String _text = "A Fodder Farmers will plant grass and harvest fodder-thatch when grass is fully grown (instead of trees). Grösse: 5x6 Feldern. Kosten: 32 Bauholz, 4 Stein. Herstellbar: 3-4 fodder-thatch per harvested grass patch. Radius: 26 Feldern. Beschäftigung: 1-3 forester. Tipps: Funktioniert genau wie eine Försterhütte, pflanzt aber Gras. First they will have to clear everything in their radius, remove all trees and all Erze will help them alot. and once removed, they will plant a grass patch. This grass needs to grow, and when mature, it will be harvested. Fodder can be used also to make firebundles(Brennholz)."; }

		{ String _name = "RKGardenWallsFlorist";			String _text = "Florist"; }
		{ String _name = "RKGardenWallsFloristLwr";			String _text = "florist"; }
		{ String _name = "RKGardenWallsFloristTip";			String _text = "A Florist will wander and try to gather flowers. Grösse: 5x6 Feldern. Kosten: 32 Bauholz, 4 Stein. Herstellbar: 3-5 flowers per harvested flower patch. Radius: 32. Beschäftigung: 1 gatherer. Tipps: The florist will act exactly like a gatherer but it will search for flowers and seedlings. Not intended to be placed near forester/gatherer combo (very bad) but meant to be used in combo of the fodder farmer building. Grass will spawn tons of flowers. Warning: They will not plant flowers."; }

		{ String _name = "RKGardenWallsPerfumery";			String _text = "Parfümerie"; }
		{ String _name = "RKGardenWallsPerfumeryLwr";			String _text = "parfümerie"; }
		{ String _name = "RKGardenWallsPerfumeryTip";			String _text = "A Perfumery creates perfume from essence of flowers. Grösse: 5x5 Feldern. Kosten: 24 Bauholz, 24 Stein, 8 Kupfer, 12 glassware. Herstellbar: 5-8 perfumes (Wert 8) from 8 flower, 2 Wasser, 1 glassware per job done. Beschäftigung: 1 Arbeiter. Tips. One of the best item to sell that use something we can find everywhere: flowers. This building require Wasser and glassware over time. Wasser comes from Wasser well or Wasser tower and the glassware comes from the Glas maker."; }

		{ String _name = "RKGardenWallsCustom5Barn";			String _text = "Futterstroh-Scheune"; }
		{ String _name = "RKGardenWallsCustom5BarnLwr";			String _text = "futterstroh-Scheune"; }
		{ String _name = "RKGardenWallsCustom5BarnTip";			String _text = "This is a Fodder Barn that only allow fodder items and everything that fall into that category to be stored there. Grösse: 4x4 Feldern. Kosten: 12 Baumstämme, 28 fodder-thatch. Kapazität: 6000 Gewicht. Akzeptiert: Misc Items. Tipps: Fodder is Misc flag, so this is why it allows all Misc flag items. Allow alot more items to be stored in a 4x4 than a simple stockpile."; }

		{ String _name = "RKGardenWallsTrash";				String _text = "Entsorgen"; }
		{ String _name = "RKGardenWallsTrashLwr";			String _text = "entsorgen"; }
		{ String _name = "RKGardenWallsTrashTip";			String _text = "Diesen Gegenstand entsorgen und entfernen."; }
		{ String _name = "RKGardenWallsTrashUpgradeTip";		String _text = "Diesen Gegenstand entsorgen und entfernen."; }

		{ String _name = "OldBarnPub";				String _text = "Alte Scheunenkneipe"; }
		{ String _name = "OldBarnPubLWR";			String _text = "alte Scheunenkneipe"; }
		{ String _name = "OldBarnPubTip";			String _text = "An Old Barn Pub is a barn converted into a bar or pub. They will serve meals and drinking, and will have a festive ambience which will provide hapiness. Grösse: 6x6 Feldern. Kosten: 32 Baumstämme, 16 Stein. Hapiness: Entertainment. Radius: 40 Feldern. Beschäftigung: 1-3 Braür. Tipps: This building use a new flag: Consume. This special flag helps to deal with alcohol and will act the same. The Braür will take tier 2 meat, plus a vegetable and an alcohol and will make 12-16 meals (Wert  1). Citizens will pickup meals and get hapiness back from it (exactly like ale) but cost alot less."; }


		{ String _name = "ClearWildFood";			String _text = "Wildnahrung Sammeln"; }
		{ String _name = "ClearWildFoodLwr";			String _text = "wildnahrung Sammeln"; }
		{ String _name = "ClearWildFoodTip";			String _text = "Collect and harvest wild food spawns in the selected area. Tipps: Wild food are spawning from trees and alot new food are spawning from flowers."; }

		{ String _name = "ClearFodder";				String _text = "Futterstroh Sammeln"; }
		{ String _name = "ClearFodderLwr";			String _text = "futterstroh Sammeln"; }
		{ String _name = "ClearFodderTip";			String _text = "Collect and harvest fodder-thatch patches in the selected area. Tipps: Fodder-thatch is the material you get from harvesting patches of grass you can see on the ground. Fodder can be used in the stables, can be made into firebundles(Brennholz by woodcutters), can be used as building material(apiary, fenceless pasture, fodder barn...). each patch of grass creates 4-6 fodder-thatch (Wert 1). These are stored in a construction stockpile."; }

		{ String _name = "ClearFlower";				String _text = "Blumen Sammeln"; }
		{ String _name = "ClearFlowerLwr";			String _text = "blumen Sammeln"; }
		{ String _name = "ClearFlowerTip";			String _text = "Collect and harvest flowers spawns in the selected area. Tipps: Blumen have the miscellaneous flag. Each patch of flowers create 3-5 flowers (Wert 1). Make sure you have barns that accept miscellaneous items."; }

		{ String _name = "ClearHerb";				String _text = "Kräuter Sammeln"; }
		{ String _name = "ClearHerbLwr";			String _text = "kräuter Sammeln"; }
		{ String _name = "ClearHerbTip";			String _text = "Collect and harvest herbs spawns in the selected area. Tipps: Herbs are used at an herbalist (or bathhouse) to get back 1/2 heart per used. Each patch of herbs create 2-3 herbs (Wert 4). Herbs require barn type of storage."; }

		{ String _name = "ClearCopper";				String _text = "Collect Kupfer"; }
		{ String _name = "ClearCopperLwr";			String _text = "collect Kupfer"; }
		{ String _name = "ClearCopperTip";			String _text = "Collect all Kupfer and other rare minerals (gold and Silber) in the selected area. Tipps: Kupfer is used to make some tools and also as building materials. Kupfer and the other rare Erze are minerals. Make sure you have material stockpile available. 2-3 Kupfer Erze are extracted (Wert 4), 1-2 Silber Erze (Wert 11) or 1-2 gold Erze (Wert 22). Make sure you have minerals stockpile available to store those. "; }

		{ String _name = "ClearAlmostAll";			String _text = "Fast Alles Sammeln"; }
		{ String _name = "ClearAlmostAllLwr";			String _text = "fast Alles Sammeln"; }
		{ String _name = "ClearAlmostAllTip";			String _text = "Collect all Erze and Steine in the selected area. Tipps: This special tool will gather all Erze and all Steine. Will not remove the trees and grass and other valuable wild things. Very useful to clean up fast all the lands around Förster."; }

		{ String _name = "ClearFirewood";			String _text = "Totholz Sammeln"; }
		{ String _name = "ClearFirewoodLwr";			String _text = "totholz Sammeln"; }
		{ String _name = "ClearFirewoodTip";			String _text = "Collect all dead wood in the selected area for Brennholz. Tipps: Dead wood are dead trees fallen. Harvesting dead wood spawn will create 5-8 Brennholz per dead tree."; }

		{ String _name = "BostonHouse";				String _text = "Boston-Haus"; }
		{ String _name = "BostonHouseLwr";			String _text = "boston-Haus"; }
		{ String _name = "BostonHouseTip";			String _text = "Boston House. Every Bürger would love to live in a colorful Boston House. Grösse: 4x5 Feldern. Kosten: 54 Bauholz, 6 Stein and 30 Glas. Wohnraum: 6 Bürger. Wärmeeffizienz %: 108. Modelle: 1. Farben: 8 alternates. Tipps: Drücke F, um die Farbe zu ändern."; }

		{ String _name = "BostonHouse2";			String _text = "Boston-Haus 2"; }
		{ String _name = "BostonHouse2Lwr";			String _text = "boston-Haus 2"; }
		{ String _name = "BostonHouse2Tip";			String _text = "Boston House 2 (different textures and models). Every Bürger would love to live in a colorful Boston House. Grösse: 4x5 Feldern. Cost 54 Bauholz, 6 Stein and 30 Glas. Wohnraum: 6 Bürger. Wärmeeffizienz %: 108. Modelle: 1. Farben: 10 alternates. Tipps: Drücke F, um die Farbe zu ändern."; }

		{ String _name = "LittleHouseToolbar";			String _text = "Werkzeugleiste Buntes Kleines Haus"; }
		{ String _name = "LittleHouseToolbarLwr";		String _text = "werkzeugleiste Buntes Kleines Haus"; }
		{ String _name = "LittleHouseToolbarTip";		String _text = "Open this toolbar to get Colorful Little House options. Tipps: This is a set that contains a first floor and a special 2nd floor to go on top of the first floor for a second family. They will have 5 occupants and an Heat EFF% of 80. 12 different colors. Drücke F, um die Farbe zu ändern."; }

		{ String _name = "LittleHouse01";			String _text = "Buntes Kleines Haus"; }
		{ String _name = "LittleHouse01Lwr";			String _text = "buntes Kleines Haus"; }
		{ String _name = "LittleHouse01Tip";			String _text = "A Colorful little house dient der Unterbringung eurer Bürger. Grösse: 3x5 Feldern. Kosten: 24 Baumstämme, 6 Stein. Wohnraum: 5 Bürger. Wärmeeffizienz %: 80. Modelle: 1. Farben: 12 alternates. Tipps: Drücke F, um die Farbe zu ändern."; }

		{ String _name = "LittleHouse01floor2";			String _text = "Buntes Kleines Haus 2. Stock"; }
		{ String _name = "LittleHouse01floor2Lwr";		String _text = "buntes Kleines Haus 2. Stock"; }
		{ String _name = "LittleHouse01floor2Tip";		String _text = "A Colorful 2nd floor is used for housing a 2nd family. Grösse: 1x5 Feldern. Kosten: 32 Baumstämme, 6 Stein. Wohnraum: 6 Bürger. Wärmeeffizienz %: 90. Modelle: 1. Farben: 12 alternates. Tipps: It gös to the right next the first floor, make sure you align the chimneys in the back. it needs to perfectly fit on top of the 1st floor. Drücke F, um die Farbe zu ändern."; }


