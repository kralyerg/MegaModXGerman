		{ String _name = "CCAdamEve";			String _text = "[CC] Adam & Eva"; }
		{ String _name = "CCAdamEveDesc";		String _text = "Beginnt mit nur 2 Personen. Eine kleine Menge Nahrung, Feuerholz und Kleidung wird in einem kleinen Lagerwagen bereitgestellt. Es wurden keine Bauwerke errichtet, kein Saatgut oder Vieh ist anfangs verfugbar - ihr musst uberleben und euch alles selbst beschaffen."; }

		{ String _name = "CCMediumPlus";		String _text = "[CC] Mittel+"; }
