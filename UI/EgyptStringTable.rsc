	// ------------ New Egypt Starting Conditions ---------------------------
		{ String _name = "EgyptEasyName";		String _text = "Ägypten - Leicht"; }
		{ String _name = "EgyptEasyDesc";		String _text = "Ein Standard-Leicht-Spiel nur mit Palmen. Ein leichtes Spiel beginnt mit sechs Familien. Eine große Menge an Kleidung, Nahrung, Brennholz, Baumaterialien und Werkzeugen wird bereitgestellt. Häuser und Lagerbereiche wurden bereits gebaut. Samen für Felder und Obstgärten sowie eine Herde Nutztiere sind verfügbar."; }

		{ String _name = "EgyptMediumName";		String _text = "Ägypten - Mittel"; }
		{ String _name = "EgyptMediumDesc";		String _text = "Ein Standard-Mittel-Spiel nur mit Palmen. Ein mittelschweres Spiel beginnt mit fünf Familien. Kleidung, Nahrung, Brennholz, Werkzeuge und Baumaterialien werden bereitgestellt. Eine Lagerscheune wurde bereits gebaut. Einige Samen für Felder und Obstgärten sind verfügbar."; }

		{ String _name = "EgyptHardName";		String _text = "Ägypten - Schwer"; }
		{ String _name = "EgyptHardDesc";		String _text = "Ein Standard-Schwer-Spiel nur mit Palmen. Ein schweres Spiel beginnt mit vier Familien. Eine kleine Menge an Kleidung, Nahrung, Brennholz und Werkzeugen wird bereitgestellt. Es sind keine Samen für die Landwirtschaft verfügbar."; }

		{ String _name = "EgyptAEName";			String _text = "Ägypten - Adam & Eva"; }
		{ String _name = "EgyptAEDesc";			String _text = "Ein Standard-Adam & Eva-Spiel nur mit Palmen. Beginnt mit nur 2 Personen. Eine kleine Menge an Nahrung, Brennholz und Kleidung wird in einem kleinen Lagerwagen bereitgestellt. Es wurden keine Bauwerke errichtet, anfangs sind keine Samen oder Nutztiere verfügbar - ihr müsst überleben und euch alles selbst beschaffen."; }

	]
