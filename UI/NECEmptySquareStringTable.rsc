		{ String _name = "NECEmptyField";				String _text = "Ein Leerer Bereich"; }
		{ String _name = "NECEmptyFieldLwr";				String _text = "Ein Leerer Bereich"; }
		{ String _name = "NECEmptyFieldTip";				String _text = "Ein leerer Bereich. Dies ist ein ziehbares, unsichtbares Feld, das verhindert, dass wilde Bäume und Ressourcen wachsen. Perfekt zum Platzieren unter großen dekorativen Bereichen wie Seen und Teichen. Bannies können diesen Bereich bei Bedarf überqueren."; }

