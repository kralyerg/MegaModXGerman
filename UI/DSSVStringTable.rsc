	{ String _name = "DSSVJettyFishmongerTip";	String _text = "Der Steg-Fischhändler sortiert & reinigt Fisch, der vom Steg, von Brücken oder Angelstegen gefangen wurde. Sortierter Fisch kann einen höheren Handelswert haben, und gelegentlich wird ein zusätzlicher Fisch gefunden, was den Gesamtfang erhöht. Die Ressource Fisch wird in eine Auswahl aus Schwarzbarsch, Brasse, Karpfen, Kabeljau, Aal, Meeräsche, Flussbarsch, Hecht, Lachs, Schleie und Forelle umgewandelt."; }
	{ String _name = "DSSVJettyMolluscFarm";	String _text = "Steg-Muschelfarm"; }
	{ String _name = "DSSVJettyMolluscFarmLwr";	String _text = "steg-muschelfarm"; }
	{ String _name = "DSSVJettyMolluscFarmTip";	String _text = "Eine Steg-Muschelfarm, beschäftigt bis zu 2 Fischer, um Miesmuscheln, Klaffmuscheln und Schnecken zu züchten und zu sammeln. 4x4."; }
	{ String _name = "DSSVJettyPoultryShelter";	String _text = "Steg-Geflügelstall"; }
