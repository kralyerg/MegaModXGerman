		{ String _name = "MediumName";			String _text = "Mittel"; }
		{ String _name = "MediumDesc";			String _text = "Ein mittleres Spiel beginnt mit fünf Familien. Kleidung, 
																Nahrung, Brennholz, Werkzeuge und Baumaterialien werden bereitgestellt. Eine Lagerscheune wurde
																bereits gebaut.	Einige Saatgütersorten für Felder und Obstgärten sind verfügbar."; }

		{ String _name = "EasyName";			String _text = "Einfach"; }
		{ String _name = "EasyDesc";			String _text = "Ein einfaches Spiel beginnt mit sechs Familien. Eine große Menge an Kleidung, 
																Nahrung, Brennholz, Baumaterialien und Werkzeugen wird bereitgestellt. Häuser und Lagerflächen 
																sind bereits gebaut. Saatgut für Felder und Obstgärten ist verfügbar sowie eine Viehherde."; }

		{ String _name = "DSSVEasyCropsName";		String _text = "Einfach-Feldfrüchte [DSSV]"; }
