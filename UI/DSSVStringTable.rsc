	{ String _name = "DSSVJettyMerchant4x4FoodTip";	String _text = "Lebensmittelhändler, regulärer Handel der meisten Waren gegen alle Lebensmittel und Essbares. 18000 Kapazitätsgewicht. 4x4. Beschäftigt 1-8 Händler."; }
