{
	Entry _strings
	[
	{ String _name = "Valleys";	String _text = "Täler"; }
	{ String _name = "Mountains";	String _text = "Berge"; }
	{ String _name = "DSSVLake";	String _text = "See [DSSV]"; }
	{ String _name = "DSSVPlains";	String _text = "Ebene mit See [DSSV]"; }
	{ String _name = "DSSVPlainsNoLakes";	String _text = "Ebene ohne See [DSSV]"; }
	{ String _name = "DSSVMountainLakes";	String _text = "Bergseen [DSSV]"; }
	{ String _name = "DSSVTerrainDesc";	String _text = "[DSSV] = DS Small Village v2 - Neue Startbedingungen & Infos zu neuen Gelände-Typen:
																	See - Ein großer zentraler See mit einer kleinen Menge nutzbarem Land am Rand.
																	Ebene mit See - Eine flache Karte vom Typ 'Ebene', mit einem Fluss, und außerdem einem kleineren See.
																	Ebene ohne See -- wie oben - Eine flache Ebenenkarte, aber dieses Mal ohne Seen.
																	Bergseen - Eine schwierige, kaum bewohnbare Karte mit großen Gebirgsketten,
																	die die Landschaft dominieren, und tiefen, fjordartigen Seen."; }
	]
}

