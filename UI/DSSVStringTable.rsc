		{ String _name = "DSSVEasyFarmersName";		String _text = "Einfach-Landwirte [DSSV]"; }
		{ String _name = "DSSVEasyFarmersDesc";		String _text = "Ein einfaches Spiel mit ein paar Saatgütern für Felder und Obstgärten und möglicherweise ein oder zwei großen Viehherden. Beginnt mit sechs Familien. 1600 Nahrung, 30 Kleidung, 30 Werkzeuge, 220 Brennholz,
																	120 Holz, 50 Stein, 30 Eisen. Eine DSSV-Lagerscheune wurde bereits gebaut. KEINE HAEUSER GEBAUT."; }

		{ String _name = "DSSVEasyAnimalsName";		String _text = "Einfach-Viehzüchter [DSSV]"; }
		{ String _name = "DSSVEasyAnimalsDesc";		String _text = "Ein einfaches Spiel mit den meisten Viehsorten. Beginnt mit sechs Familien. 1600 Nahrung, 30 Kleidung, 30 Werkzeuge, 220 Brennholz,
																	120 Holz, 50 Stein, 30 Eisen. Eine DSSV-Lagerscheune wurde bereits gebaut. KEINE HAEUSER GEBAUT. Kein Saatgut."; }
		
		{ String _name = "DSSVEasyName";		String _text = "Einfach [DSSV]"; }
		{ String _name = "DSSVEasyDesc";		String _text = "Ein einfaches Spiel beginnt mit sechs Familien. 2400 Nahrung, 50 Werkzeuge, 50 Kleidung, 400 Brennholz,
																150 Holz, 70 Stein, 50 Eisen. DSSV-Häuser und Lagerflächen wurden bereits gebaut.
																Bis zu 2 Feldfrucht-Saatgütersorten und 2 Obstgarten-Saatgütersorten sind verfügbar sowie 1 Viehherde."; }
																
		{ String _name = "DSSVMediumName";		String _text = "Mittel [DSSV]"; }
		{ String _name = "DSSVMediumDesc";		String _text = "Ein mittleres Spiel beginnt mit fünf Familien. 1600 Nahrung, 30 Kleidung, 30 Werkzeuge, 220 Brennholz,
																120 Holz, 50 Stein, 30 Eisen. Eine DSSV-Lagerscheune wurde bereits gebaut.
																Bis zu 2 Feldfrucht-Saatgütersorten und 1 Obstgarten-Saatgütersorte sind verfügbar. Kein Vieh."; }
																
		{ String _name = "DSSVHardName";		String _text = "Schwerer [DSSV]"; }
