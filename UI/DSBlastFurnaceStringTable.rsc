		{ String _name = "DSCokeOven1Lwr";			String _text = "Koksofen"; }
		{ String _name = "DSCokeOven1Tip";			String _text = "Verwende den Ofen, um Kohle zu 'kochen', wobei Verunreinigungen entfernt werden, was eine heißere, stärkere Hitze in Form von Koks ermöglicht. Der Ofen erfordert 55 Arbeit zum Bau. F-Taste für Varianten."; }
		
