		{ String _name = "DSStoneBridgeMenuTip";		String _text = "DS Steinbrücke. Eine modulare Brücke, einschließlich Wohnungen, Lagerung, Produktion und Dienstleistungen."; }
		
		{ String _name = "DSNormalStoneBridgeL";		String _text = "Steinbrücke Links"; }
