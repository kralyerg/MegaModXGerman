		{ String _name = "DSNormalStoneBridgeLTip";		String _text = "Linke Seite der normalen Brückenkonstruktion, von Ufer zu Ufer platzieren. Bei nach Norden ausgerichteter Karte liegt diese Brücke links, wenn man in Nord-Süd-Richtung überquert. Bei Ost-West-Richtung liegt sie oben bzw. auf der nördlichen Seite der Brücke. Diese Brücke enthält nicht die Endrampen/Treppen, diese müssen separat gebaut werden. Erfordert 5 Arbeit pro Feld."; }
		
		{ String _name = "DSNormalStoneBridgeR";		String _text = "Steinbrücke Rechts"; }
		{ String _name = "DSNormalStoneBridgeRLwr";		String _text = "Steinbrücke rechts"; }
		{ String _name = "DSNormalStoneBridgeRTip";		String _text = "Rechte Seite der normalen Brückenkonstruktion, von Ufer zu Ufer platzieren. Bei nach Norden ausgerichteter Karte liegt diese Brücke rechts, wenn man in Nord-Süd-Richtung überquert. Bei Ost-West-Richtung liegt sie unten bzw. auf der südlichen Seite der Brücke. Diese Brücke enthält nicht die Endrampen/Treppen, diese müssen separat gebaut werden. Erfordert 5 Arbeit pro Feld."; }
		
		
