	//STARTING CONDITIONS

		{ String _name = "PalmsOnlyEasyName";		String _text = "Palmen - Leicht"; }
		{ String _name = "PalmsOnlyEasyDesc";		String _text = "Ein normales leichtes Spiel nur mit Palmen. Ein leichtes Spiel beginnt mit sechs Familien. Es werden große Mengen an Kleidung, Nahrung, Brennholz, Baumaterial und Werkzeugen bereitgestellt. Häuser und Lagerbereiche sind bereits errichtet. Saatgut für Felder und Obstgärten sowie eine Viehherde sind verfügbar."; }

		{ String _name = "PalmsOnlyMediumName";		String _text = "Palmen - Mittel"; }
		{ String _name = "PalmsOnlyMediumDesc";		String _text = "Ein normales mittleres Spiel nur mit Palmen. Ein mittleres Spiel beginnt mit fünf Familien. Kleidung, Nahrung, Brennholz, Werkzeuge und Baumaterial werden bereitgestellt. Eine Lagerscheune ist bereits errichtet. Etwas Saatgut für Felder und Obstgärten ist verfügbar."; }

		{ String _name = "PalmsOnlyHardName";		String _text = "Palmen - Schwer"; }
		{ String _name = "PalmsOnlyHardDesc";		String _text = "Ein normales schweres Spiel nur mit Palmen. Ein schweres Spiel beginnt mit vier Familien. Eine kleine Menge an Kleidung, Nahrung, Brennholz und Werkzeugen wird bereitgestellt. Kein Saatgut für die Landwirtschaft ist verfügbar."; }

		{ String _name = "PalmsOnlyAEName";		String _text = "Palmen - Adam & Eva"; }
		{ String _name = "PalmsOnlyAEDesc";		String _text = "Ein normales Adam & Eva Spiel nur mit Palmen. Beginne mit nur 2 Personen. Eine kleine Menge an Nahrung, Brennholz und Kleidung wird in einem kleinen Lagerwagen bereitgestellt. Es wurden keine Gebäude errichtet, es sind zu Beginn weder Saatgut noch Vieh verfügbar - du musst alles selbst überleben und erwerben."; }


