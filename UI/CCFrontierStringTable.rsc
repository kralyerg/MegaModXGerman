		{ String _name = "MilMagazineTip";			String _text = "Ein großes ummauertes Lagergebäude. Kann riesige Mengen an Ressourcen lagern. 60.000 Gewichtskapazität."; }
		
		{ String _name = "Forwardpost";				String _text = "Vorposten"; }
		{ String _name = "ForwardpostLwr";			String _text = "Vorposten"; }
		{ String _name = "ForwardpostTip";			String _text = "Dieser Posten repräsentiert einen der Vorstöße deiner Militärkräfte in feindliches Gebiet. Erfolgreiche Kriegsführung in dieser Epoche erfordert Gewehre und stolze bunte Uniformen, aber während du deine Feinde besiegst, wird der Posten viele nützliche Gegenstände für deine Kolonie erzeugen - einschließlich lukrativer Baumaterialien, wertvoller Artefakte oder seltener Handelsgüter, die von den Besiegten erbeutet wurden."; }
		{ String _name = "ForwardpostBoxTip";			String _text = "Erfordert: Militärversorgung. Erzeugt: Zufällige Auswahl an Wein, Spirituosen, Muskete, Kanone, Töpferwaren, Edelsteinen, Fellmantel, Einheimischem Artefakt."; }

		{ String _name = "MusketRange";				String _text = "Schießstand"; }
		{ String _name = "MusketRangeLwr";			String _text = "Schießstand"; }
		{ String _name = "MusketRangeTip";			String _text = "Hier trainieren die Soldaten deiner Kolonie, um die Besten und Bereitesten für alles zu sein, was diese Welt ihnen entgegenwirft. Während der notwendigen Übungen werden für das Überleben deiner Kolonie wichtige Ressourcen (wie Werkzeuge und Kleidung) hergestellt."; }
		{ String _name = "MusketRangeBoxTip";			String _text = "Erfordert: Pfennig. Erzeugt: Zufällige Auswahl an Stahlwerkzeug, Muskete, Uniform, Ale, Pfeifentabak."; }

