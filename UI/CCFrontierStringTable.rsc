	Entry _strings
	[ 


	// #########################################
	// ##          Starting Settings          ##
	// #########################################

		{ String _name = "CCAdamEve";			String _text = "[CC] Adam & Eva"; }
		{ String _name = "CCAdamEveDesc";		String _text = "Beginne mit nur 2 Personen. Eine kleine Menge an Nahrung, Brennholz und Kleidung wird in einem kleinen Lagerwagen bereitgestellt. Es wurden keine Gebäude errichtet, keine Saaten oder Vieh sind anfänglich verfügbar - du musst überleben und dir alles selbst beschaffen."; }
		
		{ String _name = "CCMissionary";		String _text = "[CC] Missionar"; }
		{ String _name = "CCMissionaryDesc";		String _text = "Ein Missionar-Spiel beginnt mit einem Pfarrhaus und drei Familien, 2 davon sind ungebildet. 2 Häuser sind bereits gebaut und einige grundlegende Vorräte werden bereitgestellt. Ein Lagerwagen ist verfügbar. Etwas Saatgut für Felder und Obstgärten ist ebenso verfügbar wie eine Herde Vieh."; }
		
		{ String _name = "CCFort";			String _text = "[CC] Neue Grenze"; }
		{ String _name = "CCFortDesc";			String _text = "Die Neue Grenze beginnt an einem Grenzposten neben einem freundlichen indianischen Dorf. Verteidige und pflege deine Bürger, und deine Legende wird im Westen für alle Zeit erzählt werden. Dieses Spiel beginnt mit 3 Familien, und eine kleine Festung mit einigen Vorräten wurde bereits errichtet. Beinhaltet die Möglichkeit, Schätze an einer Zeremonialstätte zu entdecken."; }

		{ String _name = "CCFortHard";			String _text = "[CC] Eingeborenendorf - Schwer"; }
		{ String _name = "CCFortHardDesc";		String _text = "Der Start im Eingeborenendorf erfordert gute Beziehungen zum einheimischen Stamm in der Gegend und ist ein ziemlich schwerer Start. Das Dorf benötigt Rohstoffe (Ausbauten), um deine Freundschaft zu signalisieren, und dann hast du die Wahl, wie du mit den Gebäuden umgehen möchtest. Als Fremde in diesem Land habt ihr viel zu lernen und zu gewinnen, wenn ihr Verbündete statt Feinde sucht."; }

		{ String _name = "CCFortAE";			String _text = "[CC] Eingeborenendorf - Adam und Eva"; }
		{ String _name = "CCFortAEDesc";		String _text = "Beginne mit nur 2 Personen. Eine kleine Menge an Nahrung, Brennholz und Kleidung wird in einem kleinen Lagerwagen bereitgestellt. Der Start im Eingeborenendorf erfordert gute Beziehungen zum einheimischen Stamm in der Gegend und ist ein ziemlich schwerer Start. Das Dorf benötigt Rohstoffe (Ausbauten), um deine Freundschaft zu signalisieren, und dann hast du die Wahl, wie du mit den Gebäuden umgehen möchtest. Als Fremde in diesem Land habt ihr viel zu lernen und zu gewinnen, wenn ihr Verbündete statt Feinde sucht."; }

		{ String _name = "LlamaEasyName";		String _text = "[CC] Der Fluch des Goldenen Lamas - Leicht"; }
		{ String _name = "LlamaEasyDesc";		String _text = "Der Fluch des Goldenen Lamas kommt einem Mysterium in der Welt von Banished am nächsten. Was ist das Goldene Lama? Welche Geheimnisse birgt es? Wagst du es, sein dunkles Inneres zu erkunden? Dies ist ein Spiel, das nach den regulären Leicht-Einstellungen beginnt, aber die Möglichkeit bietet, auf ein Abenteuer für die Chance auf Schätze zu gehen."; }

		{ String _name = "LlamaMediumName";		String _text = "[CC] Der Fluch des Goldenen Lamas - Mittel"; }
		{ String _name = "LlamaMediumDesc";		String _text = "Der Fluch des Goldenen Lamas kommt einem Mysterium in der Welt von Banished am nächsten. Was ist das Goldene Lama? Welche Geheimnisse birgt es? Wagst du es, sein dunkles Inneres zu erkunden? Dies ist ein Spiel, das nach den regulären Mittel-Einstellungen beginnt, aber die Möglichkeit bietet, auf ein Abenteuer für die Chance auf Schätze zu gehen."; }

		{ String _name = "LlamaHardName";		String _text = "[CC] Der Fluch des Goldenen Lamas - Schwer"; }
		{ String _name = "LlamaHardDesc";		String _text = "Der Fluch des Goldenen Lamas kommt einem Mysterium in der Welt von Banished am nächsten. Was ist das Goldene Lama? Welche Geheimnisse birgt es? Wagst du es, sein dunkles Inneres zu erkunden? Dies ist ein Spiel, das nach den regulären Schwer-Einstellungen beginnt, aber die Möglichkeit bietet, auf ein Abenteuer für die Chance auf Schätze zu gehen."; }

		{ String _name = "LlamaAEName";			String _text = "[CC] Der Fluch des Goldenen Lamas - Adam & Eva"; }
		{ String _name = "LlamaAEDesc";			String _text = "Der Fluch des Goldenen Lamas kommt einem Mysterium in der Welt von Banished am nächsten. Was ist das Goldene Lama? Welche Geheimnisse birgt es? Wagst du es, sein dunkles Inneres zu erkunden? Dies ist ein Spiel, das nach den Adam-und-Eva-Einstellungen beginnt, aber die Möglichkeit bietet, auf ein Abenteuer für die Chance auf Schätze zu gehen."; }


