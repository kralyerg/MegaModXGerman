		{ String _name = "Workcamp";				String _text = "Arbeitslager"; }
		{ String _name = "WorkcampLwr";				String _text = "Arbeitslager"; }
		{ String _name = "WorkcampTip";				String _text = "Das Militär ist nicht nur für Kriegsführung zuständig - der Bau und die Entwicklung der Landschaft waren immer auch eine Verantwortung der Militärkräfte in Friedenszeiten. Dieses Arbeitslager wandelt grundlegenden Sold, Werkzeuge und die Energie der ruhelosen Garnison in grundlegende Ressourcen um."; }
		{ String _name = "WorkcampBoxTip";			String _text = "Erfordert: Pfennig und Eisenwerkzeuge. Erzeugt: Zufällige Auswahl an Brennholz, Stein, Eisen, Kohle."; }
		
		{ String _name = "Stitcher";				String _text = "Uniformmacher"; }
		{ String _name = "StitcherLwr";				String _text = "Uniformmacher"; }
		{ String _name = "StitcherTip";				String _text = "Der Uniformmacher ist ein Militärspezialist, der sich auf die Herstellung stolzer Militäruniformen konzentriert. Diese Uniformen sind essentiell für die Moral der Soldaten im Kampf und ein wichtiger Bestandteil deiner militärischen Stärke. Stellt nur Uniformen her."; }
		
		{ String _name = "Quartermaster";			String _text = "Quartiermeister"; }
		{ String _name = "QuartermasterLwr";			String _text = "Quartiermeister"; }
		{ String _name = "QuartermasterTip";			String _text = "Der Quartiermeister ist das erste und wichtigste Bauwerk, das du errichten musst, wenn du eine militärische Präsenz in einem neuen Gebiet aufbaust. Wenn besetzt, werden Militärversorgungen in einem stetigen Strom von Agenten deiner Marine herangebracht."; }
		
