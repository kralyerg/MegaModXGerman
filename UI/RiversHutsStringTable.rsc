		}
		{
			String _name = "ClearWildFoodTip";
			String _text = "Sammelt und erntet Wildnahrung im ausgewählten Bereich. Tipp: Wildnahrung entsteht an Bäumen, und viel neue Nahrung entsteht an Blumen.";
		}
		{
			String _name = "ClearFodder";
			String _text = "Futter sammeln";
		}
		{
			String _name = "ClearFodderLwr";
			String _text = "futter sammeln";
		}
		{
			String _name = "ClearFodderTip";
			String _text = "Sammelt und erntet Futterstroh-Felder im ausgewählten Bereich. Tipp: Futterstroh ist das Material, das man beim Ernten von Grasflächen auf dem Boden erhält. Futter kann in Ställen verwendet, zu Brennholzbündeln (Brennholz durch Holzfäller) verarbeitet oder als Baumaterial (Bienenhaus, zaunlose Weide, Futterscheune ...) genutzt werden. Jede Grasfläche erzeugt 4-6 Futterstroh (Wert 1). Diese werden in einem Baustofflager gelagert.";
		}
		{
			String _name = "ClearFlower";
			String _text = "Blumen sammeln";
		}
		{
			String _name = "ClearFlowerLwr";
			String _text = "blumen sammeln";
		}
		{
			String _name = "ClearFlowerTip";
			String _text = "Sammelt und erntet Blumenvorkommen im ausgewählten Bereich. Tipp: Blumen gehören zur Kategorie Sonstiges. Jedes Blumenfeld erzeugt 3-5 Blumen (Wert 1). Stellen Sie sicher, dass Sie Scheunen besitzen, die sonstige Güter annehmen.";
		}
		{
			String _name = "ClearHerb";
			String _text = "Kräuter sammeln";
		}
		{
			String _name = "ClearHerbLwr";
			String _text = "kräuter sammeln";
		}
		{
			String _name = "ClearHerbTip";
			String _text = "Sammelt und erntet Kräutervorkommen im ausgewählten Bereich. Tipp: Kräuter werden bei einer Kräuterkundigen (oder einem Badehaus) verwendet, um pro Einsatz 1/2 Herz zurückzuerhalten. Jedes Kräuterfeld erzeugt 2-3 Kräuter (Wert 4). Kräuter benötigen eine Scheune als Lagerung.";
		}
		{
			String _name = "ClearCopper";
			String _text = "Kupfer und Zinn sammeln";
		}
		{
			String _name = "ClearCopperLwr";
			String _text = "kupfer sammeln";
		}
		{
			String _name = "ClearCopperTip";
			String _text = "Sammelt alles Kupfer, Zinn und andere seltene Mineralien (Gold und Silber) im ausgewählten Bereich. Tipp: Kupfer wird für die Herstellung einiger Werkzeuge sowie als Baumaterial verwendet. Kupfer und die anderen seltenen Erze sind Mineralien. Stellen Sie sicher, dass ein Materiallager vorhanden ist. Es werden 2-3 Kupfererze (Wert 4), 1-2 Silbererze (Wert 11) oder 1-2 Golderze (Wert 22) gewonnen. Stellen Sie sicher, dass ein Minerallager zur Lagerung vorhanden ist. ";
		}
		{
			String _name = "ClearAlmostAll";
			String _text = "Fast alles sammeln";
		}
		{
			String _name = "ClearAlmostAllLwr";
			String _text = "fast alles sammeln";
		}
		{
			String _name = "ClearAlmostAllTip";
			String _text = "Sammelt alle Erze und Steine im ausgewählten Bereich. Tipp: Dieses Spezialwerkzeug sammelt alle Erze und alle Steine. Bäume, Gras und andere wertvolle Wildvorkommen werden dabei nicht entfernt. Sehr nützlich, um schnell alle Flächen rund um Förster aufzuräumen.";
		}
		{
			String _name = "ClearFirewood";
			String _text = "Totholz sammeln";
		}
		{
			String _name = "ClearFirewoodLwr";
			String _text = "totholz sammeln";
		}
		{
			String _name = "ClearFirewoodTip";
			String _text = "Sammelt alles Totholz im ausgewählten Bereich für Brennholz. Tipp: Totholz sind umgefallene, abgestorbene Bäume. Das Ernten von Totholz-Vorkommen erzeugt 5-8 Brennholz pro totem Baum.";
		}
		{
