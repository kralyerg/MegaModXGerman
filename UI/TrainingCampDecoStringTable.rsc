		{ String _name = "CitationRKTrainingCamp1Tip";			String _text = "Ihr seid die Bogen, aus denen eure Kinder als lebende Pfeile ausgesandt werden. - Khalil Gibran."; }
		{ String _name = "CitationRKTrainingCamp2Tip";			String _text = "Jede Nation hat eine Flagge. - Ayman Odeh."; }
		{ String _name = "CitationRKTrainingCamp3Tip";			String _text = "Angriff ist das Geheimnis der Verteidigung; Verteidigung ist die Planung eines Angriffs. - Sun Tzu."; }
		{ String _name = "CitationRKTrainingCamp4Tip";			String _text = "Ich glaube nicht, dass es bei Architektur nur um Unterschlupf geht, nur um eine sehr einfache Umschließung. Sie sollte Sie begeistern, beruhigen und zum Nachdenken bringen können. - Zaha Hadid."; }
		{ String _name = "CitationRKTrainingCamp5Tip";			String _text = "Die Menschheit hat nur eine wirklich wirksame Waffe, und das ist das Lachen. - Mark Twain."; }
		{ String _name = "CitationRKTrainingCamp6Tip";			String _text = "Die mächtigste Waffe auf Erden ist die entflammte menschliche Seele. - Ferdinand Foch."; }
		{ String _name = "CitationRKTrainingCamp7Tip";			String _text = "Gewaltlosigkeit ist eine mächtige und gerechte Waffe. - Martin Luther King, Jr."; }
		{ String _name = "CitationRKTrainingCamp8Tip";			String _text = "Ein wohlgeordnetes Leben gleicht dem Besteigen eines Turms; der Blick auf halber Höhe ist besser als der Blick von unten, und er wird stetig schöner, je weiter sich der Horizont öffnet. - William Lyon Phelps."; }
		{ String _name = "CitationRKTrainingCamp9Tip";			String _text = "Ich kann Ihnen nicht genau zeigen, wie Gesundheitsversorgung ein Grundrecht ist. Aber ich kann argumentieren, dass niemand an einer behandelbaren Krankheit sterben sollte. - Paul Farmer."; }

