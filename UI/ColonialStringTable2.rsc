//buildings

		{ String _name = "StorageBarnStone";				String _text = "Lagerhaus"; }
		{ String _name = "StorageBarnStoneLwr";				String _text = "Lagerhaus"; }
		{ String _name = "StorageBarnStoneTip";				String _text = "Bietet eine größere Lagerkapazität für das gesamte Sortiment an Produkten und Ressourcen."; }
		
		{ String _name = "TradeWarehouse";					String _text = "Ressourcendepot"; }
		{ String _name = "TradeWarehouseLwr";				String _text = "Ressourcendepot"; }
		{ String _name = "TradeWarehouseTip";				String _text = "Anpassbarer Lagerraum für dein verfügbares Sortiment an Produkten und Ressourcen. Du musst mindestens 1 Einheit eines Produkttyps besitzen, damit dessen Lagerknopf erscheint. In diesem Gebäude gelagerte Gegenstände werden nur dann für deine Stadt freigegeben, wenn du die Anzahl manuell verringerst. Die gelagerten Gegenstände stehen den Bewohnern ohne dein Eingreifen nicht frei zur Verfügung."; }

		{ String _name = "LargeSmithy";						String _text = "Große Schmiede"; }
		{ String _name = "LargeSmithyLwr";					String _text = "Große Schmiede"; }
		{ String _name = "LargeSmithyTip";					String _text = "Eine Große Schmiede stellt fortgeschrittene Produkte her, darunter Stahlwerkzeuge und Deckenbalken, die für manche fortgeschrittenen Gebäude benötigt werden."; }

		{ String _name = "KilnBuilding";					String _text = "Meiler"; }
		{ String _name = "KilnBuildingLwr";					String _text = "Meiler"; }
		{ String _name = "KilnBuildingTip";					String _text = "Geschichtetes Holz oder Kohle wird zu Haufen gestapelt und von innen nach außen zu Brennstoff verbrannt. Eine gute Quelle für leichten Brennstoff zum Heizen von Häusern oder zur Weiterverarbeitung."; }
		
		{ String _name = "BrickBuilding";					String _text = "Ziegelei"; }
		{ String _name = "BrickBuildingLwr";				String _text = "Ziegelei"; }
		{ String _name = "BrickBuildingTip";				String _text = "Mit Hilfe eines Ofens stellt die Ziegelei heiß gebrannte, geformte Ziegel her, die für manche fortgeschrittenen Gebäude und die Ziegelstraße benötigt werden."; }
		
		{ String _name = "Abbey";							String _text = "Abtei"; }
		{ String _name = "AbbeyLwr";						String _text = "Abtei"; }
		{ String _name = "AbbeyTip";						String _text = "Eine Abtei beherbergt Mönche, die Beeren und Kräuter sammeln und Bier brauen. Die Mönche sind findig und stellen ihre Produkte aus lokalen Zutaten her, ohne Unterstützung oder Warenlieferungen zu benötigen."; }

		{ String _name = "Ropery";							String _text = "Seilerei"; }
		{ String _name = "RoperyLwr";						String _text = "Seilerei"; }
		{ String _name = "RoperyTip";						String _text = "In einer Seilerei werden Hanf und Flachs zu Seilen gebunden. Die Seilherstellung aus Hanf benötigt etwas weniger Rohstoffe als aus Flachs."; }
		
		{ String _name = "Tinyshack";						String _text = "Kleine Hütte"; }
		{ String _name = "TinyshackLwr";					String _text = "Kleine Hütte"; }
		{ String _name = "TinyshackTip";					String _text = "Eine kleine, einfache Behausung, in der neue Familien auf bis zu 3 Personen anwachsen können. Eine bestehende Familie beliebiger Größe kann jedoch einziehen, wenn sie umgesiedelt wird."; }
		
		{ String _name = "Tinyhouse";						String _text = "Kleines Haus"; }
		{ String _name = "TinyshackLwr";					String _text = "Kleines Haus"; }
		{ String _name = "TinyhouseTip";					String _text = "Eine kleine, einfache Behausung, in der neue Familien auf bis zu 4 Personen anwachsen können. Eine bestehende Familie beliebiger Größe kann jedoch einziehen, wenn sie umgesiedelt wird. Wärmer und komfortabler als eine kleine Hütte."; }
		
		{ String _name = "Townhouse";						String _text = "Große Residenz"; }
		{ String _name = "TownhouseLwr";					String _text = "Große Residenz"; }
		{ String _name = "TownhouseTip";					String _text = "Die Große Residenz kann einer Familie von 6 Personen bei hoher Wärme und Komfort Wohnraum bieten."; }
		
		{ String _name = "Townhouse2";						String _text = "Herrenhaus"; }
		{ String _name = "Townhouse2Lwr";					String _text = "Herrenhaus"; }
		{ String _name = "Townhouse2Tip";					String _text = "Das Herrenhaus kann einer Familie von 7 Personen bei hoher Wärme und Komfort Wohnraum bieten."; }
		
		{ String _name = "Townhouse3";						String _text = "Villa"; }
		{ String _name = "Townhouse3Lwr";					String _text = "Villa"; }
		{ String _name = "Townhouse3Tip";					String _text = "Die Villa kann einer Familie von 8 Personen bei hoher Wärme und Komfort Wohnraum bieten."; }
		
		{ String _name = "Townhouse4";						String _text = "Anwesen"; }
		{ String _name = "Townhouse4Lwr";					String _text = "Anwesen"; }
		{ String _name = "Townhouse4Tip";					String _text = "Das Anwesen ist ein Elitegebäude und kann einer Familie von 8 Personen bei größter Wärme und größtem Komfort Wohnraum bieten."; }

		{ String _name = "SmalltownhouseA";					String _text = "Stadtwohnung"; }
		{ String _name = "SmalltownhouseALwr";				String _text = "Stadtwohnung"; }
		{ String _name = "SmalltownhouseATip";				String _text = "Eine Stadtwohnung ist ein Zuhause, das neuen Familien mit bis zu 4 Personen Platz bietet. Eine bestehende Familie beliebiger Größe kann jedoch einziehen, wenn sie umgesiedelt wird."; }
		
		{ String _name = "Smalltownhouse";					String _text = "Stadthaus"; }
		{ String _name = "SmalltownhouseLwr";				String _text = "Stadthaus"; }
		{ String _name = "SmalltownhouseTip";				String _text = "Ein Stadthaus ist ein warmes und komfortables Zuhause für eine Familie von 5 Personen."; }
		
		{ String _name = "SmalltownhouseC";					String _text = "Schönes Stadthaus"; }
		{ String _name = "SmalltownhouseCLwr";				String _text = "Schönes Stadthaus"; }
		{ String _name = "SmalltownhouseCTip";				String _text = "Ein Schönes Stadthaus ist ein noch wärmeres und komfortableres Zuhause für eine Familie von 6 Personen."; }
		
		{ String _name = "SmalltownhouseD";					String _text = "Prächtiges Stadthaus"; }
		{ String _name = "SmalltownhouseDLwr";				String _text = "Prächtiges Stadthaus"; }
		{ String _name = "SmalltownhouseDTip";				String _text = "Ein Prächtiges Stadthaus ist das wärmste und komfortabelste Zuhause für eine Familie von 6 Personen."; }

		{ String _name = "Twarehouse";						String _text = "Trockenlager"; }
		{ String _name = "TwarehouseLwr";					String _text = "Trockenlager"; }
		{ String _name = "TwarehouseTip";					String _text = "Das Trockenlager lagert Textilien wie Baumwolle, Flachs, Leder, Wolle, Stoff, Leinen und Tabakblatt."; }		

		{ String _name = "Oilpress";						String _text = "Ölpresse"; }
		{ String _name = "OilpressLwr";						String _text = "Ölpresse"; }
		{ String _name = "OilpressTip";						String _text = "Eine Ölpresse gewinnt Öl aus Oliven sowie geernteten Sonnenblumen-, Flachs- und Baumwollsamen und Walspeck."; }

		{ String _name = "Weavers";							String _text = "Weberei"; }
		{ String _name = "WeaversLwr";						String _text = "Weberei"; }
		{ String _name = "WeaversTip";						String _text = "Ein Weber stellt Leinen, Stoff und Seide aus Flachs, Baumwolle und Seidenraupenkokons her."; }

		{ String _name = "Clothier";						String _text = "Kleidermacher"; }
		{ String _name = "ClothierLwr";						String _text = "Kleidermacher"; }
		{ String _name = "ClothierTip";						String _text = "Ein Kleidermacher ist ein aufgewerteter Schneider, der hochwertigere Kleidung herstellt, die wärmer und von größerem Handelswert ist."; }

		{ String _name = "Silkwormhut";					String _text = "Seidenraupenhütte"; }
		{ String _name = "SilkwormhutLwr";				String _text = "Seidenraupenhütte"; }
		{ String _name = "SilkwormhutTip";				String _text = "Eine Seidenraupenhütte zieht Seidenraupen zur Seidengewinnung und, als letzten Ausweg, als Nahrung auf. Seidenraupen benötigen weiße Maulbeerblätter als Futter. Diese können gehandelt werden oder aus einem Obstgarten stammen."; }

		{ String _name = "Tobaccobarn";					String _text = "Tabakscheune"; }
		{ String _name = "TobaccobarnLwr";				String _text = "Tabakscheune"; }
		{ String _name = "TobaccobarnTip";				String _text = "Hier wird Tabak luftgetrocknet zu Pfeifentabak zum Rauchen. Fertige Produkte müssen in einem Wirtshaus-und-Garten-Gebäude gelagert werden."; }

		{ String _name = "CCStatue1";					String _text = "Kolonie-Statue"; }
		{ String _name = "CCStatue1Lwr";				String _text = "Kolonie-Statue"; }
		{ String _name = "CCStatue1Tip";				String _text = "Eine Statue, die den Gouverneur der Kolonie darstellt."; }
		{ String _name = "Quote1";						String _text = "Es könnte sein, dass der Sinn deines Lebens nur darin besteht, anderen als Warnung zu dienen."; }

		{ String _name = "CCStatue2";					String _text = "Kolonie-Statue"; }
		{ String _name = "CCStatue2Lwr";				String _text = "Kolonie-Statue"; }
		{ String _name = "CCStatue2Tip";				String _text = "Eine Statue, die den Gouverneur der Kolonie auf einem Lama reitend darstellt."; }
		{ String _name = "Quote2";						String _text = "Das dunkelste Geheimnis dieser Kolonie ist, dass sich zu viele ihrer Bürger noch immer einbilden, sie gehörten anderswo einer weit höheren Zivilisation an."; }
		
		{ String _name = "Roadtriangle";				String _text = "Steinplatz-Dreieck"; }
		{ String _name = "RoadtriangleLwr";				String _text = "Steinplatz-Dreieck"; }
		{ String _name = "RoadtriangleTip";				String _text = "Zum Einebnen und Verschönern von Flächen mit ansprechenden Plätzen; Dreiecksstücke passen gut in die Ecken."; }
		
		{ String _name = "Roadstraight";				String _text = "Steinplatz Gerade"; }
		{ String _name = "RoadstraightLwr";				String _text = "Steinplatz Gerade"; }
		{ String _name = "RoadstraightTip";				String _text = "Zum Einebnen und Verschönern von Flächen mit ansprechenden Plätzen."; }

		{ String _name = "CorduroyRoad";				String _text = "Knüppeldamm"; }
		{ String _name = "CorduroyRoadLwr";				String _text = "Knüppeldamm"; }
		{ String _name = "CorduroyRoadTip";				String _text = "Straße aus Holz."; }

		{ String _name = "BackAlley";					String _text = "Hintergasse"; }
		{ String _name = "BackAlleyLwr";				String _text = "Hintergasse"; }
		{ String _name = "BackAlleyTip";				String _text = "Eine Hintergasse, in der Geschäfte gemacht und gewisse Bedürfnisse befriedigt werden. Bietet alle Arten von geschmuggelten Waren."; }

		{ String _name = "Winery";						String _text = "Weinkellerei"; }
		{ String _name = "WineryLwr";					String _text = "Weinkellerei"; }
		{ String _name = "WineryTip";					String _text = "Eine Weinkellerei stellt Wein aus Weintrauben und anderen Früchten her. Der hergestellte Wein muss in einem Wirtshaus-und-Garten-Gebäude gelagert werden."; }

		{ String _name = "Apiary";						String _text = "Bienenhaus"; }
		{ String _name = "ApiaryLwr";					String _text = "Bienenhaus"; }
		{ String _name = "ApiaryTip";					String _text = "Ein Bienenhaus produziert Honig als Nahrungsmittel oder Bienenwachs, das in einer Kerzenmacherei zu Kerzen verarbeitet werden kann."; }

		{ String _name = "Bankbarn";					String _text = "Hangscheune"; }
		{ String _name = "BankbarnLwr";					String _text = "Hangscheune"; }
		{ String _name = "BankbarnTip";					String _text = "Eine Hangscheune ist ein extra großes Lagergebäude, das in einen Hang gebaut werden muss."; }

		{ String _name = "Outhouse";					String _text = "Aborthäuschen"; }
		{ String _name = "OuthouseLwr";					String _text = "Aborthäuschen"; }
		{ String _name = "OuthouseTip";					String _text = "Ein kleines Nebengebäude, in dem koloniale Herrschaften wie Damen gleichermaßen ihr wichtiges Geschäft verrichten."; }

		{ String _name = "GrainSilo";					String _text = "Kornspeicher"; }
		{ String _name = "GrainSiloLwr";				String _text = "Kornspeicher"; }
		{ String _name = "GrainSiloTip";				String _text = "Ein Kornspeicher lagert Getreide und Produkte, die Getreide enthalten."; }

		{ String _name = "RootCellar";					String _text = "Wurzelkeller"; }
