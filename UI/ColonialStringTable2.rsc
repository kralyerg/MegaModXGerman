		{ String _name = "CCcustom1Name";					String _text = "Colonial Charter"; }
		{ String _name = "CCcustom1Desc";					String _text = "Colonial Charter Beschreibung kommt hierher"; }

		{ String _name = "CCAdamEve";						String _text = "[CC] Adam & Eva"; }
		{ String _name = "CCAdamEveDesc";					String _text = "Beginne mit nur 2 Personen. Eine kleine Menge Nahrung, Brennholz und Kleidung wird in einem kleinen Lagerkarren bereitgestellt. Keine Gebäude wurden errichtet, keine Werkzeuge, Samen oder Nutztiere sind anfangs verfügbar - du musst überleben und dir alles selbst beschaffen."; }

		{ String _name = "CCSilkRoad";						String _text = "[CC] Seidenstraße - Leicht"; }
		{ String _name = "CCSilkRoadDesc";					String _text = "Beginne mit der Fähigkeit, Seidenraupen für ihre kostbare Seide zu füttern und zu ernten. Startet mit sechs Familien. Eine große Menge an Kleidung, Nahrung, Brennholz, Baumaterialien und Werkzeugen wird bereitgestellt. Häuser und Lagerbereiche wurden bereits errichtet."; }
		
		{ String _name = "CCSilkRoadMed";					String _text = "[CC] Seidenstraße - Mittel"; }
		{ String _name = "CCSilkRoadMedDesc";					String _text = "Beginne mit der Fähigkeit, Seidenraupen für ihre kostbare Seide zu füttern und zu ernten. Startet mit fünf Familien. Kleidung, Nahrung, Brennholz, Werkzeuge und Baumaterialien werden bereitgestellt. Eine Lagerscheune wurde bereits errichtet."; }
		
		{ String _name = "CCMine";							String _text = "[CC] Mine"; }
		{ String _name = "CCMineDesc";						String _text = "Einzigartiger Bergbau für wertvolle Gegenstände."; }

		{ String _name = "CCMediumPlus";					String _text = "[CC] Mittel+"; }
		{ String _name = "CCMediumPlusDesc";					String _text = "Fügt Nutztiere hinzu. Ein Mittel+ Spiel beginnt mit fünf Familien. Kleidung, Nahrung, Brennholz, Werkzeuge und Baumaterialien werden bereitgestellt. Eine Lagerscheune wurde bereits errichtet. Einige Samen für Felder und Obstgärten sind ebenso verfügbar wie eine Herde Nutztiere."; }
		
		{ String _name = "CCMissionary";					String _text = "[CC] Missionar"; }
		{ String _name = "CCMissionaryDesc";					String _text = "Ein Missionar-Spiel beginnt mit einem Gemeindehaus und drei Familien, 2 davon ungebildet. 2 Häuser sind bereits gebaut und einige Grundversorgungen werden bereitgestellt. Ein Lagerkarren ist verfügbar. Einige Samen für Felder und Obstgärten sind ebenso verfügbar wie eine Herde Nutztiere."; }

