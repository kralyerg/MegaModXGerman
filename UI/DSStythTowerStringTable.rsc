StringTable resource
{
	Entry _strings
	[ 
		{ String _name = "DSStythTowerMenuTip";			String _text = "Styth-Türme - Wachttürme für Ihre Stadt. Wenn besetzt, erzeugen sie eine zufällige Auswahl an Gütern durch Beschlagnahmung gestohlener Objekte von, wie wir nur annehmen können, Banditen? oder Außerirdischen...."; }
	
		{ String _name = "DSStythTower";					String _text = "Styth-Turm"; }
		{ String _name = "DSStythTowerLwr";					String _text = "Styth-Turm"; }
		{ String _name = "DSStythTowerTip";					String _text = "Styth-Turm, der ursprüngliche Styth-Wachturm, der eine kleine zufällige Anzahl an Objekten für die Stadt erzeugt (Alkohol, Werkzeuge, Kleidung, Nahrung, usw.), indem er das Gebiet von Banditen befreit; die Stadt erhält die Beute. Bietet Arbeit für 1-2 Dorfwächter. Sie können nur 1 Styth-Turm pro Karte bauen."; }
		
		{ String _name = "DSNewStythTower";					String _text = "Neuer Styth-Turm"; }
		{ String _name = "DSNewStythTowerLwr";				String _text = "neuer Styth-Turm"; }
		{ String _name = "DSNewStythTowerTip";				String _text = "Neuer Styth-Turm, eine aktualisierte Version des Styth-Turms, etwas größer, dieser Wachturm erzeugt eine größere Anzahl an zufälligen Objekten für die Stadt (Alkohol, Werkzeuge, Kleidung, Nahrung, Kostbarkeiten, usw.), indem er das Gebiet von Banditen befreit; die Stadt erhält die Beute. Bietet Arbeit für 2-3 Dorfwächter. Sie können nur 1 Neuen Styth-Turm pro Karte bauen."; }
		
		{ String _name = "ProfessionVillageGuard";			String _text = "Dorfwächter"; }
		{ String _name = "ProfessionVillageGuardTip";		String _text = "Ein Dorfwächter dient der Stadt und beschützt sie. Sie sind an Wachttürmen beschäftigt. Es ist bekannt, dass ihre Sterblichkeitsrate höher ist als bei anderen Berufen."; }
		{ String _name = "ProfessionVillageGuardDeath";		String _text = "starb an schweren Wunden, nachdem er die Stadt vor Banditen beschützt hatte."; }
		
		
		{ String _name = "Gold";			String _text = "Gold"; }
