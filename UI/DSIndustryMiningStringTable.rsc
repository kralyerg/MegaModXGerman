		}
		{
			String _name = "DSCokeOven1LimeTip";
			String _text = "Der Kalkofen verarbeitet Stein zu Kalk (auch als Branntkalk bekannt). Kalk kann bei der Eisenherstellung verwendet werden und dient auch als Baumaterial (Mörtel & Putz). Erfordert 55 Arbeit zum Bauen.";
		}
