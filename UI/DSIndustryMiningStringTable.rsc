		}
		{
			String _name = "DSThaddSurrelTinsmithTip";
			String _text = "Der Thadd Surrel & Familie Klempner stellt Blechwaren her. Erfordert 89 Arbeit zum Bauen.";
		}
		{
			String _name = "DSIndustryWoodChopper";
			String _text = "Holzhacker";
		}
		{
			String _name = "DSIndustryWoodChopperLwr";
			String _text = "holzhacker";
		}
		{
			String _name = "DSIndustryWoodChopperTip";
			String _text = "1 Holzfäller wird beschäftigt, um Baumstämme oder Bauholz zu Brennholz zu schneiden. Erfordert 8 Arbeit zum Bauen.";
		}
		{
			String _name = "DSThaddSurrelLumbermill";
			String _text = "Thadd Surrel & Familie: Sägewerk";
		}
		{
			String _name = "DSThaddSurrelLumbermillLwr";
			String _text = "industriesägewerk";
		}
		{
			String _name = "DSThaddSurrelLumbermillTip";
			String _text = "Das Thadd Surrel & Familie Sägewerk, 1-5 Holzfäller betreiben das Sägewerk und verarbeiten Baumstämme zu Bauholz oder Brennholz. Erfordert 144 Arbeit zum Bauen.";
		}
		{
			String _name = "DSWaterPowerFurnace";
			String _text = "Wasserbetriebener Hochofen";
		}
		{
			String _name = "DSWaterPowerFurnaceLwr";
			String _text = "hochofen";
		}
		{
			String _name = "DSWaterPowerFurnaceTip";
			String _text = "Muss neben einem Bach oder Fluss gebaut werden; mit hohen Temperaturen und starkem Luftstrom ist dieser Hochofen die perfekte Ergänzung für eine Industriesiedlung. Wasserkraft betreibt große Blasebälge, die Luft in den Ofen pressen. Er kann große Mengen an Eisenerz zu Eisen, Kupfererz zu Kupfer, Zinnerz zu Zinn oder Kupfer- und Zinnerz zu Bronze verarbeiten, mithilfe eines metallurgischen Brennstoffs (Koks oder Holzkohle). Beschäftigt 1-8 Schmiede. Der Bau erfordert 233 Arbeit.";
		}
		{
			String _name = "DSBlastFurnace";
			String _text = "Thadd Surrel & Familie: Hochofen";
		}
		{
			String _name = "DSBlastFurnaceLwr";
			String _text = "hochofen";
		}
		{
			String _name = "DSBlastFurnaceTip";
			String _text = "Kann auf ebenem Boden gebaut werden; dieser Hochofen erreicht die hohen Temperaturen durch eine Kupferkessel-Dampfmaschine, die die Blasebälge betreibt. Dieser Ofen ist die perfekte Ergänzung für eine Industriesiedlung. Er kann große Mengen an Eisenerz zu Eisen, Kupfererz zu Kupfer, Zinnerz zu Zinn oder Kupfer- und Zinnerz zu Bronze verarbeiten, mithilfe eines metallurgischen Brennstoffs (Koks oder Holzkohle). Beschäftigt 1-6 Schmiede. Der Bau erfordert 233 Arbeit. F-Tasten-Varianten.";
		}
		{
			String _name = "DSHillLimeKiln";
			String _text = "Hügel-Kalkofen";
		}
		{
			String _name = "DSHillLimeKilnLwr";
			String _text = "hügel-kalkofen";
		}
		{
