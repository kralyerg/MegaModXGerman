		{
			String _name = "DSThaddSurrelFlaxFarmer";
			String _text = "Thadd Surrel & Familie Industrie-Flachsfarm - ein Pflanzgebäude zum Säen der Samen und Pflegen der Pflanzen, sowie ein Erntegebäude für die Flachsernte.";
