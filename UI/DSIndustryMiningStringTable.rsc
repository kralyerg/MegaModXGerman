			String _text = "Füge eine kurze Endrampe an die Batterieöfen an, um einen einfacheren Zugang zur Ofenoberseite zu ermöglichen. Erfordert 5 Arbeit zum Bauen.";
		}
		{
			String _name = "DSWorkersConstructionYard";
			String _text = "Bauhof der Arbeiter";
		}
		{
			String _name = "DSWorkersConstructionYardLwr";
			String _text = "bauhof der arbeiter";
		}
		{
			String _name = "DSWorkersConstructionYardTip";
			String _text = "Ideal für das frühe Spiel, um viele der benötigten Baumaterialien zur Erweiterung deines Dorfes herzustellen. Stellt entweder Bauholz, Eisenbeschläge, Ziegelsteine, Dachziegel, Kalk oder Glas her. Stelle sicher, dass du über einen Vorrat der benötigten Baumstämme, Eisen, Holzkohle, Stein, Ton und Sand verfügst. Erfordert 34 Arbeit zum Bauen. Nur 2 können auf einer Karte gebaut werden.";
		}
		{
			String _name = "DSBlacksmith01";
			String _text = "Schmied";
		}
		{
			String _name = "DSBlacksmith01Lwr";
			String _text = "schmied";
		}
		{
			String _name = "DSBlacksmith01Tip";
			String _text = "Dieser Schmied kann Werkzeuge, Eisenbeschläge, Ambosse und Wagenteile herstellen. Zum Betrieb wird ein metallurgischer Brennstoff benötigt. Erfordert 89 Arbeit zum Bauen.";
		}
		{
			String _name = "DSThaddSurrelBlacksmith";
