		{
			String _name = "DSThaddSurrelFlaxFarmerHarvesterTip";
			String _text = "Thadd Surrel & Familie Flachsfarm-Ernter, 1-3 Bauern ernten Flachs. Erfordert 21 Arbeit zum Bauen.";
		}
		{
			String _name = "DSThaddSurrelPressShed";
			String _text = "Thadd Surrel & Familie: Presshütte";
		}
		{
			String _name = "DSThaddSurrelPressShedLwr";
			String _text = "presshütte";
		}
		{
			String _name = "DSThaddSurrelPressShedTip";
			String _text = "Thadd Surrel & Familie Presshütte, in der ein Arbeiter entweder Lampenöl oder ein essbares Samenöl aus Mandeln, Kastanien, Haselnüssen, Pekannüssen oder Walnüssen herstellt. Erfordert 34 Arbeit zum Bauen.";
		}
		{
			String _name = "DSCoalBellPit1";
			String _text = "Kohleglockengrube";
		}
		{
			String _name = "DSCoalBellPit1Lwr";
			String _text = "kohleglockengrube";
		}
		{
			String _name = "DSCoalBellPit1Tip";
			String _text = "Eine primitive Kohlemine, auf ebenem Boden gebaut, benötigt 3-8 Bergleute, die nur Kohle aus einer glockenförmigen Grube im Boden fördern. Sie hat eine begrenzte Förderung von 600 und muss nach Erschöpfung ausgebaut werden, um weiterzuarbeiten. Erfordert 34 Arbeit zum Bauen.";
		}
		{
			String _name = "DSCoalBellPit1Upgrade";
			String _text = "Kohleglockengrubenmine";
		}
		{
			String _name = "DSCoalBellPit1UpgradeLwr";
			String _text = "kohleglockengrubenmine";
		}
		{
			String _name = "DSCoalBellPit1UpgradeTip";
			String _text = "Baue die Glockengrube aus, um eine weitere Förderung von 5.400 zu ermöglichen, sowie eine etwas schnellere Kohleförderung durch ein Flaschenzugsystem, das den Bergleuten hilft (bis zu 13 Bergleute). Erfordert 89 Arbeit zum Ausbauen.";
		}
		{
			String _name = "DSSmallIronOreMine";
			String _text = "Kleine Eisenerzmine";
		}
		{
			String _name = "DSSmallIronOreMineLwr";
			String _text = "kleine eisenerzmine";
		}
		{
			String _name = "DSSmallIronOreMineTip";
			String _text = "Eine kleine Bergmine, die 1-13 Bergleute beschäftigt, die nur Eisenerz fördern. Sie hat eine begrenzte Förderung von 1.200, kann aber ausgebaut werden, um weiterzuarbeiten. Erfordert 21 Arbeit zum Bau des Mineneingangs. Eine günstige Mine, doch für maximale Förderung muss die Mine an einer idealen Stelle platziert werden *die Platzierung der Mine kann schwierig sein, bleib dran.";
		}
		{
			String _name = "DSSmallIronOreMineUpgradeOilLamps";
			String _text = "Eisenerzmine";
		}
		{
			String _name = "DSSmallIronOreMineUpgradeOilLampsLwr";
			String _text = "eisenerzmine";
		}
		{
			String _name = "DSSmallIronOreMineUpgradeOilLampsTip";
			String _text = "Baue aus, um eine längere Lebensdauer von 24.800 zu ermöglichen, sowie eine etwas schnellere Eisenerzförderung mit bis zu 21 beschäftigten Bergleuten. Erfordert 89 Arbeit zum Ausbauen";
		}
		{
			String _name = "ImprovedMine";
			String _text = "Verbesserte Mine";
		}
		{
			String _name = "ImprovedMineLwr";
			String _text = "verbesserte mine";
		}
		{
			String _name = "ImprovedMineTip";
			String _text = "Das Modell der Verbesserten Mine, entstanden in Zusammenarbeit mit Yandersen. Dies ist eine Bergmine, die 1-30 Bergleute beschäftigt, die entweder Eisenerz, Kupfererz oder Kohle fördern. Sie hat eine begrenzte Förderung von 21.000. Erfordert 144 Arbeit zum Bauen.";
		}
		{
			String _name = "DSThaddSurrelMineOilLamps";
			String _text = "Thadd Surrel & Familie: Industriemine";
		}
		{
			String _name = "DSThaddSurrelMineOilLampsLwr";
			String _text = "industriemine";
		}
		{
			String _name = "DSThaddSurrelMineOilLampsTip";
			String _text = "Die industrielle Thadd Surrel & Familie Mine. Fähig, Eisenerz, Kupfererz, Zinnerz oder Kohle zu fördern, benötigt Bauholz sowie Lampenöl oder Kerzen zum Betrieb. Beschäftigt 1-55 Bergleute. Die Mine hat über ihre Lebensdauer eine große Förderung von 250.000. Erfordert 233 Arbeit zum Bauen.";
		}
		{
			String _name = "DSIndustryMineSecond";
			String _text = "Thadd Surrel & Familie: 2. Industriemine";
		}
		{
			String _name = "DSIndustryMineSecondLwr";
			String _text = "zweite industriemine";
		}
		{
			String _name = "DSIndustryMineSecondTip";
			String _text = "Die große, zweite industrielle Thadd Surrel & Familie Mine. Fähig, Eisenerz, Kupfererz, Zinnerz oder Kohle zu fördern, benötigt Bauholz sowie Lampenöl oder Kerzen zum Betrieb. Beschäftigt 1-72 Bergleute. Die Mine hat über ihre Lebensdauer eine nahezu lebenslange Förderung von 5.000.000. Erfordert 512 Arbeit zum Bauen.";
		}
		{
			String _name = "DSClarenceSilverMine01";
			String _text = "Clarence-Silbermine, 1. Stern";
		}
		{
			String _name = "DSClarenceSilverMine01Lwr";
			String _text = "clarence-silbermine";
		}
		{
			String _name = "DSClarenceSilverMine01Tip";
			String _text = "Die Clarence-Silbermine, eine große Silbererzmine, zunächst auf Stufe 1. Stern gebaut, beschäftigt die Mine 1-8 Bergleute und benötigt Bauholz sowie 2 Lampenöl zum Betrieb. Die Mine hat eine begrenzte Förderung, bevor sie ausgebaut werden muss, um weiter Silbererz zu fördern. Erfordert 89 Arbeit zum Bauen.";
		}
		{
			String _name = "DSClarenceSilverMine02";
			String _text = "Clarence-Silbermine, 2. Stern";
		}
		{
			String _name = "DSClarenceSilverMine02Lwr";
			String _text = "clarence-silbermine";
		}
		{
			String _name = "DSClarenceSilverMine02Tip";
			String _text = "Baue die Mine aus, indem der hintere Sortierraum erweitert wird, um Platz für eine größere Mineneingangsöffnung zu schaffen. Die bestehenden Tunnel werden verstärkt, um eine etwas größere Belegschaft von 13 Bergleuten zu bewältigen. Die ausgebaute Mine hat eine Gesamtförderung von 610, bevor ein weiterer Ausbau nötig ist. Erfordert 144 Arbeit zum Bauen.";
		}
		{
			String _name = "DSClarenceSilverMine03";
			String _text = "Clarence-Silbermine, 3. Stern";
		}
		{
			String _name = "DSClarenceSilverMine03Lwr";
			String _text = "clarence-silbermine";
		}
		{
			String _name = "DSClarenceSilverMine03Tip";
			String _text = "Durch den Ausbau der Mine fügst du ein großes oberirdisches Flaschenzugsystem hinzu, das eine tiefere Mine und eine schnellere Förderung ermöglicht, da die Flaschenzüge den Transport der schweren Erze an die Oberfläche erleichtern. Die Mine kann bis zu 21 Bergleute beschäftigen. Die ausgebaute Mine hat eine Gesamtförderung von 1.597, bevor ein weiterer Ausbau nötig ist. Erfordert 233 Arbeit zum Bauen.";
		}
		{
			String _name = "DSClarenceSilverMine04";
			String _text = "Clarence-Silbermine, 4. Stern";
		}
		{
			String _name = "DSClarenceSilverMine04Lwr";
			String _text = "clarence-silbermine";
		}
		{
			String _name = "DSClarenceSilverMine04Tip";
			String _text = "Baue aus und verbessere das Flaschenzugsystem durch einen weiteren Flaschenzug weiter! Wieder schnellere Förderung, und nun kann die Mine bis zu 34 Bergleute beschäftigen. Doch das ist nicht alles: die Minenbeleuchtung wird verbessert, der Förderertrag steigt, da Bergleute nun nur noch 1 Lampenöl benötigen. Die ausgebaute Mine hat eine Gesamtförderung von 4.181, bevor ein weiterer Ausbau nötig ist. Erfordert 377 Arbeit zum Bauen.";
		}
		{
			String _name = "DSClarenceSilverMine05";
			String _text = "Clarence-Silbermine, 5. Stern";
		}
		{
			String _name = "DSClarenceSilverMine05Lwr";
			String _text = "clarence-silbermine";
		}
		{
			String _name = "DSClarenceSilverMine05Tip";
			String _text = "Durch den Ausbau der Mine ermöglicht die Installation von Gleisen den Einsatz schnellerer Loren, was die Förderrate erhöht. Dies ist die letzte Tiefe der Mine, nach der sie vollständig von Silbererz erschöpft sein wird. Sie hat eine Gesamtkapazität von 10.946. Erfordert 610 Arbeit zum Bauen.";
		}
		{
			String _name = "UpgradeClarenceSilverMine01Txt";
			String _text = "baue die Mine nach Erschöpfung aus:";
		}
		{
			String _name = "DSPlacerMine01";
			String _text = "Seifenmine";
		}
		{
			String _name = "DSPlacerMine01Lwr";
			String _text = "seifenmine";
		}
		{
			String _name = "DSPlacerMine01Tip";
			String _text = "Eine Seifenmine fördert Zinnerz und Gold aus einer Böschung an einem Wasserlauf. Beschäftigt 1-4 Bergleute. Die Mine hat über ihre Lebensdauer eine langfristige Förderung von 13.000. Erfordert 84 Arbeit zum Bauen.";
		}
		{
			String _name = "DSIndustrialQuarry";
			String _text = "Industrieller Steinbruch";
		}
		{
			String _name = "DSIndustrialQuarryLwr";
			String _text = "industrieller steinbruch";
		}
		{
			String _name = "DSIndustrialQuarryTip";
			String _text = "Ein industriell großer Steinbruch zur Gewinnung und Verarbeitung von Stein. Die Produktion benötigt Werkzeuge für Steinmetze (Werkzeuge:Steinmetz) zum Betrieb, die bei einem Schmied hergestellt werden können. Beschäftigt 1-34 Steinmetze. Der Steinbruch hat über seine Lebensdauer eine große Förderung von 200.000. Erfordert 144 Arbeit zum Bauen.";
		}
		{
			String _name = "DSCokeOvenMenuTip";
			String _text = "Batterie-Koks- & Kalköfen. Modularer Bau, verarbeitet Kohle zu Koks oder Stein zu Kalk.";
		}
