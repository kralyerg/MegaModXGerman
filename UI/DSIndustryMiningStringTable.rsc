		}
		{
			String _name = "DSCokeOven1Tip";
			String _text = "Nutze den Ofen, um Kohle zu 'kochen', wodurch Verunreinigungen entfernt werden und eine heißere, stärkere Hitze in Form von Koks entsteht. Erfordert 55 Arbeit zum Bauen. F-Tasten-Varianten.";
