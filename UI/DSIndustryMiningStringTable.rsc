		}
		{
			String _name = "DSThaddSurrelFlaxFarmerPlanterTip";
			String _text = "Thadd Surrel & Familie Flachsfarm-Pflanzer, benötigt Leinsamen zum Bau, 1-3 Bauern pflanzen und ziehen Flachs. Erfordert 34 Arbeit zum Bauen.";
