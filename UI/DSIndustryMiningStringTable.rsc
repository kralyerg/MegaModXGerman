StringTable startConditions
{
	Entry _strings
	[
		{
			String _name = "Easy0Name";
			String _text = "Industrie: Werkzeuge";
		}
		{
			String _name = "Easy0Desc";
			String _text = "Ein leichtes Spiel, beginnt mit fünf Familien und Häusern. Eine große Menge an Kleidung, Nahrung, Brennholz, Holzkohle, Werkzeugen, Holzstämmen, Eisen und Stein wird bereitgestellt. Die Thadd Surrel Lagerscheunen wurden bereits gebaut, ebenso der Thadd Surrel Schmied sowie die Schmiedeesse und der Schleifstein. Einige Samen für Felder und Obstgärten sind ebenso verfügbar wie eine Herde Vieh.";
		}
		{
			String _name = "Easy2Name";
			String _text = "Industrie: Flachs, Leinen & Lampenöl";
		}
		{
			String _name = "Easy2Desc";
			String _text = "Ein leichtes Spiel, beginnt mit fünf Familien und Häusern. Eine große Menge an Kleidung, Nahrung, Brennholz, Holzkohle, Werkzeugen, Holzstämmen, Eisen und Stein wird bereitgestellt. Die Thadd Surrel Lagerscheunen wurden bereits gebaut, ebenso der Thadd Surrel Flachsweber, Ölbrennofen und der Presseschuppen. Flachssamen für das Feld und ein Obstgarten-Samen sind ebenso verfügbar wie eine Herde Vieh.";
		}
		{
			String _name = "Medium0Name";
			String _text = "Industrie: Thadd Surrel Lagerung";
		}
		{
			String _name = "Medium0Desc";
			String _text = "Ein mittleres Spiel, beginnt mit fünf Familien. Kleidung, Nahrung, Brennholz, Werkzeuge sowie einige Holzstämme, Eisen und Stein werden bereitgestellt. Die Thadd Surrel Lagerscheunen wurden bereits gebaut. Einige Samen für Felder und Obstgärten sind verfügbar.";
		}
		{
			String _name = "Hard0Name";
			String _text = "Industrie: Köhler";
		}
		{
			String _name = "Hard0Desc";
			String _text = "Ein schweres Spiel, beginnt mit vier Familien. Etwas Kleidung, Nahrung, Werkzeuge, Stein und eine große Menge an Holzstämmen werden bereitgestellt. Sie haben einige Lagerfässer und Kisten, die Ihre Güter aufnehmen, sowie zwei bereits gebaute Kohlenmeiler.";
		}
		{
			String _name = "Hard1Name";
			String _text = "Industrie: Erzschmelzer";
		}
		{
			String _name = "Hard1Desc";
			String _text = "Ein schweres Spiel, beginnt mit vier Familien. Etwas Kleidung, Nahrung, Werkzeuge, Stein, Holzkohle und Holzstämme werden bereitgestellt. Sie haben einige Lagerfässer und Kisten, die Ihre Güter aufnehmen, sowie zwei bereits gebaute Rennfeueröfen (Kupfer & Eisen) und einen kleinen Kohlenmeiler.";
		}
	]

}
