		}
		{
			String _name = "DSThaddSurrelBlacksmithTip";
			String _text = "Der Thadd Surrel & Familie Schmied stellt Werkzeuge, Eisenbeschläge, Ambosse und Wagenteile her. Zum Betrieb wird ein metallurgischer Brennstoff benötigt. Erfordert 89 Arbeit zum Bauen.";
		}
		{
			String _name = "DSThaddSurrelTinsmith";
			String _text = "Thadd Surrel & Familie: Klempner";
		}
		{
			String _name = "DSThaddSurrelTinsmithLwr";
