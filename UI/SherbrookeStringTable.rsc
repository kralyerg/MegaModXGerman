		{ String _name = "SherbrookeSawMillTip";				String _text = "Das Sherbrooke-Sägewerk stellt Bauholz oder Brennholz aus Baumstämmen her. Zum Platzieren am Wasserrand. Zusammen mit den Brücken- und Dammteilen des Sherbrooke-Sägewerks verwenden, um Ihre Mühle anzupassen."; }

		{ String _name = "SBSawMillBridge1";					String _text = "Mühlenbrücke Niedrig 1x3"; }
		{ String _name = "SBSawMillBridge1Lwr";					String _text = "Mühlenbrücke"; }
		{ String _name = "SBSawMillBridge1Tip";					String _text = "Ein niedriges 3x1-Brückenteil zur Verwendung mit dem Sherbrooke-Sägewerk. Auf Wasser platzierbar, ebnet den Boden nicht ein. Handelsboote können dieses Teil nicht passieren."; }

		{ String _name = "SBSawMillBridge2";					String _text = "Mühlenbrücke Hoch 1x3"; }
		{ String _name = "SBSawMillBridge2Lwr";					String _text = "Mühlenbrücke"; }
