		{ String _name = "CitationRKTrainingCamp1Tip";			String _text = "Ihr seid die Bögen, von denen eure Kinder als lebendige Pfeile ausgesandt werden. - Khalil Gibran."; }
		{ String _name = "CitationRKTrainingCamp2Tip";			String _text = "Jede Nation hat eine Flagge. - Ayman Odeh."; }
		{ String _name = "CitationRKTrainingCamp3Tip";			String _text = "Angriff ist das Geheimnis der Verteidigung; Verteidigung ist die Planung eines Angriffs. - Sunzi."; }
		{ String _name = "CitationRKTrainingCamp4Tip";			String _text = "Ich glaube nicht, dass Architektur nur Unterschlupf ist, nur eine sehr einfache Umschließung. Sie sollte Sie begeistern, Sie beruhigen, Sie zum Nachdenken bringen können. - Zaha Hadid."; }
		{ String _name = "CitationRKTrainingCamp5Tip";			String _text = "Die Menschheit hat nur eine wirklich wirksame Waffe, und das ist das Lachen. - Mark Twain."; }
		{ String _name = "CitationRKTrainingCamp6Tip";			String _text = "Die mächtigste Waffe der Erde ist die brennende menschliche Seele. - Ferdinand Foch."; }
		{ String _name = "CitationRKTrainingCamp7Tip";			String _text = "Gewaltlosigkeit ist eine mächtige und gerechte Waffe. - Martin Luther King, Jr."; }
		{ String _name = "CitationRKTrainingCamp8Tip";			String _text = "Ein wohlgeordnetes Leben gleicht dem Besteigen eines Turms; die Aussicht auf halber Höhe ist besser als die Aussicht vom Fuß aus, sie wird stetig schöner, während sich der Horizont weitet. - William Lyon Phelps."; }
		{ String _name = "CitationRKTrainingCamp9Tip";			String _text = "Ich kann Ihnen nicht genau zeigen, wie Gesundheitsversorgung ein grundlegendes Menschenrecht ist. Aber ich kann argumentieren, dass niemand an einer behandelbaren Krankheit sterben sollte. - Paul Farmer."; }

