StringTable UI
{
	Entry _strings
	[
		{
			String _name = "text1";
			String _text = "Das Köhlern wird von den Dorfarbeitern begonnen; sie räumen alles aus dem Bereich und liefern dann die Holzstämme zur Baustelle.";
		}
		{
			String _name = "text2";
			String _text = "Danach wird ein Bauarbeiter die Holzstämme vorbereiten und zu einem großen Holzstapel aufschichten, das Ganze mit etwas Erde bedecken und, bevor es vollständig verschlossen wird, den Meiler entzünden.";
		}
		{
			String _name = "text3";
			String _text = "Sobald der Verkohlungsprozess abgeschlossen ist, wird ein Köhler";
		}
		{
			String _name = "text4";
			String _text = "sicherstellen, dass der Meiler gelöscht ist, und die Holzkohle entnehmen.";
		}
		{
			String _name = "text5";
			String _text = "Kohlenmeiler sind gefährlich, stinkend und rauchig. Sie eignen sich am besten außerhalb von Dörfern, innerhalb von Wäldern oder abseits von anderen Gebäuden.";
		}
		{
			String _name = "CharcoalRequire";
			String _text = "Holzkohle - metallurgischer Brennstoff, aber auch in einigen Häusern verwendet. Beim Schmieden verwendet, kann sie bei den sehr hohen Temperaturen brennen, die zum Schmelzen fester Metalle benötigt werden.";
		}
		{
			String _name = "CharcoalDestroy";
			String _text = "Drücken, um abzureißen und mit der Aufräumung der Baustelle zu beginnen.";
		}
		{
			String _name = "DestroyRemove";
			String _text = "Der Kohlenmeiler ist erschöpft; die Aufräumarbeiten an der Baustelle haben begonnen. Sobald dies abgeschlossen ist, können Sie die übrig gebliebene unerwünschte Asche entfernen.";
		}
		{
			String _name = "DestroyReclaimTip";
			String _text = "Die Entfernung der Ressource stoppen und den Abriss dieses Kohlenmeilers stoppen.";
		}
		{
			String _name = "DestroyButton";
			String _text = "Entfernen";
		}
		{
			String _name = "DestroyButtonTip";
			String _text = "Jetzt, wo Sie endlich bereit sind, den Kohlenmeiler zu entfernen und aufzuräumen:";
		}
		{
			String _name = "text6";
			String _text = "Hoppla! Die Bauarbeiter haben die verbrauchte Asche des Kohlenmeilers zurückgelassen, drücken Sie die Schaltfläche, um sie zu entfernen.";
		}
	]

}
