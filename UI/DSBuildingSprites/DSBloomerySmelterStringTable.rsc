StringTable UI
{
	Entry _strings
	[
		{
			String _name = "text1";
			String _text = "Das Schmelzen im Rennofen wird von den Dorfarbeitern begonnen, die alles aus dem Bereich räumen und dann die Erze, Holzkohle und Ton zur Baustelle liefern.";
		}
		{
			String _name = "text2";
			String _text = "Danach wird ein Bauarbeiter den Rennofen aus dem Ton errichten. In den Ofen werden abwechselnd Schichten aus Erz und Holzkohle eingebracht. Der Ofen wird früh entzündet, während die Schichten hinzugefügt werden, die Bauarbeiter übernehmen den Großteil der Arbeit, durchstoßen ein Loch, um die unerwünschte Schlacke entweichen zu lassen, und beginnen nach Fertigstellung mit dem Abriss.";
		}
		{
			String _name = "text3";
			String _text = "Sobald dies abgeschlossen ist, wird ein Schmied die Luppe entnehmen";
		}
		{
			String _name = "text4";
			String _text = "aus dem Ofen und sie bearbeiten, um das fertige Produkt herzustellen.";
		}
		{
			String _name = "text5";
			String _text = "Ein Rennofen muss abgerissen werden, sobald der Schmied die Verarbeitung des Eisens abgeschlossen hat.";
		}
		{
			String _name = "text5copper";
			String _text = "Ein Rennofen muss abgerissen werden, sobald der Schmied die Verarbeitung des Kupfers abgeschlossen hat.";
		}
		{
			String _name = "IronRequire";
			String _text = "Eisen - das häufigste und meistgenutzte der Metalle; Eisen hat sein eigenes Limit zur Steuerung der Produktion. Es wird vor allem als Material zur Herstellung von Werkzeugen verwendet, findet aber auch beim Gebäudebau Verwendung.";
		}
		{
			String _name = "CopperRequire";
			String _text = "Kupfer - wird unter dem Limit für Metalle, Legierungen & Schmiedewaren zur Steuerung der Produktion hergestellt. Die Verwendung liegt hauptsächlich im Gebäudebau, es kann aber auch zur Herstellung von Werkzeugen und Kupferwaren verwendet werden.";
		}
		{
			String _name = "BronzeRequire";
			String _text = "Bronze - wird unter dem Limit für Metalle, Legierungen & Schmiedewaren zur Steuerung der Produktion hergestellt. Wird als frühes Produkt zur Herstellung von Werkzeugen verwendet, auch beim Bau eingesetzt.";
		}
		{
			String _name = "CharcoalDestroy";
			String _text = "Drücken, um abzureißen und mit der Aufräumung der Baustelle zu beginnen.";
		}
		{
			String _name = "DestroyRemove";
			String _text = "Der Rennofen ist erschöpft; die Aufräumarbeiten an der Baustelle haben begonnen. Sobald dies abgeschlossen ist, können Sie die alte Basis des Ofens entfernen.";
		}
		{
			String _name = "DestroyReclaimTip";
			String _text = "Die Entfernung der Ressource stoppen und den Abriss dieses Rennofens stoppen.";
		}
		{
			String _name = "DestroyButton";
			String _text = "Entfernen";
		}
		{
			String _name = "DestroyButtonTip";
			String _text = "Jetzt, wo Sie endlich bereit sind, den Rennofen zu entfernen und aufzuräumen:";
		}
		{
			String _name = "text6";
			String _text = "Hoppla! Die Bauarbeiter haben die Basis des verbrauchten Rennofens zurückgelassen, drücken Sie die Schaltfläche, um sie zu entfernen.";
		}
	]

}
