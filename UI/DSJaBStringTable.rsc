		{ String _name = "DSJaBJettyDriftWoodCollectorSLCTTip";		String _text = "Sucht und sammelt Baumstämme oder Brennholz aus den Wasserwegen, ist dadurch langsamer als der Sammler. Beschäftigt mindestens 2 Arbeiter. Erfordert 34 Arbeit zum Bau. Dieses Gebäude hat nur eine begrenzte Produktionsdauer (ca. 5 Jahre) und wird schließlich die verfügbaren Ressourcen erschöpfen, danach wird es zu einem verfallenen Steggebäude. Das Gebäude kann dann auf Abriss gestellt werden, wobei das neue Gebäude eine kleine Menge an Baumstämmen und Brennholz erzeugt, bevor es mit dem Werkzeug zum Entfernen von Bauten vollständig abgerissen werden kann."; }
			{ String _name = "DriftWoodCollectorRequire1";		String _text = "Baumstämme"; }
			{ String _name = "DriftWoodCollectorRequire2";		String _text = "Brennholz"; }
