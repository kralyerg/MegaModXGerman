			String _text = "Dorfplatz-Met-Brauer";
		}
		{
			String _name = "DSVillageSquareMeadBrewerTip";
			String _text = "der Dorfplatz-Met-Brauer, ein kleines Gebäude zum Brauen und Ausschenken von Met und Glühmet. Met wird entweder aus Honig & Wasser oder Wildhonig & Wasser hergestellt. Glühmet verwendet Met & Kräuter. Beschäftigt 1 Brauer. Der Met-Brauer kann insgesamt 250 Gewicht lagern. Der Bau benötigt 55 Arbeit.";
		}
		{
			String _name = "DSVillageMeadery";
			String _text = "Dorf-Met-Brauerei";
		}
		{
			String _name = "DSVillageMeaderyLwr";
			String _text = "Dorf-Met-Brauerei";
		}
		{
			String _name = "DSVillageMeaderyTip";
			String _text = "die Dorf-Met-Brauerei, eine Taverne, die Met und Glühmet für die Bürger braut und ausschenkt. Met wird entweder aus Honig & Wasser oder Wildhonig & Wasser hergestellt. Glühmet verwendet Met & Kräuter. Beschäftigt 1-4 Brauer. Die Met-Brauerei kann insgesamt 600 Gewicht lagern. Der Bau benötigt 144 Arbeit.";
		}
		{
			String _name = "MeadWaterRequire";
			String _text = "Met (40 Honig + 20 Wasser)";
		}
		{
