StringTable resource
{
	Entry _strings
	[ 

		{ String _name = "PalmsOnlyEasyName";		String _text = "Palmen - Leicht"; }
		{ String _name = "PalmsOnlyEasyDesc";		String _text = "Ein normales leichtes Spiel nur mit Palmen und tropischen Bäumen. Ein leichtes Spiel beginnt mit sechs Familien. Es wird eine große Menge an Kleidung, Nahrung, Feuerholz, Baumaterialien und Werkzeugen bereitgestellt. Häuser und Lagerbereiche wurden bereits gebaut. Saatgut für Felder und Obstgärten ist ebenso verfügbar wie eine Viehherde."; }

		{ String _name = "PalmsOnlyMediumName";		String _text = "Palmen - Mittel"; }
		{ String _name = "PalmsOnlyMediumDesc";		String _text = "Ein normales mittelschweres Spiel nur mit Palmen und tropischen Bäumen. Ein mittelschweres Spiel beginnt mit fünf Familien. Kleidung, Nahrung, Feuerholz, Werkzeuge und Baumaterialien werden bereitgestellt. Eine Lagerscheune wurde bereits gebaut. Etwas Saatgut für Felder und Obstgärten ist verfügbar."; }

		{ String _name = "PalmsOnlyHardName";		String _text = "Palmen - Schwer"; }
		{ String _name = "PalmsOnlyHardDesc";		String _text = "Ein normales schweres Spiel nur mit Palmen und tropischen Bäumen. Ein schweres Spiel beginnt mit vier Familien. Es wird eine kleine Menge an Kleidung, Nahrung, Feuerholz und Werkzeugen bereitgestellt. Es ist kein Saatgut für den Ackerbau verfügbar."; }

		{ String _name = "PalmsOnlyAEName";		String _text = "Palmen - Adam & Eva"; }
		{ String _name = "PalmsOnlyAEDesc";		String _text = "Ein normales Adam & Eva Spiel nur mit Palmen und tropischen Bäumen. Beginnt mit nur 2 Personen. Eine kleine Menge an Nahrung, Feuerholz und Kleidung wird in einem kleinen Lagerwagen bereitgestellt. Es wurden keine Gebäude errichtet, anfangs sind weder Saatgut noch Vieh verfügbar - du musst überleben und dir alles selbst beschaffen."; }

	]
}

