		{ String _name = "CitationRKTrainingCamp1Tip";			String _text = "Ihr seid die Bogen, aus denen eure Kinder als lebendige Pfeile entsandt werden. - Khalil Gibran."; }
		{ String _name = "CitationRKTrainingCamp2Tip";			String _text = "Jede Nation hat eine Flagge. - Ayman Odeh."; }
		{ String _name = "CitationRKTrainingCamp3Tip";			String _text = "Angriff ist das Geheimnis der Verteidigung; Verteidigung ist die Planung eines Angriffs. - Sun Tzu."; }
		{ String _name = "CitationRKTrainingCamp4Tip";			String _text = "Ich glaube nicht, dass es in der Architektur nur um Schutz geht, nur um eine sehr einfache Umhüllung. Sie sollte euch begeistern können, euch beruhigen können, euch zum Nachdenken bringen. - Zaha Hadid."; }
		{ String _name = "CitationRKTrainingCamp5Tip";			String _text = "Die Menschheit hat eine wirklich wirksame Waffe, und das ist das Lachen. - Mark Twain."; }
		{ String _name = "CitationRKTrainingCamp6Tip";			String _text = "Die mächtigste Waffe auf Erden ist die menschliche Seele in Flammen. - Ferdinand Foch."; }
		{ String _name = "CitationRKTrainingCamp7Tip";			String _text = "Gewaltlosigkeit ist eine machtvolle und gerechte Waffe. - Martin Luther King, Jr."; }
		{ String _name = "CitationRKTrainingCamp8Tip";			String _text = "Ein wohlgeordnetes Leben gleicht dem Besteigen eines Turms; die Aussicht auf halber Höhe ist besser als die vom Fuß aus, und sie wird stetig schöner, je weiter sich der Horizont ausdehnt. - William Lyon Phelps."; }
		{ String _name = "CitationRKTrainingCamp9Tip";			String _text = "Ich kann euch nicht genau zeigen, warum Gesundheitsversorgung ein grundlegendes Menschenrecht ist. Aber ich kann argumentieren, dass niemand an einer behandelbaren Krankheit sterben sollte. - Paul Farmer."; }

