		{ String _name = "cc17WindmillTip";				String _text = "Die Stadtwindmühle ist ein großes Gebäude, das aus verschiedenen Getreidearten Mehl herstellen kann. Sie ist die schnellste und effizienteste verfügbare Windmühle."; }

		{ String _name = "Watermill";					String _text = "Wassermühle"; }
