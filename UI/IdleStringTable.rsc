	Entry _strings
	[
		{
			String _name = "Huoshan";
			String _text = "[IC]St. Valcano - Astor Yao";
		}
		{
			String _name = "HuoshanLwr";
			String _text = "[IC]St. Valcano - Astor Yao";
		}
		{
			String _name = "HuoshanTip";
			String _text = "Ein Kontinent aus alten Zeiten. Bitte wähle das beste Terrain mit möglichst viel Ebene. Da die Menschen in der Nähe des St. Valcano leben, werden sie in dieser Gegend bis zu 60 Jahre alt und bekommen Kinder zwischen 10 und 50 Jahren, doch die Menschen sind schneller und geschickter, weshalb du keine Flüchtlinge aufnimmst. Das Spiel beginnt in der Nachbarschaft des St. Valcano, und der St. Valcano kann das Fluchwerkzeug zu einem heiligen Werkzeug segnen (es kann für immer von jemandem benutzt werden).";
		}
		{
			String _name = "Dachengbao";
			String _text = "Die riesige Burg";
		}
		{
			String _name = "DachengbaoLwr";
			String _text = "Die riesige Burg";
		}
		{
			String _name = "DachengbaoTip";
			String _text = "Eines der wundersamen Gebäude. Es kann den Cheat-Modus (Der Gottmodus) freischalten, aber die Kosten sind hoch.";
		}
