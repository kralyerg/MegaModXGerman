		}
		{
			String _name = "UpStoneHouse";
			String _text = "*Gesegnetes Steinhaus";
		}
		{
			String _name = "UpStoneHouseLwr";
			String _text = "*Gesegnetes Steinhaus";
		}
		{
			String _name = "UpStoneHouseTip";
			String _text = "Erhalte den Segen der St. Belle. Das gesegnete Steinhaus wird nicht mehr von Feuer und Tornados betroffen. Der Wiederaufbau dieses Gebäudes erfordert die Träne der St. Belle. Du kannst die Träne der St. Belle durch die Zucht von St.-Belle-Hühnern erhalten.";
		}
		{
			String _name = "UpChapel";
			String _text = "*Gesegnete Kapelle";
		}
		{
			String _name = "UpChapelLwr";
			String _text = "*Gesegnete Kapelle";
		}
		{
			String _name = "UpChapelTip";
			String _text = "Erhalte den Segen der St. Belle und die Traurige Regenseele. Die gesegnete Kapelle wird nicht mehr von Feuer und Tornados betroffen, außerdem verdoppelt sich die Kapazität der Kapelle. Der Wiederaufbau dieses Gebäudes erfordert die Träne der St. Belle. Die Traurige Regenseele kann die Gebäudefunktion verbessern. Du kannst die Träne der St. Belle durch die Zucht von St.-Belle-Hühnern erhalten. Du kannst die Traurige Regenseele durch das Ausgraben eines Grabes erhalten, musst aber zuerst den Grabstein abbauen.";
		}
		{
			String _name = "UpCropField";
			String _text = "*Gesegnetes Feld";
		}
		{
			String _name = "UpCropFieldLwr";
			String _text = "*Gesegnetes Feld";
		}
		{
			String _name = "UpCropFieldTip";
			String _text = "Erhalte den Segen der St. Belle. Das gesegnete Feld wächst schneller, verbessert die Insektenresistenz und verkürzt das Ansteckungsintervall. Du kannst die Träne der St. Belle durch die Zucht von St.-Belle-Hühnern erhalten.";
		}
