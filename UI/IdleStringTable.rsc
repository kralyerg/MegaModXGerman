		{
			String _name = "HuoshanName";
			String _text = "*St. Valcano - Astor Yao";
		}
		{
			String _name = "HuoshanDesc";
			String _text = " Kontinent aus alten Zeiten. Bitte wähle das beste Terrain mit möglichst viel Ebene. Da die Menschen in der Nähe des St. Valcano leben, werden sie in dieser Gegend bis zu 60 Jahre alt und bekommen Kinder zwischen 10 und 50 Jahren, doch die Menschen sind schneller und geschickter, weshalb du keine Flüchtlinge aufnimmst. Das Spiel beginnt in der Nachbarschaft des St. Valcano, und der St. Valcano kann das Fluchwerkzeug zu einem heiligen Werkzeug segnen (es kann für immer von jemandem benutzt werden).";
		}
