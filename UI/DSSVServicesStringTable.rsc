		{ String _name = "HospitalUpgrade1Tip";			String _text = "Das Dorfkrankenhaus ausbauen, eine grössere Kapazität von 45 Patienten, beschäftigt 1-2 Ärzte mit einem neün Anbau, ausserhalb einer Steinmaür & kleiner Gartenverbesserung. Benötigt 55 Arbeit."; }
				
		
