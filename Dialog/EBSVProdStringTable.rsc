		//buildings
		{ String _name = "EBSVTannery";									String _text = "Dorfgerberei";	}
		{ String _name = "EBSVTanneryLwr";								String _text = "dorfgerberei";	}
		{ String _name = "EBSVTanneryTip";								String _text = "Die Dorfgerberei produziert gegerbtes Leder. 1 Gerber kann beschäftigt werden, um 1 gegerbtes Leder aus 1 Leder, 1 Wasser und 3 Salz herzustellen. Baukosten: 50. 2 Farbvarianten über die F-Taste.";  }
		
		{ String _name = "EBSVSaltMine";								String _text = "Dorf-Salzmine";	}
		{ String _name = "EBSVSaltMineLwr";								String _text = "dorf-salzmine";	}
		{ String _name = "EBSVSaltMineTip";								String _text = "Die Dorf-Salzmine gewinnt Salz aus einer Salzader. Bis zu 2 Arbeiter können beschäftigt werden, um das Salz zu gewinnen und zu verarbeiten. Produktion: 8 bis 12 Salz. Baukosten: 52. 2 Farbvarianten über die F-Taste."; }
		
		{ String _name = "EBSVWaterWell";								String _text = "Dorfbrunnen";	}
		{ String _name = "EBSVWaterWellLwr";							String _text = "dorfbrunnen";	}
		{ String _name = "EBSVWaterWellTip";							String _text = "Der Dorfbrunnen enthält Wasser. 1 Arbeiter kann beschäftigt werden, um 12 bis 16 Wasser aus dem Brunnen zu sammeln. Baukosten: 42. 2 Farbvarianten über die F-Taste."; }
		
		{ String _name = "EBSVShoemaker";								String _text = "Dorfschuhmacher";	}
		{ String _name = "EBSVShoemakerLwr";							String _text = "dorfschuhmacher";	}
		{ String _name = "EBSVShoemakerTip";							String _text = "Der Dorfschuhmacher produziert Schuhe. 1 Schuster kann beschäftigt werden, um verschiedene Arten von Schuhen aus Leder, Leinöl oder gegerbtem Leder herzustellen. Baukosten: 50. 2 Farbvarianten über die F-Taste.";  }
		
		{ String _name = "EBSVOilPress";								String _text = "Dorf-Ölpresse";	}
		{ String _name = "EBSVOilPressLwr";								String _text = "dorf-ölpresse";	}
		{ String _name = "EBSVOilPressTip";								String _text = "Die Dorf-Ölpresse produziert 14 bis 18 Pflanzenöl aus 25 Kernen und 1 Amphore, 14 bis 18 Samenöl aus 25 Pekannüssen oder 25 Walnüssen und 1 Amphore, oder 14 bis 18 Leinöl aus 25 Flachs und 1 Amphore. Bis zu 2 Presser können beschäftigt werden, um 18 bis 24 Samenöl aus Pekannüssen oder Walnüssen, 18 bis 24 Pflanzenöl aus 50 Kernen oder 18 bis 24 Leinöl aus 50 Flachs herzustellen. Baukosten: 48. 2 Farbvarianten über die F-Taste."; }
		
		{ String _name = "EBSVSandPit";									String _text = "Dorf-Sandgrube"; }
		{ String _name = "EBSVSandPitLwr";								String _text = "dorf-sandgrube"; }
		{ String _name = "EBSVSandPitTip";								String _text = "Die Dorf-Sandgrube produziert Sand. Bis zu 3 Arbeiter können beschäftigt werden, um 5 bis 7 Sand zu produzieren. Baukosten: 36. 2 Farbvarianten über die F-Taste."; }
		
		{ String _name = "EBSVPottery";									String _text = "Dorftöpferei";	}
		{ String _name = "EBSVPotteryLwr";								String _text = "dorftöpferei";	}
		{ String _name = "EBSVPotteryTip";								String _text = "Die Dorftöpferei produziert Amphoren. 1 Töpfer kann beschäftigt werden, um 3 bis 4 Amphoren aus 4 Ton und entweder 1 Kohle oder 1 Holzkohle herzustellen. Baukosten: 50. 2 Farbvarianten über die F-Taste.";  }
		
		{ String _name = "EBSVKiln";									String _text = "Dorfbrennofen";	}
		{ String _name = "EBSVKilnLwr";									String _text = "dorfbrennofen";	}
		{ String _name = "EBSVKilnTip";									String _text = "Der Dorfbrennofen produziert Ziegel. 1 Arbeiter kann beschäftigt werden, um Ziegel aus Ton und Brennstoff herzustellen. Baukosten: 50. 2 Farbvarianten über die F-Taste.";  }
		
		{ String _name = "EBSVClayPit";									String _text = "Dorf-Tongrube"; }
		{ String _name = "EBSVClayPitLwr";								String _text = "dorf-tongrube"; }
		{ String _name = "EBSVClayPitTip";								String _text = "Die Dorf-Tongrube produziert Ton. Bis zu 3 Arbeiter können beschäftigt werden, um 5 bis 7 Ton zu produzieren. Baukosten: 36. 2 Farbvarianten über die F-Taste."; }
		
		{ String _name = "EBSVApiary";									String _text = "Dorf-Bienenhaus"; }
		{ String _name = "EBSVApiaryLwr";								String _text = "dorf-bienenhaus"; }
		{ String _name = "EBSVApiaryTip";								String _text = "Ein Dorf-Bienenhaus dient zur Bienenhaltung und Honigerzeugung. Bis zu 2 Imker können beschäftigt werden, um 16 bis 22 Honig zu produzieren. Baukosten: 46. 2 Farbvarianten über die F-Taste."; }
		
		{ String _name = "EBSVPreservist";								String _text = "Dorf-Konservenmacher"; }
		{ String _name = "EBSVPreservistLwr";							String _text = "dorf-konservenmacher"; }
		{ String _name = "EBSVPreservistTip";							String _text = "Der Dorf-Konservenmacher produziert eingemachtes Fleisch oder eingemachtes Obst. Bis zu 2 Konservenmacher können beschäftigt werden, um 12 bis 14 eingemachtes Fleisch aus je 7 Wildbret, Hammelfleisch, Rindfleisch oder Hühnchen, 2 Salz und 1 Amphore, oder 10 bis 14 eingemachtes Obst aus je 7 Pflaumen, Birnen oder Pfirsichen, 2 Honig und 1 Amphore herzustellen. Baukosten: 52. 2 Farbvarianten über die F-Taste."; }
		
