		{ String _name = "EBSVRockQuarry";								String _text = "Dorf-Steinbruch";	}
		{ String _name = "EBSVRockQuarryLwr";							String _text = "dorf-steinbruch";	}
		{ String _name = "EBSVRockQuarryTip";							String _text = "Der Dorf-Steinbruch dient dem Abbau von Stein. Bis zu 12 Steinmetze können beschäftigt werden, um 1 bis 2 Stein zu produzieren. Arbeit: 10/10.0. Kapazität: 6000. Bauzyklen: 60. Der Steinbruch kann in eine Ferienanlage oder eine Fischzucht umgewandelt werden.";  }
		
		{ String _name = "SVRockQuarryResortUpgradeTip";				String _text = "Wandelt den Steinbruch in eine Ferienanlage um."; }
		{ String _name = "SVRockQuarryFishUpgradeTip";					String _text = "Wandelt den Steinbruch in eine Fischzucht um."; }
		
		{ String _name = "EBSVRockQuarryResort";						String _text = "Dorf-Ferienanlage";	}
		{ String _name = "EBSVRockQuarryResortLwr";						String _text = "dorf-ferienanlage";	}
		{ String _name = "EBSVRockQuarryResortTip";						String _text = "Der Dorf-Steinbruch wird in eine Ferienanlage mit Nahrungsmarkt umgewandelt. Bis zu 2 Verkäufer können beschäftigt werden. Bietet Unterhaltungszufriedenheit. Bauzyklen: 32.";  }
		
		{ String _name = "EBSVRockQuarryFish";							String _text = "Dorf-Fischzucht";	}
		{ String _name = "EBSVRockQuarryFishLwr";						String _text = "dorf-fischzucht";	}
		{ String _name = "EBSVRockQuarryFishTip";						String _text = "Der Dorf-Steinbruch wird in eine Fischzucht umgewandelt. Bis zu 4 Fischer können beschäftigt werden, um 5 bis 7 Fische zu fangen. Arbeit: 4/6.0. Bauzyklen: 32.";  }
	]
