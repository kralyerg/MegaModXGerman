		{ String _name = "EBApothecary";							String _text = "Apotheke"; }
		{ String _name = "EBApothecaryLwr";							String _text = "apotheke"; }
		{ String _name = "EBApothecaryTip";							String _text = "Die Apotheke produziert Gesundheitsgüter aus Wurzeln, Kräutern, Wein, Samenöl, Wasser und Glaswaren. Bis zu 2 Apotheker können beschäftigt werden, um 3 bis 4 Heilbrühe, Heilöl oder Kräutertee zu produzieren. Baukreislauf: 60."; }
		
		{ String _name = "EBHerbalist";								String _text = "Kräutersammler"; }
		{ String _name = "EBHerbalistLwr";							String _text = "kräutersammler"; }
		{ String _name = "EBHerbalistTip";							String _text = "Der Kräutersammler wird eingesetzt, um Kräuter zu sammeln und den Bürgern einfache Gesundheitsversorgung und Heilung zu bieten. Bis zu 2 Kräutersammler können beschäftigt werden, um 2 bis 3 Kräuter zu sammeln. Baukreislauf: 42."; }
		
		{ String _name = "EBGlassWorks";							String _text = "Glashütte";	}
