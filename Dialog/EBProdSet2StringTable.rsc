		{ String _name = "EBGlassWorksTip";							String _text = "Die Glashütte produziert Glas oder Glaswaren aus Sand und Kohle. Bis zu 2 Glasmacher können beschäftigt werden, um 7 bis 8 Glas oder 7 bis 8 Glaswaren aus 23 Sand + 3 Kohle oder 23 Sand + 4 Industriekohle herzustellen. Baukreisläufe: 58."; }
		
		{ String _name = "EBWinery";								String _text = "Weingut";	}
