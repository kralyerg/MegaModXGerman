			String _text = "Brennholz und Holzkohle*";
		}
		{
			String _name = "column3text02Tip";
			String _text = "Holzkohle ist in der Produktion durch das Limit Brennstoffe:Metallurgisch begrenzt, ist aber ein Brennstoff, den Bürger in ihren Häusern nutzen können.";
		}
		{
			String _name = "column3text03";
			String _text = "Bronzewerkzeug, Eisenwerkzeug, *";
		}
		{
			String _name = "column3text03Tip";
			String _text = "Kupferwerkzeug, Bronzewerkzeug, Eisenwerkzeug, Stahlwerkzeug, Gehärtetes Werkzeug. Es gibt zudem langlebigere, 'feine' *geschärfte Versionen aller Werkzeuge sowie eine 'feinere' *geschärft-geölte Version aller Werkzeuge.";
		}
		{
			String _name = "column3text04";
			String _text = "Fell, Wolle & Warme Mäntel, Segeltuchmäntel";
		}
		{
			String _name = "column3text05";
			String _text = "Kräuter, Gelee Royale, Ohrenkerzen";
		}
		{
			String _name = "column3text06";
