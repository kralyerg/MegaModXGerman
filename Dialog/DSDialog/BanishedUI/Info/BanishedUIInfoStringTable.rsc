StringTable Info
{
	Entry _strings
	[
		{
			String _name = "HealthHappiness";
			String _text = "Gesundheit & Glück";
		}
		{
			String _name = "HealthHappinessTitle1";
			String _text = "Gesundheit & Glück";
		}
		{
			String _name = "HealthHappinessTitle2";
			String _text = "- über die Krankheiten und Leiden, die Dorfbewohner befallen, sowie über ihr Glück und ihre Depression -";
		}
		{
			String _name = "column1text01";
			String _text = "Gesundheit und Glück werden dem Spieler in Banished durch Symbole angezeigt (siehe rechts), entweder als durchschnittliche Stadtstatistik oder individuell bei Auswahl und Ansicht der Bürgeroberfläche.";
		}
		{
			String _name = "column1text02";
			String _text = "Beim Spielen von Banished kann es manchmal leicht sein, ein Dorf mit vollen Herzen oder Sternen zu haben (für Gesundheits- bzw. Glückswerte).";
		}
		{
			String _name = "column1text03";
			String _text = "Bei Verwendung von DS-Mods* werden Bürger jedoch häufiger und stärker von dem beeinflusst, was sie ungesund und unglücklich macht. Dies bietet dem Spieler ein anspruchsvolleres und interaktiveres Spielerlebnis.";
		}
		{
			String _name = "column1text04";
			String _text = "*(dies gilt nur, wenn bestimmte DS-Mods über anderen Mods platziert werden, die ebenfalls die Bürgerdatei verändern können).";
		}
		{
			String _name = "column1text05";
			String _text = "Es wird nun notwendig, eine angemessene Ernährung, spirituelle und andere Bedürfnisse der Bürger sicherzustellen und der Stadtplanung mehr Bedeutung beizumessen, um negativen Glückseinflüssen entgegenzuwirken.";
		}
		{
			String _name = "column1text06";
			String _text = "Krankheiten & Leiden";
		}
		{
			String _name = "column1text07";
			String _text = "Zusammen mit Änderungen an Gesundheit und Glück der Bürger gibt es Änderungen";
		}
		{
			String _name = "column1text07add";
			String _text = "an der Wahrscheinlichkeit und den Arten von Krankheiten, die Bürger sich zuziehen können. Wenn ein Bürger davon betroffen ist, benötigt er die Pflege eines Krankenhauses und eines Arztes.";
		}
		{
			String _name = "column1text08";
			String _text = "eine Liste der Krankheiten und Leiden:";
		}
		{
			String _name = "column1text09";
			String _text = "Apoplexie (Schlaganfall)";
		}
		{
			String _name = "column1text10";
			String _text = "Atrophie (Muskelschwund)";
		}
		{
			String _name = "column1text11";
			String _text = "Verdauungsstörung";
		}
		{
			String _name = "column1text12";
			String _text = "Schwarzes Fieber (parasitär)";
		}
		{
			String _name = "column1text13";
			String _text = "Blutvergiftung (Sepsis)";
		}
		{
			String _name = "column1text14";
			String _text = "Knochenbruch";
		}
		{
			String _name = "column1text15";
			String _text = "Windpocken";
		}
		{
			String _name = "column1text16";
			String _text = "Cholera";
		}
		{
			String _name = "column1text17";
			String _text = "Durchfall";
		}
		{
			String _name = "column1text18";
			String _text = "Diphtherie";
		}
		{
			String _name = "column1text19";
			String _text = "Ruhr (der blutige Fluss)";
		}
		{
			String _name = "column1text20";
			String _text = "Endokarditis (Wasserelfenkrankheit)";
		}
		{
			String _name = "column1text21";
			String _text = "Ergotismus (Antoniusfeuer)";
		}
		{
			String _name = "column1text22";
			String _text = "Gonorrhoe";
		}
		{
			String _name = "column1text23";
			String _text = "Influenza (Schweißkrankheit)";
		}
		{
			String _name = "column1text24";
			String _text = "Lepra (Aussatz)";
		}
		{
			String _name = "column1text25";
			String _text = "Malaria (das Wechselfieber)";
		}
		{
			String _name = "column1text26";
			String _text = "Masern";
		}
		{
			String _name = "column1text27";
			String _text = "Mumps";
		}
		{
			String _name = "column1text28";
			String _text = "Pest (der Schwarze Tod)";
		}
		{
			String _name = "column1text29";
			String _text = "Lungenentzündung";
		}
		{
			String _name = "column1text30";
			String _text = "Scharlach";
		}
		{
			String _name = "column1text31";
			String _text = "Skrofulose (das Königsübel)";
		}
		{
			String _name = "column1text32";
			String _text = "Skorbut";
		}
		{
			String _name = "column1text33";
			String _text = "Pocken (die rote Pest)";
		}
		{
			String _name = "column1text34";
			String _text = "Tuberkulose";
		}
		{
			String _name = "column1text35";
			String _text = "Typhus";
		}
		{
			String _name = "column1text36";
			String _text = "Keuchhusten";
		}
		{
			String _name = "column1text37";
			String _text = "Gelbfieber";
		}
		{
			String _name = "column1labelDeathLow";
			String _text = "Todeswahrscheinlichkeit: unwahrscheinlich";
		}
		{
			String _name = "column1labelDeathMed";
			String _text = "Todeswahrscheinlichkeit: möglich";
		}
		{
			String _name = "column1labelDeathHigh";
			String _text = "Todeswahrscheinlichkeit: häufig";
		}
		{
			String _name = "column1labelAcqVeryLow";
			String _text = "Ansteckungswahrscheinlichkeit: sehr gering";
		}
		{
			String _name = "column1labelAcqLow";
			String _text = "Ansteckungswahrscheinlichkeit: gering";
		}
		{
			String _name = "column1labelAcqAvg";
			String _text = "Ansteckungswahrscheinlichkeit: gelegentlich";
		}
		{
			String _name = "column1labelAcqAbAvg";
			String _text = "Ansteckungswahrscheinlichkeit: häufig";
		}
		{
			String _name = "column1labelAcqHigh";
			String _text = "Ansteckungswahrscheinlichkeit: hoch";
		}
		{
			String _name = "column1labelAcqVeryHigh";
			String _text = "Ansteckungswahrscheinlichkeit: sehr hoch";
		}
		{
			String _name = "column1labelTransNo";
			String _text = "übertragbar? nein";
		}
		{
			String _name = "column1labelTransYes";
			String _text = "übertragbar? ja";
		}
		{
			String _name = "column2text01";
			String _text = "Gesundheitssymbole:";
		}
		{
			String _name = "column2text02";
			String _text = "Die Gesundheit eines Bürgers wird von vielen Faktoren bestimmt:";
		}
		{
			String _name = "column2text03";
			String _text = "Eine vollständige Ernährung mit vielen Nahrungsmitteln aus allen Kategorien: Obst, Getreide, Proteine & Gemüse.";
		}
		{
			String _name = "column2text04";
			String _text = "Kräuterkundler mit ausreichenden Vorräten an Kräutern & Medizin.";
		}
		{
			String _name = "column2text05";
			String _text = "Ärzte und eine ausreichende Behandlungskapazität für die schnelle Vorbeugung von Krankheiten und Leiden.";
		}
		{
			String _name = "column2text06";
			String _text = "Handelsschiffe und Nomaden bergen ein hohes Risiko, Krankheiten und Leiden in Dörfer zu bringen. Dies kann die Gesundheit der Bürger drastisch senken, wenn keine Vorsorgemaßnahmen getroffen werden.";
		}
		{
			String _name = "column2text07";
			String _text = "Ebenso führt ein Mangel an Kräuterkundlern oder eine unzureichende Versorgung mit Kräutern und Medizin dazu, dass häufige Krankheiten unter den Dorfbewohnern weit verbreitet sind. Dies wird besorgniserregend bei stark ungesunden Bürgern, die wahrscheinlich tödliche Krankheiten in sich tragen und übertragen.";
		}
		{
			String _name = "column2text08";
			String _text = "Es ist äußerst wichtig, deine Bürger warm zu halten, wenn die Temperaturen sinken. Dies bedeutet nicht nur eine ausreichende Brennstoffversorgung für den Haushalt, sondern auch geeignete Wege und Straßen, damit Bürger schnell warme Orte erreichen können.";
		}
		{
			String _name = "column2text09";
			String _text = "Gebäude, die Bürgern Gesundheit bieten, sind an ihren Radiusfarben zu erkennen:";
		}
		{
			String _name = "column2text10";
			String _text = "Kräuterkundler sind bekannt dafür, Heilkräuter zu sammeln, zuzubereiten und für die vielen kleineren Leiden zu verabreichen, die Bürger im Laufe ihres Lebens befallen.";
		}
		{
			String _name = "column2text11";
			String _text = "Krankenhäuser & Ärzte werden für die Behandlung von ansteckenden und tödlichen Krankheiten sowie komplizierten Leiden wie Knochenbrüchen benötigt (siehe Liste links).";
		}
		{
			String _name = "column3text01";
			String _text = "Glückssymbole:";
		}
		{
			String _name = "column3text02";
			String _text = "Das Glück eines Bürgers gliedert sich in folgende positive Kategorien, die von Gebäuden vergeben werden und leicht an ihren jeweiligen Radiusfarben zu erkennen sind:";
		}
		{
			String _name = "column3text03";
			String _text = "Sicherheit";
		}
		{
			String _name = "column3text04";
			String _text = "Güter";
		}
		{
			String _name = "column3text05";
			String _text = "Geist";
		}
		{
			String _name = "column3text06";
			String _text = "Unterhaltung";
		}
		{
			String _name = "column3text07";
			String _text = "Alkohol";
		}
		{
			String _name = "column3text08";
			String _text = "Sonstiges";
		}
		{
			String _name = "column3text09";
			String _text = "Darüber hinaus gibt es auch einen negativen Aspekt, der manchmal von lauten, übelriechenden oder gefährlichen Gebäuden ausgeht:";
		}
		{
			String _name = "column3text10";
			String _text = "Beeinträchtigung";
		}
		{
			String _name = "column3text11";
			String _text = "Depression wird für unglückliche Bürger sehr real, sie werden häufiger untätig und weniger produktiv.";
		}
		{
			String _name = "column3text12";
			String _text = "Und wie in einer Abwärtsspirale: Je weniger Arbeit sie leisten, desto unglücklicher werden sie.";
		}
		{
			String _name = "column3text13";
			String _text = "Sorge dafür, dass sich deine Bürger sicher fühlen, mithilfe von Löschbrunnen oder sogar Wachtürmen und Mauern.";
		}
		{
			String _name = "column3text14";
			String _text = "Märkte, Händler & Handelsposten sowie einige Produktionsgebäude können Bürgern Güter-Glück bringen.";
		}
		{
			String _name = "column3text15";
			String _text = "Stelle sicher, dass ihre spirituellen Bedürfnisse durch Kapellen und Gebets- und Andachtsstätten erfüllt werden, aber auch durch Friedhöfe und Orte, an denen Bürger ihrer Verstorbenen gedenken können.";
		}
		{
			String _name = "column3text16";
			String _text = "Unterhaltungs-Glück gliedert sich in zwei Kategorien, definiert durch ihre Radiusfarben:";
		}
		{
			String _name = "column3text17";
			String _text = "Alkohol, Gasthäuser & Tavernen. Bürger genießen den Konsum von Alkohol und das Wirtshausleben. Halte die Keller und Bierstuben gut gefüllt.";
		}
		{
			String _name = "column3text18";
			String _text = "Sonstiges Unterhaltungs-Glück kann von Theatern, Denkmälern oder anderen Gebäuden kommen, die nichts mit Alkohol zu tun haben.";
		}
		{
			String _name = "column3text19";
			String _text = "Der Radius von Gebäuden mit einer Beeinträchtigung wirkt sich negativ auf alle Bürger darin aus. Durch Stadtplanung und den Bau positiver Einflussgeber rund um diese Produktionsgebäude kannst du sicherstellen, dass Arbeiter nicht übermäßig unglücklich werden.";
		}
		{
			String _name = "blank";
			String _text = " ";
		}
	]

}

StringTable InfoHouseholdFuels
{
	Entry _strings
	[
		{
			String _name = "HouseholdFuels";
			String _text = "Haushaltsbrennstoffe";
		}
		{
			String _name = "HouseholdFuelsTitle1";
			String _text = "Haushaltsbrennstoffe";
		}
		{
			String _name = "HouseholdFuelsTitle2";
			String _text = "- über die Brennstoffe, die Bürger zum Heizen ihrer Häuser verwenden -";
		}
		{
			String _name = "column1text01a";
			String _text = "Die Beheizung des eigenen Zuhauses ist ebenso wichtig wie Dach und Wände, die die Wärme speichern. Der Herd eines Hauses macht es erst zu einem Zuhause - dort halten sich die Bürger warm und kochen ihre Mahlzeiten.";
		}
		{
			String _name = "column1text01b";
			String _text = "Je nach Wohnhaustyp besteht ein Brennstoffbedarf erst unterhalb einer bestimmten Temperatur. Zum Beispiel benötigen die normalen Holz- und Steinhäuser einen Brennstoff, um die Bürger bei 50 Grad F und darunter warm zu halten (dies stellt die Qualität der Hausisolierung dar, die niedrigeren Temperaturen standhalten kann).";
		}
		{
			String _name = "column1text01c";
			String _text = "Der Unterschied in der Wärme der normalen Wohnhäuser ergibt sich aus der Menge an Wärme und Zeit, die ein Haushaltsbrennstoff liefert (wie effizient Herd/Feuer ist). Ein Holzhaus erreicht einen Wärmewert von 60, während das Steinhaus einen Wärmewert von 90 erreicht und somit mehr Wärme aus weniger Brennstoff gewinnt.";
		}
		{
			String _name = "valueTip";
			String _text = "Warenwert";
		}
		{
			String _name = "valueTolTip";
			String _text = "Warenwert, dieses Produkt hat einen schwankenden Wert; Händler bieten oder kaufen daher zu einem Preis innerhalb dieser Spanne";
		}
		{
			String _name = "weightTip";
			String _text = "Warengewicht";
		}
		{
			String _name = "quantityTip";
			String _text = "Produktmenge, hergestellt von gebildeten oder ungebildeten Arbeitern";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "wird hergestellt aus:";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "oder:";
		}
		{
			String _name = "Firewood00";
			String _text = "Brennholz";
		}
		{
			String _name = "Firewood00Tip";
			String _text = "Brennholz wird unter dem Limit Brennstoff: Haushalt hergestellt und gelagert. Sowohl ungebildete als auch gebildete Holzfäller stellen 6 Stück aus einem Baumstamm her.";
		}
		{
			String _name = "Firewood01";
			String _text = "1 Baumstamm";
		}
		{
			String _name = "Firewood01Tip";
			String _text = "Es fallen pro Zyklus Kosten von 5 für den einzelnen Baumstamm an. Sowohl ungebildete als auch gebildete Arbeiter erzielen einen Gesamtgewinn von 7 bzw. 1,17 pro Brennholz.";
		}
		{
			String _name = "Firewood02";
			String _text = "2 Bauholz";
		}
		{
			String _name = "Firewood02Tip";
			String _text = "Es fallen pro Zyklus Kosten von 8 für das Bauholz an. Sowohl ungebildete als auch gebildete Arbeiter erzielen einen Gesamtgewinn von 4 bzw. 0,67 pro Brennholz.";
		}
		{
			String _name = "FirewoodQty";
			String _text = "Ertrag: 6";
		}
		{
			String _name = "FirewoodValue";
			String _text = "2";
		}
		{
			String _name = "FirewoodWeight";
			String _text = "2";
		}
		{
			String _name = "column2text09";
			String _text = "Holzkohle";
		}
		{
			String _name = "Charcoal00Tip";
			String _text = "Holzkohle, die durch eine thermische Reaktion namens Pyrolyse entsteht, wird zur Produktionskontrolle unter dem Limit Brennstoffe: Metallurgisch hergestellt. Holzkohle ist zudem ein Brennstoff, den Bürger zum Heizen ihrer Häuser nutzen, wenn er in ihrer Nähe verfügbar ist.";
		}
		{
			String _name = "column2text10";
			String _text = "21 Baumstämme";
		}
		{
			String _name = "Charcoal01Tip";
			String _text = "Diese Methode hat pro Zyklus Kosten von 105. Ungebildete erzielen einen Gewinn von 133 bzw. 3,91 pro Stück Holzkohle, während ein gebildeter Arbeiter einen Gesamtgewinn von 280 bzw. 5,09 pro Stück Holzkohle erzielt.";
		}
		{
			String _name = "CharcoalQty";
			String _text = "Ertrag: 34-55";
		}
		{
			String _name = "CharcoalValue";
			String _text = "7";
		}
		{
			String _name = "CharcoalWeight";
			String _text = "5";
		}
		{
			String _name = "blank";
			String _text = " ";
		}
	]

}

