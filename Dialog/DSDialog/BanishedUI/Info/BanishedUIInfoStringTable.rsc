StringTable InfoToolsCrafted
{
	Entry _strings
	[
		{
			String _name = "ToolsCrafted";
			String _text = "Werkzeuge & Geräte";
		}
		{
			String _name = "Title1";
			String _text = "Werkzeuge, gefertigte Güter & Geräte";
		}
		{
			String _name = "Title2";
			String _text = "- über Werkzeuge und Geräte, sowohl die von allen Bürgern als auch die von Fachkräften genutzten -";
		}
		{
			String _name = "column1text01";
			String _text = "Werkzeuge spielen eine sehr wichtige Rolle für eine florierende Stadt. Werkzeuge, also die von allen Bürgern genutzte Art (Bronzewerkzeuge, Eisenwerkzeuge, Stahlwerkzeuge usw.), sind für wirtschaftliche und praktische Zwecke notwendig. Sie werden für die wichtigsten Aufgaben benötigt: Holzhacken, Roden, Säen und Ernten von Feldern, Bergbau, Schmiedehandwerk - all das erfordert den Einsatz von Werkzeugen.";
		}
		{
			String _name = "column1text02";
			String _text = "Einer Aufgabe oder einem Gebäude wird eine Arbeitszeit-Zahl zugewiesen, das ist die Zeiteinheit, die zur Erledigung der Aufgabe und Abschluss des Zyklus/der Produktion aufgewendet wird. Zusätzlich gibt es jedoch eine Zahl für den benötigten Arbeitsaufwand; diese Zahl stellt die tatsächliche physische Arbeitsmenge dar, die für jeden Zyklus benötigt wird. Und genau diese Zahl beeinflusst Werkzeuge direkt und wird von ihnen beeinflusst.";
		}
		{
			String _name = "column1text03";
			String _text = "Rechts siehst du die Liste der verfügbaren Werkzeuge, unter dem Namen jedes Werkzeugs befindet sich das Symbol:";
		}
		{
			String _name = "column1text04";
			String _text = "Dieses Symbol und die daneben stehende Zahl repräsentieren die Qualität des Werkzeugs und die Anzahl an Arbeitseinheiten, die es erbringen kann, bevor es 'zerbricht'.";
		}
		{
			String _name = "column1text05";
			String _text = "Ein Bürger ohne Werkzeug ist nicht nur bei der Güterproduktion sehr langsam, er wird auch beim Sammeln & Ernten von Nahrung, beim Baumfällen und Brennholzhacken behindert. Auch der Bau von Gebäuden wird stark behindert, wenn ein Bauarbeiter kein Werkzeug besitzt.";
		}
		{
			String _name = "column1text06";
			String _text = "Änderungen im Spiel bei aktiven DS-Mods machen die Eisenherstellung nicht mehr so einfach wie das Sammeln von der Oberfläche oder die einfache Herstellung durch eine Mine mit geringem Kostenaufwand.";
		}
		{
			String _name = "column1text07";
			String _text = "eine Übersicht der Änderungen:";
		}
		{
			String _name = "column1text08";
			String _text = "-Gediegenes Eisen ist nicht mehr von der Kartenoberfläche verfügbar, stattdessen finden sich kleine Mengen an Eisenerz, Kupfererz und Zinnerz über die Landschaft verteilt.";
		}
		{
			String _name = "column1text08a";
			String _text = "-Kupfer- und Zinnerz sind die häufiger an der Oberfläche gefundenen Erze. Eisenerz kommt in geringeren Mengen vor.";
		}
		{
			String _name = "column1text09";
			String _text = "-Minen produzieren nur noch Erze (sowie Kohle) statt der gediegenen Metalle (Eisen, Kupfer usw.).";
		}
		{
			String _name = "column1text09a";
			String _text = "-Der Bergbau kostet nun entweder Baumstämme oder Bauholz sowie Lampenöl oder Kerzen.";
		}
		{
			String _name = "column1text10";
			String _text = "-Eisenerz muss in einem Ofen mit einem metallurgischen Brennstoff (Koks oder Holzkohle) verhüttet werden, um Eisen herzustellen. Das Gleiche gilt für Kupfer und andere Metalle und Legierungen.";
		}
		{
			String _name = "column1text10a";
			String _text = "-Koks entsteht durch den Abbau und das 'Kochen' von Kohle. Holzkohle entsteht durch das Verkohlen von Baumstämmen.";
		}
		{
			String _name = "column1text10b";
			String _text = "-Die Einführung von Kupfererz an der Oberfläche ermöglicht die Herstellung eines einfach herzustellenden Frühspiel-Werkzeugs; ein Kupferwerkzeug kann allein mit Brennholz verhüttet werden (siehe Liste rechts).";
		}
		{
			String _name = "column1text10c";
			String _text = "-Die Herstellung hochwertigerer Werkzeuge, die zur Stärkung weiteres Schmieden benötigen (Stahl- & gehärtete Werkzeuge), erfordert die Verwendung eines metallurgischen Brennstoffs.";
		}
		{
			String _name = "column1text11a";
			String _text = "Werkzeuge können an einem Schleifstein weiterverarbeitet und geschärft werden, um zu 'feinen' Versionen ihrer selbst zu werden. Diese Werkzeuge werden mit einem Sternchen (*) nach ihrem Namen gekennzeichnet. Diese Werkzeuge haben eine um 25 Arbeitseinheiten bessere Haltbarkeit als ihre normalen Versionen.";
		}
		{
			String _name = "column1text11b";
			String _text = "Werden sie zusätzlich mit Leinöl 'geölt', profitieren diese Werkzeuge von einer um 50 Arbeitseinheiten erhöhten Haltbarkeit. Diese Werkzeuge werden mit einem Sternchen und einem Zirkumflex (*^) nach ihrem Namen gekennzeichnet.";
		}
		{
			String _name = "column1text12";
			String _text = "Es gibt weitere Werkzeugarten aus der Kategorie gefertigte Güter & Geräte; sie werden von verschiedenen Berufen entweder zur Güterproduktion oder im Gebäudebau verwendet.";
		}
		{
			String _name = "column1text13a";
			String _text = "Werkzeuge:Steinmetz";
		}
		{
			String _name = "column1text13b";
			String _text = "Als Produktionskosten benötigt, um Stein aus Steinbrüchen zu gewinnen, hat die Einführung von Werkzeuge:Steinmetz auch das hohe Risiko und die Wahrscheinlichkeit tödlicher Arbeitsunfälle bei Steinmetzen verringert. Wird auch als Baukosten bei einigen größeren Steingebäuden verwendet.";
		}
		{
			String _name = "column1text14a";
			String _text = "Werkzeuge:Fischer";
		}
		{
			String _name = "column1text14b";
			String _text = "Als Baukosten für Fischereistandorte benötigt, wurden diese in früheren DS-Mods als Angelausrüstung bezeichnet.";
		}
		{
			String _name = "column1text15a";
			String _text = "Werkzeuge:Jäger";
		}
		{
			String _name = "column1text15b";
