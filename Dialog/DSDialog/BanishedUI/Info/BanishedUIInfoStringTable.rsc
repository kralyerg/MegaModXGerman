		}
		{
			String _name = "column3text09Tip";
			String _text = "Eicheln werden unter diesem Limit (gelagert), bis sie zum Verzehr verarbeitet werden.";
		}
		{
			String _name = "column3text10";
			String _text = "Bauholz*, Dachziegel, Ziegelsteine";
		}
		{
			String _name = "column3text10Tip";
			String _text = "Bauholz wird manchmal auch als Schnittholz bezeichnet, es handelt sich jedoch um dasselbe.";
		}
		{
			String _name = "column3text11";
			String _text = "Baumstämme";
		}
		{
			String _name = "column3text12";
			String _text = "Stein";
		}
		{
			String _name = "column3text13";
			String _text = "Eisenbeschläge, Amboss, Kupfer, Zinn, Bronze";
		}
		{
			String _name = "column3text14";
			String _text = "Eisen";
		}
		{
			String _name = "column3text15";
			String _text = "Glas, Glaswaren";
		}
		{
			String _name = "column3text16";
			String _text = "Koks, Holzkohle*";
		}
		{
			String _name = "column3text17";
			String _text = "Eisenerz, Kohle, Kupfer, Zinn und Silbererze";
		}
		{
			String _name = "column3text18";
			String _text = "Ton, Kalk, Sand, Dünger";
		}
		{
			String _name = "column3text19";
			String _text = "Gold, Edelsteine";
		}
		{
			String _name = "column3text20";
			String _text = "Silber, Silberbarren";
		}
		{
			String _name = "column3text21";
			String _text = "Farthing, Silberpfennig, Nobel, *";
		}
		{
			String _name = "column3text21Tip";
			String _text = "Farthing, Halfpenny, Silberpfennig, Silbergroschen, Viertelnobel, Halbnobel, Nobel";
		}
		{
			String _name = "blank";
			String _text = " ";
		}
	]

}

StringTable InfoMiningSmelting
{
	Entry _strings
	[
		{
			String _name = "MiningSmelting";
			String _text = "Bergbau & Verhüttung";
		}
		{
			String _name = "MiningSmeltingTitle1";
			String _text = "Bergbau, Erzprobe & Metallurgie";
		}
		{
			String _name = "MiningSmeltingTitle2";
			String _text = "- über Erze, Minerale, Stein und Rohstoffe der Erde -";
		}
		{
			String _name = "MiningSmeltingTitle3";
			String _text = "- und über Brennstoffe & Flussmittel für die Metallurgie -";
		}
		{
			String _name = "column1text01";
			String _text = "Eisen, das heißt reines gediegenes Eisen, sofern es im Mineralreich überhaupt zu finden ist, ist von äußerster Seltenheit. Es ist nicht mehr als von der Oberfläche abgebautes oder gesammeltes Metall verfügbar. Stattdessen wird Eisenerz gefördert; meist ist es aus Minen verfügbar, doch es gibt auch eine kleine, begrenzte Menge des Erzes, die zu Beginn eines Spiels auf der Kartenoberfläche zu finden ist. Dies ist eine realistische Änderung im Prozess der Eisenherstellung.";
		}
		{
			String _name = "column1text01a";
			String _text = "Bergbau (und Steinbruch) ist im Spiel typischerweise ein gefährlicher Beruf; dies wird nun durch zusätzliche Kosten in gewissem Maße abgemildert. Bergbau ist teuer und erfordert mindestens die Kosten eines Baumstamms oder eines Stücks Bauholz pro Zyklus. Tiefere, größere Minen benötigen zum Betrieb möglicherweise auch Lampenöl oder Kerzen.";
		}
		{
			String _name = "column1text01b";
			String _text = "Obwohl Stein von jedem Arbeiter mit normalen Werkzeugen von der Oberfläche genommen werden kann, erfordert im Steinbruch gewonnener Stein nun pro Zyklus den Einsatz spezialisierter Geräte: 'Werkzeuge:Steinmetz', ein gefertigtes Gut & Gerät, das bei Schmieden hergestellt wird. Wie bei den Bergleuten haben nun auch Steinmetze eine geringere Wahrscheinlichkeit, bei der Arbeit zu sterben.";
		}
		{
			String _name = "column1text02";
			String _text = "Eisenerz muss in einem sehr heißen Ofen verhüttet werden, um Verunreinigungen zu entfernen und in das härteste aller Metalle verwandelt zu werden: Eisen.";
		}
		{
			String _name = "column1text02a";
			String _text = "Eisenerz";
		}
		{
			String _name = "column1text02b";
			String _text = "Meist abgebaut, wenngleich eine kleine Menge an der Oberfläche zu finden ist. Das Eisenerz hat keine feste Form; es ist gänzlich unregelmäßig und meist von rostiger Farbe. Diese Farbe verrät die Menge an enthaltenem Eisen und zeichnet das am leichtesten schmelzbare Eisenerz aus.";
		}
		{
			String _name = "column1text02c";
			String _text = "Gefördert in Mengen von 3-5 Eisenerz.";
		}
		{
			String _name = "column1text02copper";
			String _text = "Auch Kupfererz benötigt einen sehr heißen Ofen, um zu fester metallischer Form von Kupfer verhüttet zu werden.";
		}
		{
			String _name = "column1text02coppera";
			String _text = "Kupfererz";
		}
		{
			String _name = "column1text02copperb";
			String _text = "Meist abgebaut, wenngleich eine große Menge an der Oberfläche zu finden ist. Das Kupfererz ist beim ersten Abbau manchmal von tiefstem Rotblau, oxidiert jedoch schon vor Erreichen der Oberfläche und nimmt die schönsten Farben von Blau und Grün an.";
		}
		{
			String _name = "column1text02copperc";
			String _text = "Gefördert in Zyklen von 3-5 Kupfererz.";
		}
		{
			String _name = "column1text02tin";
			String _text = "Zinnerz benötigt einen Ofen, um zu fester metallischer Form von Zinn verhüttet zu werden, wird aber auch zusammen mit Kupfererz zum Schmieden von Bronze verwendet.";
		}
		{
			String _name = "column1text02tina";
			String _text = "Zinnerz";
		}
		{
			String _name = "column1text02tinb";
			String _text = "Abgebaut, wenngleich Mengen an der Oberfläche zu finden sind. Das reichhaltigste Zinnerz ist von schwarzer oder dunkler Farbe, von vielflächiger, aber insgesamt unregelmäßiger Gestalt, oft mit sehr glänzender Oberfläche. Häufig ist es in Schwemmlandablagerungen entlang von Flussufern zu finden.";
		}
		{
			String _name = "column1text02tinc";
			String _text = "Gefördert in Zyklen von 3-5 Zinnerz.";
		}
		{
			String _name = "column1text03";
			String _text = "Silbererz muss ebenfalls verhüttet werden, jedoch langsamer und bei niedrigerer Temperatur in einem Frischofen, um das eigentliche Silber zu gewinnen.";
		}
		{
			String _name = "column1text02silvera";
			String _text = "Silbererz";
		}
		{
			String _name = "column1text02silverb";
			String _text = "Silbererz wird nur abgebaut, und obwohl es manchmal in seiner reinsten, gediegenen Form gefunden wird, ist es in dieser Form von geringem Wert, denn es enthält gewiss Schwefel und Arsenik. Daher muss alles Silber aus einer Mine zusammen mit den weniger reinen Erzen verhüttet werden.";
		}
		{
			String _name = "column1text02silverc";
			String _text = "Gefördert in Zyklen von 3-5 Silbererz.";
		}
		{
			String _name = "column1text03Gold1";
			String _text = "Gold; von allen Metallen wird es am häufigsten gediegen gefunden, frei von Schwefel und Arsenik. Es ist kein Erz bekannt, in dem Gold den größten metallischen Anteil ausmacht. Es werden zwar mehrere Erze unter diesem Namen verkauft, doch bei genauer Prüfung erweisen sie sich als etwas anderes. Es kam schon vor, dass viele Menschen, getäuscht von der rötlich-gelben Farbe dieser Erze, die aussehen, als enthielten sie Gold, diese für Golderze hielten. Doch ich habe nie erlebt, dass jemand durch sie reich wurde, oder durch das wenige Gold, das man aus ihnen schmelzen kann.";
		}
		{
			String _name = "column1text04";
			String _text = "Um den Ofen oder die Esse eines Schmieds heiß genug zu bekommen, um Erze zu verhütten und zu gewinnen, sind Brennstoffe nötig, die bei höherer Temperatur und länger brennen als Brennholz oder Kohle (beide enthalten zu viele Verunreinigungen und brennen unregelmäßig und zu schnell). Die Verwendung eines metallurgischen Brennstoffs ist nun in allen Bereichen der Metallurgie unerlässlich:";
		}
		{
			String _name = "column1text05";
			String _text = "Holzkohle";
		}
		{
			String _name = "column1text05a";
			String _text = "Holzkohle, ein Produkt aus Baumstämmen, wird auf einfache Weise in einem Kohlenmeiler oder in einem Kohlenofen hergestellt (demnächst verfügbar).";
		}
		{
			String _name = "column1text05b";
			String _text = "Baumstämme werden unter Sauerstoffausschluss erhitzt, die Pyrolyse bzw. das Verkohlen beginnt, wodurch Verunreinigungen entfernt werden; daraus entstehen aus je 21 Baumstämmen etwa 34-55 Holzkohle.";
		}
		{
			String _name = "column1text06";
			String _text = "Koks";
		}
		{
			String _name = "column1text06a";
			String _text = "Koks, ein Produkt aus Kohle, wird ähnlich wie Holzkohle 'gekocht'; auf einfache Weise in einer aufgeschichteten Kohlenglut (demnächst verfügbar), bei der die Kohle aufgeschichtet und mit Erde bedeckt wird, oder schneller in einem bienenkorbförmigen Koksofen.";
		}
		{
			String _name = "column1text06b";
			String _text = "Der Prozess benötigt 21 abgebaute Kohle, um etwa 21-34 Koks herzustellen.";
		}
		{
			String _name = "column1text08";
			String _text = "Das Schmieden von Metallen geschieht schnell und unter sehr hohen Temperaturen; dies bedeutet, dass oft ein großer Teil des verwendeten Erzes gegenüber dem letztlich Hergestellten verloren geht.";
		}
		{
			String _name = "column1text09";
			String _text = "Die Zugabe eines Flussmittels zum Ofen zusammen mit Erz und Brennstoff ermöglicht es, nur die halbe Menge an Erz zu verwenden und dabei den gleichen Ertrag zu erzielen:";
		}
		{
			String _name = "column1text10";
			String _text = "Kalk (auch bekannt als Branntkalk)";
		}
		{
			String _name = "column1text10a";
			String _text = "Kalk wird in einem Ofen hergestellt, der einem Koksofen ähnelt, und ist das Produkt weicheren (kalziumreicheren) Steins. Der Stein wird im Ofen aufgeschichtet und mit einem Brennstoff erhitzt, bis er reagiert und zu einem weiß-grauen Pulver wird.";
		}
		{
			String _name = "column1text10b";
			String _text = "Ein einzelnes großes Stück Stein liefert zusammen mit einem Brennstoff voraussichtlich etwa 5-8 Kalk.";
		}
		{
			String _name = "column1text10c";
			String _text = "Die Verwendung von Kalk im Ofen beim Verhütten von Metallen reagiert mit den Erzen und hilft, die Verunreinigungen zu trennen. Kalk wird zudem als Baumaterial verwendet, dient als starkes Bindemittel und verbessert zudem die Wärmedämmung eines Gebäudes.";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "wird hergestellt aus:";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "oder:";
		}
		{
			String _name = "valueTip";
			String _text = "Warenwert";
		}
		{
			String _name = "valueTolTip";
			String _text = "Warenwert, dieses Produkt hat einen schwankenden Wert; Händler bieten oder kaufen daher zu einem Preis innerhalb dieser Spanne";
		}
		{
			String _name = "weightTip";
			String _text = "Warengewicht";
		}
		{
			String _name = "quantityTip";
			String _text = "Produktmenge, hergestellt von gebildeten oder ungebildeten Arbeitern";
		}
		{
			String _name = "column2text01";
			String _text = "Eisen";
		}
		{
			String _name = "Iron00Tip";
			String _text = "Das gebräuchlichste und am häufigsten verwendete aller Metalle; Eisen hat ein eigenes Limit zur Produktionskontrolle. Es wird vor allem als Material zur Werkzeugherstellung verwendet, kommt aber auch im Baugewerbe zum Einsatz.";
		}
		{
			String _name = "column2text02";
			String _text = "5 Eisenerz + ";
		}
		{
			String _name = "column2text03";
			String _text = "2 Koks oder Holzkohle";
		}
		{
			String _name = "Iron01Tip";
			String _text = "Diese Methode hat pro Zyklus Kosten von 34-36 (Holzkohle-Koks). Ungebildete machen mit Koks einen Verlust von 2 oder gehen mit Holzkohle kostenneutral aus, da nur 1 Stück Eisen hergestellt wird; ein gebildeter Arbeiter erzielt hingegen einen Gesamtgewinn von 32-34 (Koks-Holzkohle) bzw. 16-17 pro Stück Eisen.";
		}
		{
			String _name = "column2text04";
			String _text = "3 Eisenerz + ";
		}
		{
			String _name = "column2text05";
			String _text = "1 Kalk + ";
		}
		{
			String _name = "column2text06";
			String _text = "2 Koks oder Holzkohle";
		}
		{
			String _name = "Iron02Tip";
			String _text = "Diese Methode hat pro Zyklus Kosten von 31-33 (Holzkohle-Koks). Ungebildete erzielen einen Gewinn von 1-3 (Koks-Holzkohle), da nur 1 Stück Eisen hergestellt wird; ein gebildeter Arbeiter erzielt einen Gesamtgewinn von 35-37 bzw. 17,5-18,5 pro Stück Eisen. So wie Koks sich zu Holzkohle verhält, ist Kalk potenziell günstiger herzustellen als Eisenerz, wodurch der Gesamtgewinn wahrscheinlich höher ausfällt.";
		}
		{
			String _name = "IronQty";
			String _text = "Ertrag: 1-2";
		}
		{
			String _name = "IronValue";
			String _text = "34";
		}
		{
			String _name = "IronWeight";
			String _text = "25";
		}
		{
			String _name = "column2text01c";
			String _text = "Kupfer";
		}
		{
			String _name = "Copper00Tip";
			String _text = "Kupfer wird zur Produktionskontrolle unter dem Limit Metalle, Legierungen & Schmiedewaren hergestellt. Es wird vor allem im Baugewerbe verwendet, kann aber auch zur Herstellung von Werkzeugen und anderen Kupferwaren genutzt werden.";
		}
		{
			String _name = "column2text02c";
			String _text = "5 Kupfererz + ";
		}
		{
			String _name = "Copper01Tip";
			String _text = "Diese Methode hat pro Zyklus Kosten von 34-36 (Holzkohle-Koks). Ungebildete machen einen Verlust von 4-6, da nur 1 Stück Kupfer hergestellt wird; ein gebildeter Arbeiter erzielt einen Gesamtgewinn von 24-26 (Koks-Holzkohle) bzw. 12-13 pro Stück Kupfer.";
		}
		{
			String _name = "column2text04c";
			String _text = "3 Kupfererz + ";
		}
		{
			String _name = "Copper02Tip";
			String _text = "Diese Methode hat pro Zyklus Kosten von 31-33 (Holzkohle-Koks). Ungebildete machen einen Verlust von 1-3, da nur 1 Stück Kupfer hergestellt wird; ein gebildeter Arbeiter erzielt einen Gesamtgewinn von 27-29 (Koks-Holzkohle) bzw. 13,5-14,5 pro Stück Kupfer. So wie Koks sich zu Holzkohle verhält, ist Kalk potenziell günstiger herzustellen als Kupfererz, wodurch der Gesamtgewinn wahrscheinlich höher ausfällt.";
		}
		{
			String _name = "CopperQty";
			String _text = "Ertrag: 1-2";
		}
		{
			String _name = "CopperValue";
			String _text = "30";
		}
		{
			String _name = "CopperWeight";
			String _text = "25";
		}
		{
			String _name = "column2text01cTin";
			String _text = "Zinn";
		}
		{
			String _name = "Tin00Tip";
			String _text = "Zinn wird zur Produktionskontrolle unter dem Limit Metalle, Legierungen & Schmiedewaren hergestellt. Es wird zur Herstellung von Blechwaren verwendet und ist eine wertvolle Handelsware.";
		}
		{
			String _name = "column2text02cTin";
			String _text = "5 Zinnerz + ";
		}
		{
			String _name = "Tin01Tip";
			String _text = "Diese Methode hat pro Zyklus Kosten von 39-41 (Holzkohle-Koks). Ungebildete machen einen Verlust von 3-5, da nur 1 Stück Zinn hergestellt wird; ein gebildeter Arbeiter erzielt einen Gesamtgewinn von 31-33 (Koks-Holzkohle) bzw. 15,5-16,5 pro Stück Zinn.";
		}
		{
			String _name = "column2text04cTin";
			String _text = "3 Zinnerz + ";
		}
		{
			String _name = "Tin02Tip";
			String _text = "Diese Methode hat pro Zyklus Kosten von 34-36 (Holzkohle-Koks). Ungebildete gehen mit Koks kostenneutral aus oder erzielen mit Holzkohle einen Gewinn von 2; ein gebildeter Arbeiter erzielt einen Gesamtgewinn von 36-38 (Koks-Holzkohle) bzw. 18-19 pro Stück Zinn. So wie Koks sich zu Holzkohle verhält, ist Kalk potenziell günstiger herzustellen als Zinnerz, wodurch der Gesamtgewinn wahrscheinlich höher ausfällt.";
		}
		{
			String _name = "TinQty";
			String _text = "Ertrag: 1-2";
		}
		{
			String _name = "TinValue";
			String _text = "36";
		}
		{
			String _name = "TinWeight";
			String _text = "25";
		}
		{
			String _name = "column2text01cBronze";
			String _text = "Bronze";
		}
		{
			String _name = "Bronze00Tip";
			String _text = "Bronze wird zur Produktionskontrolle unter dem Limit Metalle, Legierungen & Schmiedewaren hergestellt. Sie wird für Werkzeuge und im Baugewerbe verwendet.";
		}
		{
			String _name = "column2text02cBronze";
			String _text = "7 Kupfererz + ";
		}
		{
			String _name = "Bronze01Tip";
			String _text = "Diese Methode hat pro Zyklus Kosten von 47-49 (Holzkohle-Koks). Ungebildete erzielen einen Gewinn von 11-13, da nur 1 Stück Bronze hergestellt wird; ein gebildeter Arbeiter erzielt einen Gesamtgewinn von 41-43 (Koks-Holzkohle) bzw. 13,67-14,33 pro Stück Bronze.";
		}
		{
			String _name = "column2text04cBronze";
			String _text = "1 Zinnerz + ";
		}
		{
			String _name = "BronzeQty";
			String _text = "Ertrag: 2-3";
		}
		{
			String _name = "BronzeValue";
			String _text = "30";
		}
		{
			String _name = "BronzeWeight";
			String _text = "25";
		}
		{
			String _name = "column2text16";
			String _text = "Silber";
		}
		{
			String _name = "Silver00Tip";
			String _text = "Das wundersame Silber, gebräuchlich als Zahlungsmittel und ein Gut von hohem Wert bei geringem Gewicht, wird unter einem eigenen Limit zur Produktions-/Bestandskontrolle hergestellt.";
		}
		{
			String _name = "column2text17";
			String _text = "2 Silbererz + ";
		}
		{
			String _name = "column2text18";
			String _text = "1 Koks oder Holzkohle";
		}
		{
			String _name = "Silver01Tip";
			String _text = "Diese Methode hat pro Zyklus Kosten von 23-24 (Holzkohle-Koks). Ungebildete machen einen Verlust von 2-3, da nur 1 Stück Silber hergestellt wird; ein gebildeter Arbeiter erzielt einen Gesamtgewinn von 18-19 (Koks-Holzkohle) bzw. 9-9,5 pro Stück Silber.";
		}
		{
			String _name = "SilverQty";
			String _text = "Ertrag: 1-2";
		}
		{
			String _name = "SilverValue";
			String _text = "21";
		}
		{
			String _name = "SilverWeight";
			String _text = "21";
		}
		{
			String _name = "column2text19";
			String _text = "Silberbarren";
		}
		{
			String _name = "SilverIngot00Tip";
			String _text = "Ein geschickter Handwerker kann erfolgreich einen Silberbarren schmieden, wobei weniger Brennstoff für eine größere Menge Silber benötigt wird; von höherem Wert als Zahlungsmittel, wird er unter dem Limit Silber zur Produktions-/Bestandskontrolle hergestellt.";
		}
		{
			String _name = "column2text20";
			String _text = "6 Silbererz + ";
		}
		{
			String _name = "column2text21";
			String _text = "1 Koks oder Holzkohle";
		}
		{
			String _name = "SilverIngot01Tip";
			String _text = "Diese Methode hat pro Zyklus Kosten von 55-56 (Holzkohle-Koks). Ungebildete machen einen Verlust von 5-6, da sie die Ofenhitze mit so geringer Brennstoffmenge nicht aufrechterhalten können und nur 1 Silberbarren herstellen; ein gebildeter, geschickter Arbeiter erzielt einen Gesamtgewinn von 44-45 (Koks-Holzkohle) bzw. 22-22,5 pro Silberbarren.";
		}
		{
			String _name = "SilverIngotQty";
			String _text = "Ertrag: 1-2";
		}
		{
			String _name = "SilverIngotValue";
			String _text = "50";
		}
		{
			String _name = "SilverIngotWeight";
			String _text = "50";
		}
		{
			String _name = "GoldTitle";
			String _text = "Gold";
		}
		{
			String _name = "Gold00Tip";
			String _text = "Gold wird zwar nicht gezielt abgebaut und auch nicht in ausreichender Menge dafür gefunden, kommt aber in seiner gediegenen, reinen Form vor und wird manchmal in Silberminen gewonnen oder entlang von Flüssen und Bächen ausgewaschen. Als Zahlungsmittel verwendet, besitzt Gold ebenfalls ein eigenes Limit zur Produktions-/Bestandskontrolle.";
		}
		{
			String _name = "GoldQty";
			String _text = "Ertrag: 1";
		}
		{
			String _name = "Gold01Tip";
			String _text = "Gold ist ein seltenes, wertvolles Metall; die Wahrscheinlichkeit, es zu finden, ist gering, eine Chance von 1:21.";
		}
		{
			String _name = "GoldValue";
			String _text = "252";
		}
		{
