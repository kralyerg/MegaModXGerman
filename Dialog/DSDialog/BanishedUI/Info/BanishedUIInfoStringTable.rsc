		}
		{
			String _name = "titleribbonaka";
			String _text = "Übliche Ressourcen: (*zum Anzeigen weiterer Infos mit der Maus darüberfahren)";
		}
		{
			String _name = "column3text01";
			String _text = "alle Früchte, Getreide, Proteine & Gemüse";
		}
		{
