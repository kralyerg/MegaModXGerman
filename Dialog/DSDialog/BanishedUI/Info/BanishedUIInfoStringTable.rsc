		}
		{
			String _name = "column3text07";
			String _text = "Wagenteile, Lampenöl, Werkzeuge:Steinmetz, *";
		}
		{
			String _name = "column3text07Tip";
			String _text = "Bienenwachs, Kerzen, Fahne, Sammelkorb, Lampenöl, Leinöl, Töpferwaren, Blechwaren, Werkzeuge:Fischer, Werkzeuge:Jäger, Werkzeuge:Steinmetz, Wagenteile.";
		}
		{
			String _name = "column3text08";
