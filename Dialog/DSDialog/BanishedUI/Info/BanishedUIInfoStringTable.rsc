StringTable InfoPotteryGlass
{
	Entry _strings
	[
		{
			String _name = "PotteryGlass";
			String _text = "Töpferware & Glas";
		}
		{
			String _name = "PotteryGlassTitle1";
			String _text = "Töpferei, Ziegel, Dachziegel & Glasherstellung";
		}
		{
			String _name = "PotteryGlassTitle2";
			String _text = "- über die Rohstoffe der Erde, als Gefäße und Fensterglas -";
		}
		{
			String _name = "column1text01";
			String _text = "Töpferware ist ein wichtiges gefertigtes Gut & Gerät, das von Bürgern im Alltag genutzt wird. Als vielerlei Objekte: eine einfache Lampe, wird sie als essenzieller Baustoff verwendet (besonders in Minen), sowie als Gefäße zum Mischen, Lagern und Konservieren von Gütern.";
		}
		{
			String _name = "column1text02";
			String _text = "Die Bedeutung von Ziegelsteinen und Dachziegeln im Baugewerbe ist unbestreitbar. In den meisten Fällen sind sie leichter und langlebiger als ihre Gegenstücke aus Stein, Holz und Reet. Bei der Verwendung im Wohnhausbau verbessern und erhöhen sie zudem die Wärme und Wärmespeicherung.";
		}
		{
			String _name = "column1text03";
			String _text = "Glas ist eine wunderbare Erfindung; Fensterglas, wie es für Gebäudefenster verwendet wird, hat viele Vorteile: Indem es mehr Licht hereinlässt, ermöglicht es Haushalten, weniger Brennstoff zu verbrauchen, denn wir leben nicht mehr in dunklen, feuchten Steinhütten. Nützlich in Produktionsgebäuden, ermöglicht mehr Licht schnellere und bessere Arbeit.";
		}
		{
			String _name = "column1text04";
			String _text = "Glaswaren werden, wie Töpferware, als Gefäße zum Mischen und Lagern von Gütern hergestellt und verwendet; sie werden auch von einer Feinschmiede zur Herstellung von Amuletten genutzt.";
		}
		{
			String _name = "column1text05";
			String _text = "Ein weiterer Beweis für die unglaubliche Vielseitigkeit von Kalk: Er kann auch bei der Herstellung von Töpferware & Glas verwendet werden. Bei der Herstellung von Töpferware ersetzt er zusammen mit Sand den Ton im Rezept. Bei der Glasherstellung wirkt er auf ähnliche Weise als Bindemittel für stärkeres Glas, ermöglicht aber auch einen geringeren Sandverbrauch.";
		}
		{
			String _name = "column2AreMadeFrom";
			String _text = "werden hergestellt aus:";
		}
		{
			String _name = "column2MadeFrom";
			String _text = "wird hergestellt aus:";
		}
		{
			String _name = "column2MadeFromOr";
			String _text = "oder:";
		}
		{
			String _name = "valueTip";
			String _text = "Warenwert";
		}
		{
			String _name = "valueTolTip";
			String _text = "Warenwert, dieses Produkt hat einen schwankenden Wert; Händler bieten oder kaufen daher zu einem Preis innerhalb dieser Spanne";
		}
		{
			String _name = "weightTip";
			String _text = "Warengewicht";
		}
		{
			String _name = "quantityTip";
			String _text = "Produktmenge, hergestellt von gebildeten oder ungebildeten Arbeitern";
		}
		{
			String _name = "column2text01";
			String _text = "Töpferware";
		}
		{
			String _name = "Pottery00Tip";
			String _text = "Ein weit verbreitetes gefertigtes Gut, Töpferware bietet Bürgern viele Funktionen in Produktion und Bauwesen. Nutzt das Limit Gefertigte Güter & Geräte zur Produktionskontrolle.";
		}
